# ========== weixin-zhxt 后端环境变量示例 ==========
# 用法：复制为 backend/.env 后按实填写。真 .env 绝不进仓。
# 服务器 /www/wwwroot/weixin-zhxt/backend/.env 由管理员手工维护。

# ---------- MinIO ----------
MINIO_ENDPOINT=172.16.100.102:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=xxx
MINIO_SECRET_KEY=xxx
MINIO_BUCKET_PRIVATE=zhxt
MINIO_BUCKET_ZHXT=zhxt
MINIO_BUCKET_PUBLIC=zhxt
STATIC_LINK_SECRET=xxx

# ---------- 海康威视 ----------
HIKVISION_HOST=https://192.168.1.152:443
HIKVISION_APP_KEY=xxx
HIKVISION_APP_SECRET=xxx

# ---------- Agent 安全认证 ----------
AGENT_APP_KEY=xxx
AGENT_APP_SECRET=xxx
AGENT_APP_TOKEN_TTL=86400

WX_OPENID_HASH_SALT=xxx

# ---------- 问卷提交签名密钥 ----------
SURVEY_SIGN_SECRET=xxx

# ---------- 创蓝回执推送鉴权 ----------
CHUANGLAN_CB_RECEIVER=xxx
CHUANGLAN_CB_PSWD=xxx
CHUANGLAN_CB_PSWD_SALT=xxx
CHUANGLAN_CB_PSWD_HASH=xxx
