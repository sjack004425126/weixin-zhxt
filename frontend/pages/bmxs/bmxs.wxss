.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
}

.form-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #E86433;
}

.submit-btn {
  margin: 40rpx 30rpx;
}

/* 表单项样式 */
.van-field {
  padding: 20rpx 0 !important;
}

.van-field__label {
  width: 200rpx !important;
  color: #666 !important;
}

.van-field__input {
  color: #333 !important;
}

/* 必填项标记 */
.van-field--required::before {
  color: #ee0a24 !important;
}

/* 选择器样式 */
.van-picker__toolbar {
  height: 96rpx !important;
}

.van-picker__cancel,
.van-picker__confirm {
  font-size: 32rpx !important;
  padding: 0 32rpx !important;
}

.van-picker__confirm {
  color: #E86433 !important;
}

.van-picker-column {
  font-size: 32rpx !important;
} 