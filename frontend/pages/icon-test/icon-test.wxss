/* pages/icon-test/icon-test.wxss */

/* 关键：引入 vant-icon 样式（含 @font-face 和所有 ::before 规则） */
@import "../../components/vant-icon/index.wxss";

.container {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  color: #262626;
}

.block {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 16rpx 8rpx;
  background: #fafbfc;
  border-radius: 8rpx;
}

.item text {
  font-size: 20rpx;
  color: #666;
  margin-top: 8rpx;
}

.hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  padding: 12rpx;
  background: #f6f6f6;
  border-radius: 6rpx;
}

/* 区域D：直接 unicode 字符显示 */
.unicode-icon {
  font-family: 'vant-icon', monospace, sans-serif;
  font-size: 48rpx;
  color: #1890ff;
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #fafbfc;
  border-radius: 8rpx;
}