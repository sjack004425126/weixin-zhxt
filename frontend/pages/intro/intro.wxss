/* 蓝色主题 - 与首页一致 */
page {
  --primary: #1890FF;
  --primary-light: #E6F7FF;
  --primary-dark: #096DD9;
  --accent: #FAAD14;
  --success: #52C41A;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-muted: #8C8C8C;
  --bg: #F5F7FA;
  --card-bg: #FFFFFF;
  --border: #F0F0F0;
  --radius: 20rpx;
  --shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(24, 144, 255, 0.1);
}

.intro-container {
  min-height: 100vh;
  background: var(--bg);
  height: 100vh;
}

/* ========== 英雄区域 ========== */
.hero-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.hero-bg-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg,
    rgba(24, 144, 255, 0.65) 0%,
    rgba(24, 144, 255, 0.4) 50%,
    rgba(0, 0, 0, 0.4) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #fff;
  text-align: center;
  padding: 0 40rpx;
  animation: heroFadeIn 1s ease-out;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 40rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(8px);
  animation: badgeSlideDown 0.8s ease-out 0.3s both;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
  animation: titleFadeUp 0.8s ease-out 0.4s both;
}

.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  animation: titleFadeUp 0.8s ease-out 0.5s both;
}

.hero-tagline {
  font-size: 28rpx;
  opacity: 0.85;
  font-weight: 300;
  letter-spacing: 1rpx;
  animation: titleFadeUp 0.8s ease-out 0.6s both;
}

/* ========== 主内容区 ========== */
.main-content {
  padding: 24rpx 24rpx 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 3;
}

/* ========== 卡片通用 ========== */
.section-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.anim-card {
  animation: cardSlideUp 0.6s ease-out both;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.card-icon-wrap {
  width: 64rpx; height: 64rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-wrap-gold {
  background: #FFF7E6;
}

.icon-wrap-green {
  background: #F6FFED;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.card-body {
  padding: 24rpx 28rpx 28rpx;
}

/* ========== 段落样式 ========== */
.paragraph-block {
  margin-bottom: 24rpx;
}

.paragraph-block:last-child {
  margin-bottom: 0;
}

.timeline-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  background: var(--primary-light);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.paragraph-text {
  font-size: 28rpx;
  line-height: 2;
  color: var(--text-secondary);
  text-align: justify;
  padding: 20rpx 24rpx;
  background: #FAFBFC;
  border-radius: 12rpx;
  border-left: 5rpx solid var(--primary-light);
  transition: border-color 0.3s ease;
}

.paragraph-text:active {
  border-left-color: var(--primary);
}

/* 文字高亮样式 */
.text-highlight {
  color: var(--primary);
  font-weight: 600;
}

.text-accent {
  color: var(--primary-dark);
  font-weight: 600;
  background: var(--primary-light);
  padding: 0 8rpx;
  border-radius: 6rpx;
}

.text-number {
  color: var(--primary);
  font-weight: 700;
  font-size: 30rpx;
}

/* ========== 统计数据 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx 28rpx 28rpx;
}

.stat-card {
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  color: #fff;
  cursor: pointer;
}

.stat-card-1 {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  animation: statPopIn 0.5s ease-out 0.3s both;
}
.stat-card-2 {
  background: linear-gradient(135deg, #096DD9 0%, #1890FF 100%);
  animation: statPopIn 0.5s ease-out 0.4s both;
}
.stat-card-3 {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  animation: statPopIn 0.5s ease-out 0.5s both;
}
.stat-card-4 {
  background: linear-gradient(135deg, #FAAD14 0%, #FFC53D 100%);
  animation: statPopIn 0.5s ease-out 0.6s both;
}

.stat-card:active {
  transform: scale(0.96);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.stat-suffix {
  font-size: 28rpx;
  font-weight: 500;
  opacity: 0.85;
}

.stat-desc {
  font-size: 22rpx;
  opacity: 0.85;
  letter-spacing: 1rpx;
}

.stat-bar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ========== 荣誉列表 ========== */
.honors-list {
  padding: 20rpx 28rpx 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.honor-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FFFBE6 0%, #FFF7E6 100%);
  border-radius: 12rpx;
  border: 1rpx solid rgba(250, 173, 20, 0.2);
  transition: all 0.3s ease;
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
}

.anim-honor {
  animation: honorSlideIn 0.5s ease-out both;
}

.honor-item:active {
  transform: scale(0.97);
  background: linear-gradient(135deg, #FFF1B8 0%, #FFE58F 100%);
}

.honor-medal {
  flex-shrink: 0;
}

.honor-name {
  font-size: 24rpx;
  color: #8B6914;
  font-weight: 500;
  line-height: 1.4;
}

/* ========== 联系信息 ========== */
.contact-list {
  padding: 16rpx 28rpx 28rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
  transition: all 0.2s ease;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-row:active {
  background: var(--primary-light);
  margin: 0 -28rpx;
  padding: 20rpx 28rpx;
  border-radius: 12rpx;
}

.contact-icon-box {
  width: 56rpx; height: 56rpx;
  background: var(--primary-light);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.contact-action {
  flex-shrink: 0;
}

/* ========== 底部 ========== */
.footer-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 48rpx 40rpx 80rpx;
}

.footer-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #D9D9D9, transparent);
}

.footer-text {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* ========== 返回顶部 ========== */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  width: 80rpx; height: 80rpx;
  background: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.35);
  z-index: 100;
  opacity: 0;
  transform: scale(0.6);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.back-top.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.back-top:active {
  transform: scale(0.9);
}

/* ========== 动画定义 ========== */
@keyframes heroFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes badgeSlideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes titleFadeUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cardSlideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes statPopIn {
  0% { opacity: 0; transform: scale(0.8); }
  60% { transform: scale(1.03); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes honorSlideIn {
  from { opacity: 0; transform: translateX(-20rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* ========== 减少动画偏好 ========== */
@media (prefers-reduced-motion: reduce) {
  .hero-content,
  .hero-badge,
  .hero-title,
  .hero-subtitle,
  .hero-tagline,
  .anim-card,
  .anim-honor,
  .stat-card-1,
  .stat-card-2,
  .stat-card-3,
  .stat-card-4 {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}
