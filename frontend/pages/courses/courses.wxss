.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
}

/* 学生信息卡片样式 */
.student-info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
  font-size: 28rpx;
  width: 100rpx;
}

.value {
  color: #333;
  font-size: 28rpx;
  flex: 1;
}

.status {
  color: #52c41a;
}

/* 课程列表样式 */
.course-list {
  margin-top: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.course-items {
  margin-top: 16rpx;
}

.course-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.course-id {
  font-size: 24rpx;
  color: #999;
}

.course-detail {
  font-size: 28rpx;
}

.detail-row {
  display: flex;
  margin-bottom: 12rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #666;
  width: 140rpx;
}

.detail-value {
  color: #333;
  flex: 1;
} 