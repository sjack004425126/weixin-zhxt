/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --border-radius: 16rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 返回首页按钮 */
.back-home-btn {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50rpx;
  color: white;
  font-size: 28rpx;
  backdrop-filter: blur(10rpx);
  z-index: 10;
}

.back-home-btn:active {
  opacity: 0.8;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  backdrop-filter: blur(10rpx);
}

.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 页面头部样式 */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.header-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 角色网格 */
.role-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  width: 100%;
  max-width: 650rpx;
}

.role-block {
  background: white;
  border-radius: var(--border-radius);
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--card-shadow);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.role-block::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}

.role-block.student::before {
  background: var(--primary-gradient);
}

.role-block.teacher::before {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
}

.role-block.vocational-student::before {
  background: linear-gradient(135deg, #722ED1 0%, #9254DE 100%);
}

.role-block.vocational-teacher::before {
  background: linear-gradient(135deg, #EB2F96 0%, #F759AB 100%);
}

.role-block:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.block-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.role-block.student .block-icon {
  background: var(--primary-light);
  color: var(--primary-color);
}

.role-block.teacher .block-icon {
  background: #F6FFED;
  color: var(--secondary-color);
}

.role-block.vocational-student .block-icon {
  background: #F9F0FF;
  color: #722ED1;
}

.role-block.vocational-teacher .block-icon {
  background: #FFF0F6;
  color: #EB2F96;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.block-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 底部 */
.footer {
  margin-top: 60rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.footer-divider {
  opacity: 0.5;
}