/* pages/SmartTeacher/SmartTeacher.wxss */
.vr-container {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* AI生成内容声明提示条（微信合规要求） */
.ai-notice-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.65);
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-notice-text {
  font-size: 24rpx;
  color: #fff;
  letter-spacing: 1rpx;
}

.back-btn {
  position: fixed;
  top: 80rpx;
  left: 24rpx;
  z-index: 9999;
  width: 72rpx;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
