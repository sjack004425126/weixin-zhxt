.container {
  padding: 30rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.header {
  padding: 30rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.major-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #E86433;
  border-radius: 50%;
  margin-right: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.department-link {
  font-size: 28rpx;
  color: #999;
}

.major-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.major-tag {
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #333;
  margin: 8rpx;
  white-space: nowrap;
  border: 1rpx solid #eee;
}

.major-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.major-item:last-child {
  border-bottom: none;
}

.major-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.major-info {
  display: flex;
  font-size: 26rpx;
  color: #666;
}

.fee {
  margin-right: 30rpx;
}

.books {
  color: #999;
}

/* 费用信息弹窗样式 */
.fee-info {
  padding: 30rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.fee-item:last-child {
  margin-bottom: 0;
}

.fee-label {
  color: #666;
}

.fee-value {
  font-weight: 500;
}

.total {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.total .fee-label,
.total .fee-value {
  color: #E86433;
  font-weight: bold;
} 