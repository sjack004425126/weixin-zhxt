/* 开放大学主题 - 橙色学术风格 */
/* 关键：import vant-icon 组件样式（与 home 页保持一致，让 van-icon 组件显示完整图标） */
@import "../../components/vant-icon/index.wxss";

/* Vant组件样式覆盖（与 home 页保持一致） */
.van-icon {
  transition: all 0.3s ease !important;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF6F2 0%, #F7F8FA 50%, #FFF9F6 100%);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 切换身份按钮 */
.switch-role-btn {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx 14rpx 14rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 52rpx;
  box-shadow: 0 4rpx 16rpx rgba(232, 100, 51, 0.12), 0 1rpx 4rpx rgba(232, 100, 51, 0.08);
  z-index: 10;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid rgba(232, 100, 51, 0.1);
  cursor: pointer;
}

.switch-role-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(232, 100, 51, 0.15);
}

.switch-role-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(232, 100, 51, 0.1) 0%, rgba(255, 176, 103, 0.15) 100%);
  border-radius: 50%;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.switch-role-btn:active .switch-role-icon {
  transform: rotate(180deg);
}

.switch-role-btn text {
  font-size: 26rpx;
  color: #E86433;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E86433' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
  opacity: 0.5;
  z-index: 0;
}

.login-box {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 80rpx 40rpx 60rpx;
  box-shadow: 0 8rpx 32rpx rgba(232, 100, 51, 0.15);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(232, 100, 51, 0.1);
  position: relative;
  z-index: 1;
}

.login-box::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #E86433 0%, #FFB067 50%, #E86433 100%);
  border-radius: 32rpx 32rpx 0 0;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #E86433 0%, #FF9B4E 100%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  text-align: center;
  margin-bottom: 80rpx;
  position: relative;
  letter-spacing: 2rpx;
}

.school-badge {
  position: absolute;
  top: -20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.school-badge.university {
  background: linear-gradient(135deg, #E86433 0%, #FFB067 100%);
  color: white;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.login-type {
  display: flex;
  justify-content: space-around;
  margin: 0 40rpx 60rpx;
  padding: 20rpx 0;
}

.type-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF6F2 0%, #F7F8FA 100%);
  border-radius: 50%;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid rgba(232, 100, 51, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.08);
}

.type-icon .van-icon {
  color: #999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-icon.active {
  background: linear-gradient(135deg, rgba(232, 100, 51, 0.15) 0%, rgba(255, 176, 103, 0.15) 100%);
  border-color: #E86433;
  box-shadow: 0 6rpx 20rpx rgba(232, 100, 51, 0.2);
  transform: translateY(-4rpx);
}

.type-icon.active .van-icon {
  color: #E86433;
  transform: scale(1.2);
}

.type-icon:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(232, 100, 51, 0.12);
}

.type-icon:active {
  opacity: 0.8;
}

.type-item {
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.type-item.active {
  color: #E86433;
  font-weight: 500;
}

.type-item.active::after {
  content: '';
  position: absolute;
  bottom: -22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #E86433;
  border-radius: 2rpx;
}

.login-form {
  margin-bottom: 40rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.quick-login-tip {
  text-align: center;
  color: #666;
  font-size: 28rpx;
  padding: 60rpx 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-form .van-button {
  margin-top: auto;
}

.agreement {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.agreement-links {
  margin-top: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.link {
  color: #1890ff;
  display: inline;
}

/* 自定义输入格（替代 van-field，绕开 Vant 官方 icon 远程字体） */
.custom-input-cell {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF6F2 0%, #F7F8FA 100%);
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 24rpx 32rpx;
  border: 2rpx solid rgba(232, 100, 51, 0.1);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.custom-input-cell:focus-within {
  border-color: #E86433;
  box-shadow: 0 0 0 4rpx rgba(232, 100, 51, 0.1);
  background: #fff;
}

.custom-input-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.custom-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  background: transparent;
  border: 0;
  outline: 0;
  padding: 0;
  height: 44rpx;
  line-height: 44rpx;
  min-height: 44rpx;
}

.custom-input-placeholder {
  color: #C8C8C8;
}

.verify-code-field {
  display: flex;
  align-items: center;
}

.verify-code-field .van-button {
  margin-left: 20rpx;
  margin-right: 30rpx;
  width: 200rpx !important;
  height: 64rpx !important;
  font-size: 24rpx !important;
}

/* van-button 样式覆盖 - 开放大学橙色主题 */
.van-button {
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 48rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 6rpx 20rpx rgba(232, 100, 51, 0.3) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.van-button:active {
  transform: translateY(2rpx) !important;
  box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.3) !important;
}

/* van-checkbox 样式覆盖 */
.van-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-icon {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  z-index: 100;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.home-icon:active {
  opacity: 0.8;
}

.verify-code-field {
  display: flex;
  align-items: center;
}

.verify-code-field .custom-input-cell {
  flex: 1;
  margin-bottom: 30rpx;
}

.verify-code-field .van-button {
  margin-left: 20rpx;
  margin-right: 30rpx;
  width: 200rpx !important;
  height: 64rpx !important;
  font-size: 24rpx !important;
}

checkbox {
  transform: scale(0.8);
  margin-right: 4rpx;
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 60rpx;
  padding: 20rpx 30rpx;
}

.nav-btn {
  padding: 16rpx 30rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.nav-icons {
  position: fixed;
  top: 0;
  right: 0;
  padding: 40rpx 30rpx;
  z-index: 100;
}

.icon-btn {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.icon-btn:active {
  opacity: 0.8;
}

.go-vocational {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(232, 100, 51, 0.15) 0%, rgba(255, 176, 103, 0.15) 100%);
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(232, 100, 51, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.15);
  transition: all 0.3s ease;
}

.go-vocational:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(232, 100, 51, 0.2);
}

.bounce-text {
  color: #E86433;
  font-size: 28rpx;
  margin-right: 8rpx;
  font-weight: 600;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(-3px);
  }
}

/* 页面加载动画 */
.login-box {
  animation: slideInUp 0.6s ease-out;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 标题渐变动画 */
.title {
  animation: fadeInDown 0.8s ease-out 0.2s both;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 学校标识动画 */
.school-badge {
  animation: bounceIn 0.8s ease-out 0.4s both;
}

@keyframes bounceIn {
  0% {
    opacity: 0;
    transform: scale(0.3) rotate(-5deg);
  }
  50% {
    opacity: 1;
    transform: scale(1.05) rotate(-5deg);
  }
  70% {
    transform: scale(0.9) rotate(-5deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(-5deg);
  }
}

/* 登录方式图标动画 */
.login-type {
  animation: fadeIn 0.8s ease-out 0.5s both;
}

.type-icon:nth-child(1) {
  animation: zoomIn 0.6s ease-out 0.6s both;
}

.type-icon:nth-child(2) {
  animation: zoomIn 0.6s ease-out 0.7s both;
}

.type-icon:nth-child(3) {
  animation: zoomIn 0.6s ease-out 0.8s both;
}

@keyframes zoomIn {
  0% {
    opacity: 0;
    transform: scale(0);
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 登录表单动画 */
.login-form {
  animation: slideInRight 0.6s ease-out 0.9s both;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 协议区域动画 */
.agreement {
  animation: fadeInUp 0.6s ease-out 1s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 切换身份按钮动画 */
.switch-role-btn {
  animation: switchBtnIn 0.6s ease-out 0.3s both;
}

@keyframes switchBtnIn {
  0% {
    opacity: 0;
    transform: translateX(-30rpx) scale(0.8);
  }
  60% {
    transform: translateX(6rpx) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.switch-role-icon {
  animation: iconPulse 3s ease-in-out 1.5s infinite;
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 顶部装饰线动画 */
.login-box::before {
  animation: expandWidth 0.8s ease-out 0.2s both;
}

@keyframes expandWidth {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}


/* 手机号快捷登录按钮 */
.phone-login-btn {
  width: 100%;
  min-width: 480rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #E86433 0%, #FFB067 100%);
  color: white;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(232, 100, 51, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.phone-login-btn:active::before {
  left: 100%;
}

.phone-login-btn:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.3);
}
