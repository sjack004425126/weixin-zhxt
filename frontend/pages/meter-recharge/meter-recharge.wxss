/* meter-recharge 样式 v3：沉稳耐看 + 跳转模式 */

@import "../../components/vant-icon/index.wxss";

/* vi 类：直接用 text 渲染 vant-icon unicode（绕过 view+::before 不显示问题） */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

page {
  --bg-page:      #EEF2F7;
  --bg-card:      #FFFFFF;
  --line:         #E2E8F0;
  --line-strong:  #CBD5E1;
  --text:         #0F172A;
  --text-soft:    #334155;
  --muted:        #64748B;
  --hint:         #94A3B8;
  --primary:      #2563EB;
  --primary-d:    #1D4ED8;
  --primary-soft: #EFF6FF;
  --success:      #10B981;
  --danger:       #EF4444;
  --warn:         #F59E0B;
  --shadow-sm:    0 1rpx 4rpx rgba(15, 23, 42, 0.06);
  --shadow-md:    0 8rpx 24rpx rgba(15, 23, 42, 0.10);

  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding: 32rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* =========================== 免责声明 =========================== */
.disclaimer-banner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF8E6;
  border: 2rpx solid #FDE68A;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 28rpx;
}

.disclaimer-text {
  flex: 1;
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.5;
}

/* =========================== 搜索框（直角） =========================== */
.search-bar {
  margin-bottom: 28rpx;
}

.search-bar-inner {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.search-bar-inner:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.10);
}

.search-bar-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
}

.search-input-placeholder {
  color: var(--hint);
  font-weight: 400;
}

.search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
}

.search-clear--hover {
  background: #E2E8F0;
}

/* =========================== 空态 / 搜索中 / 未匹配 =========================== */
.empty-section {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 110rpx 32rpx 100rpx;
  text-align: center;
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow-sm);
}

.empty-icon-wrap {
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 28rpx;
  background: var(--primary-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text);
  font-weight: 600;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 14rpx;
}

/* =========================== 电表卡片 =========================== */
.meter-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow-md);
  margin-bottom: 24rpx;
}

.meter-card-head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
  position: relative;
}

.meter-card-head::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 8rpx;
  background: linear-gradient(180deg, #2563EB 0%, #60A5FA 100%);
  border-radius: 0 8rpx 8rpx 0;
}

.meter-card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}

.meter-card-name {
  margin-left: 10rpx;
}

/* 文字信息 */
.meter-card-body {
  padding: 8rpx 32rpx 8rpx;
  background: var(--bg-card);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: var(--muted);
  flex-shrink: 0;
  font-weight: 500;
}

.info-value {
  color: var(--text);
  font-weight: 600;
  text-align: right;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-value--mono {
  font-family: "SF Mono", "Roboto Mono", monospace;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  color: var(--text-soft);
}

/* =========================== 跳转按钮区 =========================== */
.jump-section {
  padding: 32rpx 32rpx 36rpx;
  border-top: 2rpx solid var(--line);
  background: #FAFBFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.jump-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.35);
  transition: opacity 0.15s ease, transform 0.1s ease;
}

.jump-btn--loading {
  opacity: 0.75;
  pointer-events: none;
}

.jump-btn--hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.28);
  background: linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%);
}

.jump-hint {
  font-size: 24rpx;
  color: var(--hint);
}

