<!-- 问卷列表页 - 精准线性风格 (zhpt-new/design 重构版) -->
<include src="/utils/common-components.wxml" />

<view class="container">



  <!-- ========== 内容区 ========== -->
  <view class="content">

    <!-- 搜索框 sticky 固定 -->
    <view class="sticky-search">
      <view class="search-bar">
        <view class="search-input-wrap">
          <text class="vi" style="font-size:32rpx;color:#94A3B8;">🔍</text>
          <input
            class="search-input"
            type="text"
            placeholder="检索问卷名称、发起部门或关键词..."
            placeholder-class="search-placeholder"
            value="{{searchInput}}"
            confirm-type="search"
            bindinput="onKeywordInput"
            bindconfirm="onSearchTap"
          />
          <view wx:if="{{searchInput}}" class="search-clear-btn" catchtap="onClearKeyword">清除</view>
        </view>
        <view class="search-submit-btn" bindtap="onSearchTap">搜索</view>
      </view>

      <!-- 类型筛选 Tab（跟随搜索框一起吸顶，不单独 sticky） -->
      <view class="filter-bar">
        <view
          wx:for="{{_filterCategories}}"
          wx:key="type"
          class="filter-tab {{filterType === item.type ? 'filter-tab-active' : ''}}"
          data-type="{{item.type}}"
          bindtap="onFilterTap"
        >{{item.label}}</view>
      </view>
    </view>


    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <van-loading size="48rpx" color="#2563EB">加载中...</van-loading>
    </view>

    <!-- 错误状态 -->
    <view wx:elif="{{error_msg}}" class="error-wrap">
      <view class="error-icon-wrap">
        <text class="vi" style="font-size:40rpx;color:#DC2626;">⚠</text>
      </view>
      <view>
        <view class="error-code">加载失败</view>
        <view class="error-msg">网络连接异常，请稍后重试</view>
      </view>
      <van-button type="primary" size="small" bind:click="onRetryTap" color="#2563EB" custom-class="reload-btn">
        <van-loading wx:if="{{retrying}}" size="24rpx" color="#fff" />
        <text wx:else>重新加载</text>
      </van-button>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{surveys.length === 0 && !loading}}" class="empty-wrap">
      <text class="vi" style="font-size:64rpx;color:#CBD5E1;">≡</text>
      <view class="empty-title">暂无相关问卷</view>
    </view>

    <!-- 列表 -->
    <block wx:else>
      <view class="list-status-row">
        <text>共 {{surveys.length}} 项</text>
      </view>

      <view class="survey-list">
        <view
          wx:for="{{surveys}}"
          wx:key="sid"
          class="survey-card {{item.answered ? 'card-answered' : ''}}"
          data-sid="{{item.sid}}"
          data-code="{{item.survey_code}}"
          data-answered="{{item.answered}}"
          bindtap="onItemTap"
        >
          <!-- 顶部: 分类标签 + 部门 + 状态 -->
          <view class="card-meta-row">
            <view class="card-meta-left">
              <view class="card-category-tag">{{item._typeMeta.label}}</view>
              <view class="card-dept-tag" wx:if="{{item.dept_name}}">{{item.dept_name}}</view>
            </view>
            <view wx:if="{{item.answered}}" class="card-status-tag-done">已完成</view>
            <view wx:elif="{{item.available}}" class="card-status-tag-active">进行中</view>
            <view wx:else class="card-status-tag-done">已截止</view>
          </view>

          <!-- 标题 -->
          <view class="card-title">{{item.title}}</view>

          <!-- 描述 -->
          <view wx:if="{{item.subtitle}}" class="card-desc">{{item.subtitle}}</view>

          <!-- 底部: 行动按钮 -->
          <view class="card-footer">
            <view class="card-footer-action">
              <text>{{item.answered ? '查看凭据' : '开始作答'}}</text>
              <text class="vi" style="font-size:24rpx;color:#2563EB;">→</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- ========== 返回顶部按钮 ========== -->
    <view class="back-to-top {{_showBackToTop ? 'visible' : ''}}" bindtap="_scrollToTop" hover-class="back-to-top-hover">
      <text class="vi" style="font-size:32rpx;color:#FFFFFF;">▲</text>
    </view>

  </view>
</view>
