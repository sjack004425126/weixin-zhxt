/* =========================== 页面根容器 =========================== */
.page-root {
  min-height: 100vh;
  background: linear-gradient(180deg, #E6F7FF 0%, #FAFAFA 280rpx);
  padding: 0 28rpx 80rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #262626;
}

/* =========================== 顶部头部 =========================== */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0 -28rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 32rpx;
}

.header-badge {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  flex-shrink: 0;
}

.header-text {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #262626;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.header-subtitle {
  font-size: 22rpx;
  color: #595959;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* =========================== 查询区 =========================== */
.query-section {
  margin-bottom: 28rpx;
}

.query-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  border: 1rpx solid #F0F0F0;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 8rpx 14rpx;
  border-radius: 12rpx;
  transition: all 0.25s ease;
  position: relative;
}

.tab-item.active {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  transform: translateY(-2rpx);
}

.tab-item.active .tab-desc {
  color: rgba(255, 255, 255, 0.7);
}

.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E6F7FF;
  color: #1890FF;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.tab-item.active .tab-icon-wrap {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.tab-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #262626;
}

.tab-item.active .tab-label {
  color: #fff;
}

.tab-desc {
  font-size: 20rpx;
  color: #8C8C8C;
  margin-top: 2rpx;
}

.tab-divider {
  width: 1rpx;
  background: #F0F0F0;
  margin: 12rpx 0;
}

/* =========================== 查询卡片 =========================== */
.query-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 10rpx 20rpx rgba(24, 144, 255, 0.10), 0 4rpx 8rpx rgba(24, 144, 255, 0.06);
  border: 1rpx solid #F0F0F0;
  position: relative;
  z-index: 1;
}

.card-intro {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #F0F0F0;
  margin-bottom: 24rpx;
}

.card-intro-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #E6F7FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-intro-text {
  flex: 1;
  min-width: 0;
}

.card-intro-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1890FF;
  line-height: 1.3;
}

.card-intro-desc {
  font-size: 24rpx;
  color: #595959;
  margin-top: 6rpx;
  line-height: 1.5;
}

.form-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border: 2rpx solid #F0F0F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 96rpx;
  transition: all 0.2s ease;
}

.input-row:focus-within {
  border-color: #1890FF;
  background: #fff;
  box-shadow: 0 0 0 6rpx rgba(24, 144, 255, 0.1);
}

.input-prefix {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.main-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: #262626;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.input-placeholder {
  color: #8C8C8C;
  font-weight: 400;
}

.primary-btn {
  height: 96rpx;
  background: linear-gradient(135deg, #1890FF 0%, #1890FF 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.18);
  transition: all 0.2s ease;
  border: none;
}

.primary-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.18);
}

.primary-btn.btn-disabled {
  background: linear-gradient(135deg, #94A3B8 0%, #CBD5E1 100%);
  box-shadow: none;
  color: #fff;
  opacity: 0.85;
}

.primary-btn::after {
  border: none;
}

/* 手机号验证区 */
.phone-verify-section {
  background: linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 100%);
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx dashed #059669;
  position: relative;
}

.phone-verify-header {
  margin-bottom: 20rpx;
}

.phone-verify-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
}

.phone-verify-tip-text {
  font-size: 22rpx;
  color: #595959;
  margin-top: 6rpx;
  margin-left: 32rpx;
  line-height: 1.5;
}

.phone-btn {
  height: 88rpx;
  background: #fff;
  color: #059669;
  border: 2rpx solid #059669;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  padding: 0;
}

.phone-btn.verified {
  background: #059669;
  color: #fff;
  border-color: #059669;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.25);
}

.phone-btn::after {
  border: none;
}

.phone-btn-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.verified-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.reverify {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: underline;
  margin-left: 8rpx;
}

/* 信任条 */
.trust-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 32rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
  border: 1rpx solid #F5F5F5;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #595959;
  font-weight: 500;
}

.trust-sep {
  width: 1rpx;
  height: 28rpx;
  background: #F0F0F0;
}

/* =========================== 结果卡片（公共） =========================== */
.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  border: 1rpx solid #F0F0F0;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.card-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1890FF;
}

.section-title-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: #E6F7FF;
  color: #1890FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #ECFDF5;
  color: #059669;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.enrollment-badge {
  background: #FFFBEB;
  color: #FAAD14;
}

.unpaid-badge {
  background: rgba(24, 144, 255, 0.08);
  color: #1890FF;
}

.paid-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #059669;
  box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6);
  animation: paid-pulse 2s infinite;
}

@keyframes paid-pulse {
  0% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6); }
  70% { box-shadow: 0 0 0 12rpx rgba(5, 150, 105, 0); }
  100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
}

/* =========================== 报名信息网格 =========================== */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.info-cell {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border-left: 8rpx solid #1890FF;
  min-width: 0;
}

.info-cell .cell-value {
  word-break: break-all;
}

.info-cell.is-remark {
  grid-column: 2;
  grid-row: 2;
}

.cell-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #595959;
  font-weight: 500;
}

.cell-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1890FF;
  line-height: 1.3;
  white-space: nowrap;
}

.cell-full-width {
  grid-column: 1 / -1;
}

.cell-value.remark {
  font-size: 26rpx;
  font-weight: 400;
  color: #595959;
  line-height: 1.5;
}

/* =========================== 缴费成功 banner =========================== */
.paid-success-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #059669 0%, #10B981 100%);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.25);
}

.paid-success-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.paid-success-text {
  flex: 1;
}

.paid-success-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.paid-success-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* =========================== 费用列表 =========================== */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.fee-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.fee-row:last-child {
  border-bottom: none;
}

.fee-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.fee-name {
  font-size: 28rpx;
  color: #262626;
  font-weight: 500;
}

.fee-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #262626;
  font-family: "SF Mono", "Roboto Mono", monospace;
  text-align: right;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.fee-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: #ECFDF5;
  border-radius: 50%;
  flex-shrink: 0;
}

.fee-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 12rpx 0;
}

.fee-row.total-row {
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  margin-left: -28rpx;
  margin-right: -28rpx;
  background: linear-gradient(135deg, #E6F7FF 0%, #BAE0FF 100%);
  border-radius: 16rpx;
  border: 2rpx solid #91D5FF;
}

.fee-name.total-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1890FF;
}

.fee-amount.total-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #1890FF;
  letter-spacing: 1rpx;
}

.payment-area {
  margin-top: 24rpx;
}

.pay-btn {
  background: linear-gradient(135deg, #1890FF 0%, #1890FF 100%);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

/* =========================== 缴费记录 =========================== */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 16rpx;
}

.record-row:last-child {
  border-bottom: none;
}

.record-key {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #595959;
  font-weight: 500;
  min-width: 160rpx;
}

.record-val {
  flex: 1;
  font-size: 28rpx;
  color: #262626;
  text-align: right;
  word-break: break-all;
}

.record-money {
  font-size: 32rpx;
  font-weight: 700;
  color: #059669;
  font-family: "SF Mono", "Roboto Mono", monospace;
}

.record-trade {
  font-family: "SF Mono", "Roboto Mono", monospace;
  font-size: 24rpx;
  color: #595959;
  letter-spacing: 0.3rpx;
}

/* 家长通知 */
.parent-notify {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #ECFDF5;
  border-radius: 12rpx;
  border-left: 6rpx solid #059669;
}

.parent-notify.warning-state {
  background: #FFFBEB;
  border-left-color: #FAAD14;
}

.notify-icon {
  width: 56rpx;
  height: 56rpx;
  background: #059669;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notify-icon.warning-icon {
  background: #FAAD14;
}

.notify-body {
  flex: 1;
  min-width: 0;
}

.notify-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1890FF;
  line-height: 1.3;
}

.notify-sub {
  font-size: 22rpx;
  color: #595959;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* =========================== 录取通知书卡片 =========================== */
.admission-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  border: 1rpx solid #F0F0F0;
  background: linear-gradient(135deg, #FFFFFF 0%, #F0F9FF 100%);
}

.admission-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.06);
}

.admission-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.admission-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: #E6F7FF;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.admission-info {
  flex: 1;
  min-width: 0;
}

.admission-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1890FF;
  line-height: 1.2;
}

.admission-sub {
  font-size: 22rpx;
  color: #595959;
  margin-top: 4rpx;
}

.admission-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.downloading-state,
.download-ready {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 600;
}

/* =========================== 重新查询 =========================== */
.requery-section {
  display: block;
  width: 100%;
  text-align: center;
  margin: 40rpx 0 0;
}

.requery-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  background: transparent;
  color: #1890FF;
  border: 2rpx solid #1890FF;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  margin: 0;
  line-height: 1.4;
}

.requery-btn::after {
  border: none;
}

.requery-btn:active {
  background: #E6F7FF;
}

/* =========================== 防伪页脚 =========================== */
.page-footer {
  margin-top: 40rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8C8C8C;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* =========================== 缴费弹窗 =========================== */
.pay-popup {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 40rpx rgba(24, 144, 255, 0.12), 0 8rpx 16rpx rgba(24, 144, 255, 0.08);
}

.popup-head {
  background: linear-gradient(135deg, #1890FF 0%, #1890FF 100%);
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
}

.popup-head-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.popup-head-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.popup-fee-list {
  padding: 24rpx 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.popup-fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #595959;
}

.popup-fee-item text:last-child {
  font-family: "SF Mono", "Roboto Mono", monospace;
  font-weight: 600;
  color: #262626;
}

.popup-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FAFAFA;
  border-top: 1rpx solid #F5F5F5;
  border-bottom: 1rpx solid #F5F5F5;
}

.popup-total text:first-child {
  font-size: 30rpx;
  font-weight: 700;
  color: #1890FF;
}

.popup-total-amount {
  font-size: 38rpx;
  font-weight: 700;
  color: #1890FF;
  font-family: "SF Mono", "Roboto Mono", monospace;
}

.popup-actions {
  display: flex;
  gap: 0;
  padding: 24rpx 32rpx;
  background: #fff;
}

.popup-cancel,
.popup-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0 8rpx;
  transition: all 0.2s ease;
}

.popup-cancel {
  background: #FAFAFA;
  color: #595959;
}

.popup-confirm {
  background: linear-gradient(135deg, #1890FF 0%, #1890FF 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.popup-cancel::after,
.popup-confirm::after {
  border: none;
}

/* =========================== 整页文字水印 =========================== */
.page-watermark-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
}
