<!-- ===== 报名成功弹窗 ===== -->
<view class="success-modal-mask" wx:if="{{showSuccessModal}}" catchtouchmove="true">
  <view class="success-modal-card">
    <view class="success-modal-icon">✓</view>
    <view class="success-modal-title">报名成功</view>
    <view class="success-modal-desc" wx:if="{{successSerialNumber}}">报名序号：{{successSerialNumber}}</view>
    
    <view class="success-modal-code-section" wx:if="{{successQueryCode}}">
      <view class="success-modal-code-label">您的查询码</view>
      <view class="success-modal-code-value">{{successQueryCode}}</view>
      <view class="success-modal-code-hint">已通过短信发送至您手机，凭此码可查看和修改报名信息</view>
    </view>
    
    <view class="success-modal-actions">
      <button class="success-modal-copy-btn" bindtap="copySuccessQueryCode" wx:if="{{successQueryCode}}">复制查询码</button>
      <button class="success-modal-close-btn" bindtap="closeSuccessModal">关闭</button>
    </view>
  </view>
</view>

<!-- ===== 查询码输入弹窗 ===== -->
<van-popup show="{{showQueryCodePopup}}" position="bottom" round bind:close="closeQueryCodePopup">
  <view class="query-popup">
    <view class="query-popup-header">
      <view class="query-popup-title">查询报名信息</view>
      <view class="query-popup-close" bindtap="closeQueryCodePopup">
        <van-icon name="cross" size="36rpx" color="#999" />
      </view>
    </view>
      <view class="query-popup-body">
        <view class="query-popup-tip">请输入您收到的查询码</view>
        <input
          class="query-popup-input"
          placeholder="输入查询码"
          value="{{queryCodeInput}}"
          bindinput="onQueryCodeInput"
          maxlength="12"
          focus="{{showQueryCodePopup}}"
        />
        <view class="query-popup-hint">查询码为8位字符，报名成功后会以短信形式发送</view>
        <view class="query-popup-hint query-popup-hint-extra">查询后可修改信息并重新提交</view>
      </view>
    <view class="query-popup-footer">
      <button class="query-popup-btn" bindtap="verifyQueryCode" loading="{{isQuerying}}" disabled="{{isQuerying || queryCodeInput.length < 8}}">
        确认查询
      </button>
    </view>
  </view>
</van-popup>
