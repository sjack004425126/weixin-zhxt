    <van-icon name="cross" size="24" color="#9ca3af" bindtap="closeNationPopup" />
  </view>
  <scroll-view class="popup-content" scroll-y style="height: 800rpx;">
    <van-radio-group value="{{formData.nation}}" bind:change="onNationSelect">
      <van-cell-group>
        <van-cell wx:for="{{nationList}}" wx:key="code" clickable data-code="{{item.code}}" bindtap="onNationCellClick">
          <view slot="title">{{item.label}}</view>
          <van-radio slot="right-icon" name="{{item.code}}" checked-color="#1a56db" />
        </van-cell>
