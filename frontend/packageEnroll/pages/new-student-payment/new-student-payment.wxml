<!-- 顶部消息提示组件 -->
<include src="/utils/common-components.wxml" />

<!-- 页面头部导航 -->
<view class="page-header-nav">
  <view class="header-nav-content">
    <view class="header-nav-icon">
      <van-icon name="balance-pay" size="40rpx" />
    </view>
    <view class="header-nav-text">
      <view class="header-nav-title">新生缴费</view>
      <view class="header-nav-subtitle">New Student Payment</view>
    </view>
    <view class="header-nav-action">
      <van-icon name="home-o" size="32rpx" bindtap="goHome" />
    </view>
  </view>
</view>

<view class="container">
  <!-- ===== 报名情况查询入口 ===== -->
  <view class="query-entry-card">
    <button class="query-btn" bindtap="goToEnrollmentQuery">
      <van-icon name="search" size="32rpx" />
      <text>报名情况查询</text>
    </button>
  </view>

  <!-- ===== 缴费状态卡片 ===== -->
  <view wx:if="{{paymentInfo}}" class="payment-status-card {{paymentInfo.has_paid ? 'paid' : 'unpaid'}}">
    <view class="payment-status-header">
      <view class="payment-status-icon">{{paymentInfo.has_paid ? '✓' : '!'}}</view>
      <view class="payment-status-text">
        <view class="payment-status-title">缴费状态：{{paymentInfo.status_text}}</view>
        <view class="payment-status-detail" wx:if="{{queryMajorInfo}}">
          专业：{{queryMajorInfo.name}}（{{queryMajorInfo.level}}）
        </view>
        <view class="payment-status-detail" wx:if="{{paymentInfo.amount}}">
          金额：¥{{paymentInfo.amount / 100}}元（学费¥{{paymentInfo.tuition / 100}} + 书费¥{{paymentInfo.book_fee / 100}}）
        </view>
        <view class="payment-status-detail" wx:if="{{paymentInfo.has_paid && paymentInfo.pay_time}}">
          支付时间：{{paymentInfo.pay_time}}
        </view>
        <view class="payment-status-detail" wx:if="{{paymentInfo.order_no}}">
          订单号：{{paymentInfo.order_no}}
        </view>
      </view>
    </view>
  </view>

  <!-- 地区信息卡片 -->
  <view class="area-card">
    <view class="area-simple">
      <van-icon name="location-o" size="28rpx" />
      <text class="area-label">报名地：</text>
      <text class="area-value">{{currentArea}}{{currentArea !== '黔东南直属' ? '开放教育学院' : ''}}</text>
    </view>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card">
    <view class="card-header">
      <view class="card-title">
        <van-icon name="edit" size="32rpx" />
        <text>基本信息</text>
      </view>
      <view class="card-subtitle">请确保信息准确无误</view>
    </view>

    <view class="form-section">
      <van-cell-group custom-class="form-group">
        <van-field
          value="{{ formData.name }}"
          label="姓名"
          placeholder="请输入真实姓名"
          required
          data-field="name"
          bind:change="onInputChange"
          left-icon="contact"
          custom-class="form-field"
        />

        <van-field
          value="{{ formData.id_card }}"
          label="身份证号"
          placeholder="请输入18位身份证号"
          required
          data-field="id_card"
          bind:change="onInputChange"
          left-icon="idcard"
          custom-class="form-field"
        />

        <van-field
          value="{{ formData.phone }}"
          label="手机号"
          placeholder="请输入11位手机号"
          required
          type="number"
          maxlength="11"
          data-field="phone"
          bind:change="onInputChange"
          left-icon="phone"
          custom-class="form-field"
        />

        <van-cell
          title="选择专业"
          is-link
          value="{{selectedMajor.name || '请选择专业'}}"
          bind:click="showMajorPickerPopup"
          required
          icon="graduation"
          custom-class="major-select-cell"
        />
      </van-cell-group>
    </view>
  </view>

  <!-- 费用信息卡片 -->
  <view class="fee-card" wx:if="{{selectedMajor && selectedMajor.name}}">
    <view class="card-header">
      <view class="card-title">
        <van-icon name="gold-coin-o" size="32rpx" />
        <text>费用详情</text>
      </view>
      <view class="card-subtitle">{{selectedLevel}} · {{selectedType}}</view>
    </view>

    <!-- 专业信息 -->
    <view class="major-display">
      <view class="major-name">
        <van-icon name="star-o" size="24rpx" />
        <text>{{selectedMajor.name}}</text>
      </view>
    </view>

    <!-- 费用明细 - 只有选择专业后才显示 -->
    <view class="fee-details" wx:if="{{selectedMajor && selectedMajor.name}}">
      <!-- 学费 -->
      <view class="fee-item tuition-fee-item">
        <view class="fee-label">
          <van-icon name="gold-coin-o" size="24rpx" />
          <text>学费</text>
        </view>
        <view class="fee-value tuition-fee-value">¥{{selectedMajor.tuition}}</view>
        <view class="fee-unit">元/年</view>
      </view>

      <!-- 书费 -->
      <view class="fee-item book-fee-item">
        <view class="fee-label">
          <van-icon name="book-o" size="24rpx" />
          <text>书费</text>
        </view>
        <view class="fee-value book-fee-value">¥{{calculatedBookFeeDisplay}}</view>
        <view class="fee-unit">元/年</view>
      </view>

      <!-- 书费说明 -->
      <view class="book-fee-note" wx:if="{{bookFeeNote}}">
        <van-icon name="info-o" size="20rpx" />
        <text>{{bookFeeNote}}</text>
      </view>

      <!-- 总金额 -->
      <view class="total-amount">
        <view class="total-label">
          <van-icon name="balance-pay" size="24rpx" />
          <text>应缴总额</text>
        </view>
        <view class="total-value">¥{{totalAmountDisplay}}</view>
      </view>
    </view>
  </view>

  <!-- 温馨提示卡片 -->
  <view class="notice-card">
    <view class="notice-header">
      <van-icon name="info-o" size="32rpx" />
      <text class="notice-title">温馨提示</text>
    </view>
    <view class="notice-list">
      <view class="notice-item">
        <van-icon name="passed" size="20rpx" />
        <text>请确保填写的信息准确无误</text>
      </view>
      <view class="notice-item">
        <van-icon name="warning-o" size="20rpx" />
        <text>缴费成功后将无法退款</text>
      </view>
      <view class="notice-item">
        <van-icon name="phone-o" size="20rpx" />
        <text>如有疑问请联系招生办公室</text>
      </view>
      <view class="notice-item">
        <van-icon name="records" size="20rpx" />
        <text>缴费记录可在分配学号后查询</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <view class="button-wrap">
      <van-button
        type="primary"
        block
        color="linear-gradient(135deg, #1890FF, #40A9FF)"
        loading="{{loading}}"
        disabled="{{loading || !selectedMajor || !formData.name || !formData.id_card || !formData.phone || (paymentInfo && paymentInfo.has_paid)}}"
        bind:click="submitForm"
        icon="balance-pay"
        custom-class="submit-button"
      >
        {{paymentInfo && paymentInfo.has_paid ? '已完成缴费' : (loading ? '处理中...' : '立即缴费')}}
      </van-button>
    </view>

    <view class="submit-tips">
      <van-icon name="shield-o" size="20rpx" />
      <text>支付安全由微信保障</text>
    </view>
  </view>

  <!-- 专业选择弹出层 -->
  <van-popup
    show="{{ showMajorPicker }}"
    position="bottom"
    round
    bind:close="onMajorPickerClose"
    custom-class="major-picker-popup"
  >
    <view class="picker-header">
      <view class="picker-title">
        <van-icon name="graduation" size="28rpx" />
        <text>选择专业</text>
      </view>
      <view class="picker-subtitle">请选择您要报读的专业</view>
    </view>

    <van-picker
      show-toolbar
      title=""
      columns="{{ columns }}"
      default-index="{{ [levelIndex, typeIndex, majorIndex] }}"
      bind:change="onMajorPickerChange"
      bind:confirm="onMajorPickerConfirm"
      bind:cancel="onMajorPickerClose"
      custom-class="major-picker"
    />
  </van-popup>

  <!-- ===== 查询码输入弹窗 ===== -->
  <van-popup show="{{showQueryCodePopup}}" position="bottom" round bind:close="closeQueryCodePopup">
    <view class="query-popup">
      <view class="query-popup-header">
        <view class="query-popup-title">查询报名信息</view>
        <view class="query-popup-close" bindtap="closeQueryCodePopup">
          <van-icon name="cross" size="36rpx" color="#999" />
        </view>
      </view>
      <view class="query-popup-body">
        <view class="query-popup-tip">请输入您收到的查询码</view>
        <input
          class="query-popup-input"
          placeholder="输入查询码"
          value="{{queryCodeInput}}"
          bindinput="onQueryCodeInput"
          maxlength="12"
          focus="{{showQueryCodePopup}}"
        />
        <view class="query-popup-hint">查询码为8位字符，报名成功后会以短信形式发送</view>
      </view>
      <view class="query-popup-footer">
        <button class="query-popup-btn" bindtap="verifyQueryCode" loading="{{isQuerying}}" disabled="{{isQuerying || queryCodeInput.length < 8}}">
          确认查询
        </button>
      </view>
    </view>
  </van-popup>
</view>