/* ==================== 全局变量 ==================== */
page {
  --color-primary: #1a56db;
  --color-primary-light: #e8f0fe;
  --color-primary-dark: #1240a8;
  --color-success: #0d9f6e;
  --color-warning: #c27803;
  --color-warning-bg: #fdf6ec;
  --color-danger: #e02424;
  --color-text-primary: #111928;
  --color-text-secondary: #374151;
  --color-text-muted: #6b7280;
  --color-text-placeholder: #9ca3af;
  --color-border: #e5e7eb;
  --color-border-focus: #1a56db;
  --color-bg-page: #f3f4f6;
  --color-bg-card: #ffffff;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', -apple-system, sans-serif;
}

/* ==================== 招生简章弹窗 ==================== */
.prospectus-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9999;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.modal-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 48rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
  text-align: center;
}

.modal-header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.modal-header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.modal-body {
  flex: 1;
  overflow-y: scroll;
  background: #fff;
  padding: 0 8rpx;
}

.prospectus-content {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--color-text-secondary);
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
  overflow: hidden;
  word-break: break-all;
}

.modal-footer {
  padding: 20rpx 40rpx 48rpx;
  background: #fff;
  border-top: 1rpx solid var(--color-border);
}

.scroll-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--color-warning);
  animation: bounce 1.5s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.confirm-btn::after { border: none; }
.confirm-btn.active { background: var(--color-primary); color: #fff; }
.confirm-btn.active:active { opacity: 0.85; }
.confirm-btn.disabled { background: #e5e7eb; color: var(--color-text-placeholder); }

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.form-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* ==================== 页面头部 ==================== */
.page-header {
  background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
  padding: 48rpx 32rpx 56rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -80rpx; left: -40rpx;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

.header-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 40rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
}

.header-badge-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  letter-spacing: 2rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.5;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

/* ==================== 表单卡片 ==================== */
.form-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: #fafbff;
}

.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 0.5rpx;
}

.section-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.form-body {
  padding: 8rpx 0;
}

/* ==================== 表单项 ==================== */
.form-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1.5;
}

.required-mark {
  color: var(--color-danger);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 4rpx;
  background: transparent;
  border: none;
  border-bottom: 2rpx solid #e5e7eb;
  border-radius: 0;
  font-size: 30rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  transition: border-color 0.25s, background 0.25s;
}

.form-input.focused {
  background: #f0f5ff;
  border-bottom-color: var(--color-primary);
}

.form-input:focus {
  background: #f0f5ff;
  border-bottom-color: var(--color-primary);
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 16rpx 4rpx;
  background: transparent;
  border: none;
  border-bottom: 2rpx solid #e5e7eb;
  border-radius: 0;
  font-size: 30rpx;
  color: var(--color-text-placeholder);
  box-sizing: border-box;
  cursor: pointer;
  transition: border-color 0.25s, background 0.25s;
}

.picker-content.selected {
  color: var(--color-text-primary);
  background: transparent;
  border-bottom-color: var(--color-primary);
}

.picker-content text {
  flex: 1;
  line-height: 1.6;
  padding-right: 16rpx;
}

/* ==================== 提示信息 ==================== */
.form-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: var(--color-warning-bg);
  border-left: 4rpx solid var(--color-warning);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 24rpx;
  color: var(--color-warning);
}

/* ==================== 提交区域 ==================== */
.submit-section {
  padding: 40rpx 24rpx 60rpx;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  border-radius: var(--radius-md);
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  letter-spacing: 4rpx;
  transition: all 0.2s;
}

.submit-btn::after { border: none; }

.submit-btn.active {
  background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(26,86,219,0.35);
}

.submit-btn.active:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.submit-btn.disabled {
  background: #e5e7eb;
  color: var(--color-text-placeholder);
}

.submit-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 20rpx;
}

/* ==================== 专业分组标题 ==================== */
.group-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
  gap: 16rpx;
}

.group-header-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, #d1d5db, transparent);
}

.group-header-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a56db;
  letter-spacing: 2rpx;
  white-space: nowrap;
  padding: 0 8rpx;
}

/* ==================== remark 样式 ==================== */
.radio-cell-remark {
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.6;
  background: #fffbeb;
  border-left: 3rpx solid #f59e0b;
  padding: 8rpx 16rpx;
  border-radius: 0 8rpx 8rpx 0;
  margin-top: 8rpx;
  word-break: break-all;
}

/* ==================== 专业名称行（名称 + 类别标签） ==================== */
.major-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.major-name {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1.5;
  flex: 1;
}

.major-category-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.category-diqi {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1d4ed8;
  border: 1rpx solid #93c5fd;
}

.category-zhuanqi {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
  color: #7c3aed;
  border: 1rpx solid #c4b5fd;
}

/* ==================== 弹窗样式 ==================== */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.popup-content {
  max-height: 60vh;
  overflow-y: scroll;
  background: #fff;
}

.radio-cell-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 4rpx 0;
}

.radio-cell-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  line-height: 1.6;
}

.radio-cell-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

/* ==================== Vant 覆盖 ==================== */
.van-cell {
  padding: 28rpx 32rpx !important;
  font-size: 30rpx !important;
}

.van-cell::after {
  border-bottom: 1rpx solid #f3f4f6 !important;
}

.van-radio__icon--checked {
  background-color: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

/* 招生老师输入行 */
.recruiter-input-row {
  display: flex; align-items: center; gap: 16rpx;
}
.recruiter-input { flex: 1; }
.recruiter-pick-btn {
  width: 72rpx; height: 72rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: #EFF6FF; border-radius: 12rpx;
  border: 1rpx solid #BFDBFE;
}
.recruiter-pick-btn:active { background: #DBEAFE; }

/* 招生老师弹窗（复用 introducer 样式） */
.introducer-popup { display: flex; flex-direction: column; height: 100%; }
.search-section { padding: 16rpx 24rpx; }
.search-box {
  display: flex; align-items: center; gap: 12rpx;
  background: #f5f5f5; border-radius: 40rpx; padding: 12rpx 24rpx;
}
.search-input { flex: 1; font-size: 28rpx; color: #333; }
.search-clear { font-size: 24rpx; color: #999; display: none; }
.search-clear.show { display: block; }
.alphabet-nav { padding: 0 16rpx 8rpx; }
.alphabet-scroll { white-space: nowrap; }
.alphabet-list { display: inline-flex; gap: 8rpx; padding: 4rpx 0; }
.alphabet-item {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #666; background: #f5f5f5;
}
.alphabet-item.active { background: #1a56db; color: white; }
.introducer-list { flex: 1; overflow-y: auto; }
.introducer-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 24rpx; border-bottom: 1rpx solid #f0f0f0;
}
.introducer-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: white; font-size: 28rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.introducer-info { flex: 1; }
.introducer-name { font-size: 28rpx; font-weight: 500; color: #333; }
.introducer-pinyin { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.introducer-check {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 2rpx solid #d9d9d9; display: flex; align-items: center; justify-content: center;
}
.introducer-check.checked { background: #1a56db; border-color: #1a56db; }
.check-icon { font-size: 24rpx; color: transparent; }
.introducer-check.checked .check-icon { color: white; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0; }
.empty-text { font-size: 26rpx; color: #999; margin-top: 16rpx; }


/* ==================== 查询码入口 ==================== */
.query-entry-card {
  margin: 0 0 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  display: flex;
  justify-content: center;
}

.query-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #1a56db, #2b7de9);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(26, 86, 219, 0.25);
}

.query-btn::after {
  border: none;
}

/* ==================== 查询码弹窗 ==================== */
.query-popup {
  padding: 32rpx 32rpx 48rpx;
}

.query-popup-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  position: relative;
}

.query-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.query-popup-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.query-popup-body {
  margin-bottom: 32rpx;
}

.query-popup-tip {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 24rpx;
}

.query-popup-input {
  height: 88rpx;
  background: var(--color-bg-page);
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
  box-sizing: border-box;
}

.query-popup-input:focus {
  border-color: var(--color-primary);
  background: #fff;
}

.query-popup-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
}

.query-popup-hint-extra {
  color: #1a56db;
  font-weight: 500;
  margin-top: 12rpx;
}

.query-popup-footer {
  padding: 0 16rpx;
}

.query-popup-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a56db, #2b7de9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(26, 86, 219, 0.3);
}

.query-popup-btn[disabled] {
  background: #d1d5db;
  box-shadow: none;
}

.query-popup-btn::after {
  border: none;
}

/* ==================== 报名成功弹窗 ==================== */
.success-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.success-modal-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-modal-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.success-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 12rpx;
}

.success-modal-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.success-modal-code-section {
  width: 100%;
  background: var(--color-primary-light);
  border: 1rpx solid #bae0ff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.success-modal-code-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.success-modal-code-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.success-modal-code-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}

.success-modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.success-modal-copy-btn {
  width: 100%;
  height: 80rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-modal-close-btn {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
