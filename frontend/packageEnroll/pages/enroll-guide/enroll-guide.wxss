/* 页面 */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 40rpx 32rpx;
}

/* ===== 顶部区域 ===== */
.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.badge {
  display: inline-block;
  background: #e8f0fe;
  color: #4285f4;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8c8c8c;
  letter-spacing: 0.5rpx;
}

/* ===== 卡片列表 ===== */
.cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  min-height: 120rpx;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 图标 */
.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.open-icon {
  background: linear-gradient(135deg, #e8f0fe 0%, #d2e3fc 100%);
}

.voc-icon {
  background: linear-gradient(135deg, #fff4e6 0%, #ffe7ba 100%);
}

.adult-icon {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
}

/* 内容 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

/* 箭头 */
.card-arrow {
  font-size: 40rpx;
  color: #d9d9d9;
  font-weight: 300;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.card:active .card-arrow {
  color: #4285f4;
  transform: translateX(4rpx);
}

/* ===== 底部 ===== */
.footer {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.divider {
  width: 80rpx;
  height: 4rpx;
  background: #e8e8e8;
  border-radius: 2rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #bfbfbf;
  letter-spacing: 1rpx;
}
