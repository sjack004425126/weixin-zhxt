page {
  height: 100%;
  background: #f0f2f5;
  overflow: hidden;
}

.container {
  display: flex;
  flex-direction: row;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  gap: 20rpx;
}

.canvas-area {
  flex: 1;
  border: 3rpx solid #1890ff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.15);
}

.sig-canvas {
  width: 100%;
  height: 100%;
}

.btn-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx;
  width: 140rpx;
}

.btn {
  width: 140rpx !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  border-radius: 40rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  text-align: center;
}

.btn::after {
  border: none;
}

.cancel-btn,
.clear-btn {
  border: 2rpx solid #8c8c8c !important;
  color: #8c8c8c !important;
  background: #fff !important;
}

.confirm-btn {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%) !important;
  color: #fff !important;
  border: none !important;
}
