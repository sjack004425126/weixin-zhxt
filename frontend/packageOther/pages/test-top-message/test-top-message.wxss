.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 32rpx 0;
  background: linear-gradient(135deg, #1890FF, #40A9FF);
  border-radius: 16rpx;
  color: #fff;
}

.header .title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.header .subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1890FF;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-row:last-child {
  margin-bottom: 0;
}

.btn {
  flex: 1;
  min-width: 200rpx;
  margin: 0 !important;
  padding: 16rpx 24rpx !important;
  font-size: 26rpx !important;
  line-height: 1.4 !important;
  border-radius: 12rpx !important;
  border: none !important;
  color: #fff !important;
  background: #666 !important;
}

.btn::after {
  border: none !important;
}

.btn-success {
  background: linear-gradient(135deg, #51cf66, #2f9e44) !important;
}

.btn-error {
  background: linear-gradient(135deg, #ff6b6b, #e03131) !important;
}

.btn-warning {
  background: linear-gradient(135deg, #ffd43b, #f59f00) !important;
  color: #5c3a00 !important;
}

.btn-info {
  background: linear-gradient(135deg, #74c0fc, #1971c2) !important;
}

.btn-default {
  background: #f0f0f0 !important;
  color: #333 !important;
  border: 1rpx solid #d9d9d9 !important;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
}

.toolbar {
  position: fixed;
  bottom: 32rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 100;
}

.tool-btn {
  background: #333 !important;
  color: #fff !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.tool-btn::after {
  border: none !important;
}

.footer {
  height: 160rpx;
}
