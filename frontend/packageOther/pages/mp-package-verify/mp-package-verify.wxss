/* 局部页面 wxss：不重复 @import app.wxss 已加载的 my-iconfont.wxss */

page {
  --primary: #1890ff;
  --bg-page: #f5f7fa;
}

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.banner {
  background: linear-gradient(135deg, #52c41a 0%, #1890ff 100%);
  padding: 36rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.2);
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.section-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  margin-right: 16rpx;
  font-weight: 700;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
  padding: 12rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-family: Menlo, Consolas, monospace;
  word-break: break-all;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx 12rpx 16rpx;
}

.icon-wrap {
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  color: var(--primary);
}

.icon-wrap text {
  font-size: 96rpx;
}

.icon-name {
  font-size: 22rpx;
  color: #262626;
  font-family: Menlo, Consolas, monospace;
}

.dynamic-demo {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f0f0f0 100%);
  border-radius: 12rpx;
}
