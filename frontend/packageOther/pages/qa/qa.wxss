/* 主容器 - 苹果风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  animation: fadeIn 0.8s ease-out;
}

/* 顶部标题区域 */
.header-section {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.header-content {
  animation: fadeInDown 0.8s ease-out;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: bounce 2s infinite;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #86868b;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.header-description {
  font-size: 30rpx;
  color: #515154;
  font-weight: 400;
}

/* 搜索区域 */
.search-section {
  padding: 0 40rpx 30rpx;
  animation: fadeInUp 0.6s ease-out 0.2s both;
}

.search-box {
  position: relative;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.search-icon {
  font-size: 32rpx;
  color: #86868b;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #1d1d1f;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #86868b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  opacity: 0;
  transform: scale(0);
  transition: all 0.3s ease;
}

.search-clear.show {
  opacity: 1;
  transform: scale(1);
}

/* 分类标签区域 */
.category-section {
  padding: 0 40rpx 30rpx;
  animation: fadeInUp 0.6s ease-out 0.3s both;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.category-tag {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #515154;
  white-space: nowrap;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.category-tag.active {
  background: #007aff;
  color: #fff;
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

/* 问答列表 */
.qa-list {
  padding: 0 40rpx 40rpx;
}

.qa-item {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  animation: slideInUp 0.6s ease-out;
}

.qa-item:nth-child(2) { animation-delay: 0.1s; }
.qa-item:nth-child(3) { animation-delay: 0.2s; }
.qa-item:nth-child(4) { animation-delay: 0.3s; }

.qa-item:active {
  transform: scale(0.98);
}

.qa-item.expanded {
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

/* 问题部分 */
.question-section {
  padding: 32rpx;
}

.question-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.q-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #007aff, #5856d6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

.q-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.question-content {
  flex: 1;
}

.q-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-badge {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.question-id {
  font-size: 22rpx;
  color: #86868b;
}

.expand-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
  color: #86868b;
  font-size: 24rpx;
}

.expand-icon.rotated {
  transform: rotate(180deg);
}

/* 答案部分 */
.answer-section {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease, padding 0.4s ease;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.answer-section.show {
  max-height: 2000rpx;
  padding: 32rpx;
}

.answer-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.a-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #34c759, #30d158);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(52, 199, 89, 0.3);
}

.a-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.answer-content {
  margin-left: 76rpx;
}

/* 简单答案 */
.simple-answer {
  font-size: 28rpx;
  color: #515154;
  line-height: 1.6;
}

/* 详细答案 */
.detailed-answer {
  font-size: 28rpx;
  color: #515154;
  line-height: 1.6;
}

.answer-intro {
  margin-bottom: 24rpx;
  font-weight: 500;
}

.step-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #ff9500, #ff6b35);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 8rpx;
}

.step-description {
  color: #515154;
  line-height: 1.6;
}

.step-highlight {
  margin-top: 16rpx;
  background: rgba(255, 149, 0, 0.1);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #ff9500;
}

.highlight-item {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #1d1d1f;
}

.highlight-item:last-child {
  margin-bottom: 0;
}

/* 操作按钮 */
.answer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  margin-left: 76rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.action-btn.helpful {
  background: rgba(52, 199, 89, 0.1);
  color: #34c759;
}

.action-btn.copy {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  animation: fadeIn 0.6s ease-out;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

.empty-description {
  font-size: 28rpx;
  color: #86868b;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.contact-btn {
  display: inline-block;
  background: linear-gradient(135deg, #007aff, #5856d6);
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.contact-btn:active {
  transform: scale(0.95);
}

/* 底部帮助区域 */
.help-section {
  padding: 40rpx;
  animation: fadeInUp 0.6s ease-out 0.4s both;
}

.help-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.help-icon {
  font-size: 64rpx;
  flex-shrink: 0;
}

.help-content {
  flex: 1;
}

.help-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 8rpx;
}

.help-description {
  font-size: 26rpx;
  color: #86868b;
  line-height: 1.4;
}

.help-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.help-btn {
  padding: 20rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.help-btn.primary {
  background: linear-gradient(135deg, #007aff, #5856d6);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

.help-btn.secondary {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
  border: 1rpx solid rgba(0, 122, 255, 0.2);
}

.help-btn:active {
  transform: scale(0.95);
}

/* 动画定义 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-20rpx);
  }
  60% {
    transform: translateY(-10rpx);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .header-title {
    font-size: 40rpx;
  }

  .header-subtitle {
    font-size: 24rpx;
  }

  .header-description {
    font-size: 26rpx;
  }

  .help-card {
    flex-direction: column;
    text-align: center;
  }

  .help-actions {
    flex-direction: row;
    width: 100%;
  }

  .help-btn {
    flex: 1;
  }

  .answer-actions {
    flex-direction: column;
    margin-left: 0;
  }

  .action-btn {
    justify-content: center;
  }
}
 