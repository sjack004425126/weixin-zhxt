.page-header {
  padding: 32rpx 32rpx 16rpx;
}
.page-header .title {
  font-size: 40rpx;
  font-weight: 600;
}
.page-header .subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.auth-banner {
  margin: 0 32rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.auth-ok { background: #e6f7ec; color: #2e7d32; }
.auth-no { background: #fff3e0; color: #ef6c00; }

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
}
.cell {
  flex: 1 1 calc(33.33% - 16rpx);
  min-width: calc(33.33% - 16rpx);
  font-size: 24rpx !important;
  border-radius: 12rpx !important;
  line-height: 1.5 !important;
  padding: 0 12rpx !important;
  height: 72rpx !important;
  margin: 0 !important;
}
.primary { background: #1890ff !important; color: #fff !important; }
.warning { background: #fa8c16 !important; color: #fff !important; }
.danger  { background: #f5222d !important; color: #fff !important; }
.ghost   { background: #f5f5f5 !important; color: #333 !important; border: 1rpx solid #ddd !important; }

.card {
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
  padding: 20rpx 24rpx;
}
.card-title { font-weight: 600; margin-bottom: 12rpx; font-size: 28rpx; }
.err-row { font-size: 26rpx; line-height: 1.8; word-break: break-all; }
.mono {
  font-family: 'Cascadia Code', 'Courier New', monospace;
  background: #f0f0f0;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.log-list { padding: 0 32rpx 80rpx; }
.log-title { font-weight: 600; margin-bottom: 16rpx; font-size: 28rpx; }
.log-item {
  background: #fff;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-left: 8rpx solid #ddd;
}
.log-success { border-left-color: #52c41a; }
.log-fail    { border-left-color: #f5222d; }
.log-info    { border-left-color: #1890ff; }

.log-head {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.log-status {
  background: #f0f0f0;
  padding: 0 8rpx;
  border-radius: 4rpx;
  text-transform: uppercase;
}
.log-title-line { font-size: 28rpx; font-weight: 500; }
.log-payload {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-family: 'Cascadia Code', 'Courier New', monospace;
  white-space: pre-wrap;
  word-break: break-all;
  background: #fafafa;
  padding: 12rpx;
  border-radius: 6rpx;
  color: #555;
}
.empty {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 60rpx 0;
}