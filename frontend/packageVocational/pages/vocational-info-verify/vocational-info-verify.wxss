/* pages/vocational-info-verify/vocational-info-verify.wxss */

.page {
  background: #f4f6fb;
  min-height: 100vh;
  /* 底部 submit-bar 高度 + 安全区，留出空间避免被遮挡 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ====== 状态横幅 ====== */
.status-banner {
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
  color: #fff;
  background: #94a3b8;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.status-banner-pending { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.status-banner-verified { background: linear-gradient(135deg, #059669, #10b981); }
.status-banner-modified { background: linear-gradient(135deg, #1e40af, #3b82f6); }

.status-banner-row {
  display: flex;
  align-items: center;
}

.status-banner-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.status-banner-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* ====== 顶部提示 ====== */
.page-tip {
  display: flex;
  align-items: flex-start;
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #f59e0b;
  color: #fff;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #78350f;
  line-height: 1.6;
}

/* ====== 标题 ====== */
.section-title {
  padding: 0 8rpx 12rpx 8rpx;
  margin-top: 24rpx;
}

.title-text {
  font-size: 26rpx;
  color: #475569;
  letter-spacing: 1rpx;
}

/* ====== 字段卡 ====== */
.field-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 2rpx solid transparent;
  transition: border-color 200ms ease;
}

.field-card.is-modified {
  border-color: #f59e0b;
  background: #fffaf0;
}

.field-card.field-readonly {
  background: #f8fafc;
}

.field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.field-label {
  display: flex;
  align-items: center;
}

.label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-right: 16rpx;
}

/* 状态点 */
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-left: 4rpx;
  flex-shrink: 0;
}

.dot-ok {
  background: #10b981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.15);
}

.dot-warn {
  background: #f59e0b;
  box-shadow: 0 0 0 4rpx rgba(245, 158, 11, 0.18);
}

.dot-info {
  background: #94a3b8;
}

.readonly-tag {
  font-size: 22rpx;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 操作按钮 */
.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
  border: 2rpx solid #e2e8f0;
  background: #fff;
  color: #1e40af;
  transition: all 150ms ease;
}

.action-edit {
  color: #1e40af;
  border-color: #cbd5e1;
}

.action-editing {
  color: #fff;
  background: #94a3b8;
  border-color: #94a3b8;
}

.btn-disabled {
  color: #cbd5e1;
  border-color: #e2e8f0;
}

/* ====== 当前值（常驻显示） ====== */
.current-value-row {
  padding: 14rpx 0 6rpx 0;
  min-height: 50rpx;
  display: flex;
  align-items: center;
}

.current-value-row.readonly {
  opacity: 0.85;
}

/* 字典字段的可点击行 */
.current-value-row.picker-row {
  justify-content: space-between;
}

.current-value-row.picker-row:active {
  background: #f1f5f9;
  border-radius: 8rpx;
}

.picker-arrow {
  color: #94a3b8;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  margin-left: 12rpx;
}

.picker-row.editing {
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #3b82f6;
  min-height: 64rpx;
}

.picker-row.editing:active {
  background: #eff6ff;
}

.current-value-text.editing-text {
  color: #1e40af;
  font-weight: 600;
}

.editing-tip {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  padding-left: 4rpx;
}

.current-value-text {
  font-size: 32rpx;
  color: #0f172a;
  font-weight: 500;
  word-break: break-all;
  line-height: 1.5;
  flex: 1;
}

/* 编辑模式下的输入框 */
.inline-field {
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 6rpx 16rpx !important;
}

/* diff 行（修改对比） */
.diff-row {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff7ed;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 26rpx;
  font-weight: 500;
  gap: 8rpx;
}

.diff-label {
  color: #78350f;
  font-weight: 500;
  font-size: 24rpx;
}

.diff-old {
  color: #b45309;
  text-decoration: line-through;
  word-break: break-all;
}

.diff-arrow {
  color: #f59e0b;
  font-weight: 700;
  margin: 0 6rpx;
}

.diff-new {
  color: #047857;
  word-break: break-all;
}

/* ====== 修改汇总 ====== */
.summary {
  margin: 16rpx 8rpx 24rpx;
  padding: 20rpx 24rpx;
  background: #eff6ff;
  border: 2rpx dashed #3b82f6;
  border-radius: 12rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #1e3a8a;
}

.summary-count {
  color: #f59e0b;
  font-weight: 700;
  font-size: 32rpx;
  margin: 0 4rpx;
}

/* ====== 提交栏 ====== */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 99;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.submit-bar .secondary-btn {
  flex-shrink: 0;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 48rpx;
  background: #f1f5f9;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  border: 2rpx solid #e2e8f0;
  transition: opacity 200ms ease, transform 150ms ease;
}

.submit-bar .secondary-btn:active {
  transform: scale(0.97);
  background: #e2e8f0;
}

.submit-bar .secondary-btn.is-disabled {
  opacity: 0.45;
  color: #94a3b8;
}

.submit-bar .primary-btn {
  flex: 1;
  min-width: 0;
}

.primary-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1e40af, #3b82f6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
  transition: opacity 200ms ease, transform 150ms ease;
}

.primary-btn.is-loading {
  opacity: 0.7;
}

.primary-btn.is-disabled {
  background: #cbd5e1;
  color: #94a3b8;
}

.primary-btn:active {
  transform: scale(0.98);
}

.primary-btn-text {
  color: #fff;
  line-height: 1;
}
