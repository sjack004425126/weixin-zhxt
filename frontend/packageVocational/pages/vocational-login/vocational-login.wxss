/* INCIDENTS/001: 修复 vant-icon 不显示问题 */
@import "../../../components/vant-icon/index.wxss";

.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

/* type-icon 内的图标样式 */
.type-icon .vi {
  color: #999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-icon.active .vi {
  color: currentColor;
  transform: scale(1.2);
}

/* 中等职业技术学校主题 - 蓝色科技风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 50%, #F5F9FF 100%);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 切换身份按钮 */
.switch-role-btn {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx 14rpx 14rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 52rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.12), 0 1rpx 4rpx rgba(24, 144, 255, 0.08);
  z-index: 10;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid rgba(24, 144, 255, 0.1);
  cursor: pointer;
}

.switch-role-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.15);
}

.switch-role-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1) 0%, rgba(64, 169, 255, 0.15) 100%);
  border-radius: 50%;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.switch-role-btn:active .switch-role-icon {
  transform: rotate(180deg);
}

.switch-role-btn text {
  font-size: 26rpx;
  color: #1890FF;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%231890FF' fill-opacity='0.04'%3E%3Cpath d='M20 20.5V18H18v2.5h-2.5V22H18v2.5h2V22h2.5v-1.5H20zM0 38.5V36h2.5v2.5H5V40H2.5v2.5H0V40h-2.5v-1.5H0zm0-40V-1.5h2.5V1H5v1.5H2.5V4H0V2.5h-2.5V1H0z'/%3E%3C/g%3E%3C/svg%3E") repeat;
  opacity: 0.3;
  z-index: 0;
}

.login-box {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 80rpx 40rpx 60rpx;
  box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(24, 144, 255, 0.1);
  position: relative;
  z-index: 1;
}

.login-box::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1890FF 0%, #40A9FF 50%, #1890FF 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  text-align: center;
  margin-bottom: 20rpx;
  position: relative;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.title:first-child::after {
  content: '';
}

.title:last-child {
  margin-bottom: 80rpx;
}

.school-badge {
  position: absolute;
  top: -20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.school-badge.vocational {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  color: white;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.login-type {
  display: flex;
  justify-content: space-around;
  margin: 0 40rpx 60rpx;
  padding: 20rpx 0;
}

.type-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 100%);
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid rgba(24, 144, 255, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
}

.type-icon .van-icon {
  color: #999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-icon.active {
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.15) 0%, rgba(64, 169, 255, 0.15) 100%);
  border-color: #1890FF;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.2);
  transform: translateY(-4rpx) rotate(5deg);
}

.type-icon.active .van-icon {
  color: #1890FF;
  transform: scale(1.2);
}

.type-icon:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.12);
}

.type-icon:active {
  opacity: 0.8;
}

.type-item {
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.type-item.active {
  color: #E86433;
  font-weight: 500;
}

.type-item.active::after {
  content: '';
  position: absolute;
  bottom: -22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #E86433;
  border-radius: 2rpx;
}

.login-form {
  margin-bottom: 40rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.quick-login-tip {
  text-align: center;
  color: #666;
  font-size: 28rpx;
  padding: 60rpx 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 快捷登录下方的补充说明（如"首次使用请先绑定微信"） */
.quick-login-note {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0 0;
  line-height: 1.6;
}

.login-form .van-button {
  margin-top: auto;
}

.agreement {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.agreement-links {
  margin-top: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.link {
  color: #1890ff;
  display: inline;
}

/* 自定义输入格（替代 van-field，绕开 Vant 官方 icon 远程字体） */
.custom-input-cell {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 100%);
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 24rpx 32rpx;
  border: 2rpx solid rgba(24, 144, 255, 0.1);
  transition: all 0.3s ease;
  position: relative;
  box-sizing: border-box;
}

.custom-input-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 12rpx 0 0 12rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.custom-input-cell:focus-within::before {
  opacity: 1;
}

.custom-input-cell:focus-within {
  border-color: #1890FF;
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.1);
  background: #fff;
}

.custom-input-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.custom-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  background: transparent;
  border: 0;
  outline: 0;
  padding: 0;
  height: 44rpx;
  line-height: 44rpx;
  min-height: 44rpx;
}

.custom-input-placeholder {
  color: #C8C8C8;
}

/* van-button 样式覆盖 - 中职蓝色主题 */
.van-button {
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 12rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.3) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  position: relative !important;
  overflow: hidden !important;
}

.van-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.van-button:active::before {
  left: 100%;
}

.van-button:active {
  transform: translateY(2rpx) scale(0.98) !important;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3) !important;
}

/* van-checkbox 样式覆盖 */
.van-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-icon {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  z-index: 100;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.home-icon:active {
  opacity: 0.8;
}

checkbox {
  transform: scale(0.8);
  margin-right: 4rpx;
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 60rpx;
  padding: 20rpx 30rpx;
}

.nav-btn {
  padding: 16rpx 30rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.nav-icons {
  position: fixed;
  top: 0;
  right: 0;
  padding: 40rpx 30rpx;
  z-index: 100;
}

.icon-btn {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.icon-btn:active {
  opacity: 0.8;
}

.go-university {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.15) 0%, rgba(64, 169, 255, 0.15) 100%);
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.15);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.go-university::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.8s ease;
}

.go-university:hover::before {
  left: 100%;
}

.go-university:hover {
  transform: translateY(-2rpx) rotate(-2deg);
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.2);
}

.bounce-text {
  color: #1890FF;
  font-size: 28rpx;
  margin-right: 8rpx;
  font-weight: 600;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(-3px);
  }
}

/* 页面加载动画 */
.login-box {
  animation: slideInUp 0.6s ease-out;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 标题渐变动画 */
.title {
  animation: fadeInLeft 0.8s ease-out 0.2s both;
}

@keyframes fadeInLeft {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 学校标识动画 */
.school-badge {
  animation: bounceIn 0.8s ease-out 0.4s both;
}

@keyframes bounceIn {
  0% {
    opacity: 0;
    transform: scale(0.3);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
  70% {
    transform: scale(0.9);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 登录方式图标动画 */
.login-type {
  animation: fadeIn 0.8s ease-out 0.5s both;
}

.type-icon:nth-child(1) {
  animation: flipIn 0.6s ease-out 0.6s both;
}

.type-icon:nth-child(2) {
  animation: flipIn 0.6s ease-out 0.7s both;
}

.type-icon:nth-child(3) {
  animation: flipIn 0.6s ease-out 0.8s both;
}

@keyframes flipIn {
  0% {
    opacity: 0;
    transform: rotateY(90deg) scale(0.5);
  }
  50% {
    transform: rotateY(-10deg) scale(1.05);
  }
  100% {
    opacity: 1;
    transform: rotateY(0) scale(1);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 登录表单动画 */
.login-form {
  animation: slideInRight 0.6s ease-out 0.9s both;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 协议区域动画 */
.agreement {
  animation: fadeInUp 0.6s ease-out 1s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 切换身份按钮动画 */
.switch-role-btn {
  animation: switchBtnIn 0.6s ease-out 0.3s both;
}

@keyframes switchBtnIn {
  0% {
    opacity: 0;
    transform: translateX(-30rpx) scale(0.8);
  }
  60% {
    transform: translateX(6rpx) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.switch-role-icon {
  animation: iconPulse 3s ease-in-out 1.5s infinite;
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 顶部装饰线动画 */
.login-box::before {
  animation: expandWidth 0.8s ease-out 0.2s both;
}

@keyframes expandWidth {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}

/* 记住密码选项动画 */
.remember-password {
  animation: fadeIn 0.5s ease-out 1.1s both;
}


/* 记住密码选项 */
.remember-password {
  margin: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.remember-password checkbox {
  transform: scale(0.8);
  margin-right: 8rpx;
}


/* 手机号快捷登录按钮 */
.phone-login-btn {
  width: 100%;
  min-width: 480rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  color: white;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.phone-login-btn:active::before {
  left: 100%;
}

.phone-login-btn:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}
