/* ========================================================================
 * 中职新生缴费页面 - 样式表
 * 设计系统来源: ui-ux-pro-max
 * Pattern: Enterprise Gateway (企业网关式)
 * Style: Trust & Authority + Dimensional Layering
 * 配色: B2B Service 金融专业 (Navy / Slate / Sky / Emerald)
 * ======================================================================== */

page {
  --color-navy: #1890FF;          /* 主色 - 品牌蓝（与 new-student-payment 一致） */
  --color-slate: #40A9FF;
  --color-sky: #1890FF;           /* 主品牌色 - 蓝 */
  --color-sky-light: #40A9FF;
  --color-sky-bg: #E6F7FF;        /* 浅蓝背景 */
  --color-emerald: #059669;       /* 成功色 - 绿（防伪用） */
  --color-emerald-light: #10B981;
  --color-emerald-bg: #ECFDF5;
  --color-amber: #FAAD14;
  --color-amber-bg: #FFFBEB;
  --color-red: #FF4D4F;

  --color-text: #262626;
  --color-text-secondary: #595959;
  --color-text-muted: #8C8C8C;
  --color-border: #F0F0F0;
  --color-border-light: #F5F5F5;
  --color-bg: #FAFAFA;
  --color-card: #FFFFFF;

  /* 阴影（蓝色调） */
  --elev-1: 0 2rpx 8rpx rgba(24, 144, 255, 0.06);
  --elev-2: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --elev-3: 0 10rpx 20rpx rgba(24, 144, 255, 0.10), 0 4rpx 8rpx rgba(24, 144, 255, 0.06);
  --elev-4: 0 20rpx 40rpx rgba(24, 144, 255, 0.12), 0 8rpx 16rpx rgba(24, 144, 255, 0.08);

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
}

/* =========================== 页面根容器 =========================== */
.page-root {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-sky-bg) 0%, var(--color-bg) 280rpx);
  padding: 0 28rpx 80rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
}

/* =========================== 顶部头部 =========================== */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0 -28rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 32rpx;
}

.header-badge {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  flex-shrink: 0;
}

.header-text {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.header-subtitle {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* =========================== 查询区 =========================== */
.query-section {
  margin-bottom: 28rpx;
}

/* 标签页 */
.query-tabs {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 12rpx;
  box-shadow: var(--elev-2);
  border: 1rpx solid var(--color-border);
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 8rpx 14rpx;
  border-radius: var(--radius-md);
  transition: all 0.25s ease;
  position: relative;
  cursor: pointer;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-slate) 100%);
  color: #fff;
  box-shadow: var(--elev-2);
  transform: translateY(-2rpx);
}

.tab-item.active .tab-desc {
  color: rgba(255, 255, 255, 0.7);
}

.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-sky-bg);
  color: var(--color-sky);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.tab-item.active .tab-icon-wrap {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.tab-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.tab-item.active .tab-label {
  color: #fff;
}

.tab-desc {
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 2rpx;
}

.tab-divider {
  width: 1rpx;
  background: var(--color-border);
  margin: 12rpx 0;
}

/* =========================== 查询卡片 =========================== */
.query-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  box-shadow: var(--elev-3);
  border: 1rpx solid var(--color-border);
  position: relative;
  z-index: 1;
}

/* 卡片介绍头部 */
.card-intro {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--color-border);
  margin-bottom: 24rpx;
}

.card-intro-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--color-sky-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-intro-text {
  flex: 1;
  min-width: 0;
}

.card-intro-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1.3;
}

.card-intro-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 表单 body */
.form-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 输入框行 */
.input-row {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 96rpx;
  transition: all 0.2s ease;
}

.input-row:focus-within {
  border-color: var(--color-sky);
  background: #fff;
  box-shadow: 0 0 0 6rpx rgba(24, 144, 255, 0.1);
}

.input-prefix {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.main-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.input-placeholder {
  color: var(--color-text-muted);
  font-weight: 400;
}

/* 主按钮 */
.primary-btn {
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-sky) 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.18);
  transition: all 0.2s ease;
  border: none;
  cursor: pointer;
}

.primary-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.18);
}

.primary-btn.btn-disabled {
  background: linear-gradient(135deg, #94A3B8 0%, #CBD5E1 100%);
  box-shadow: none;
  color: #fff;
  opacity: 0.85;
}

.primary-btn::after {
  border: none;
}

/* 手机号验证区 */
.phone-verify-section {
  background: linear-gradient(135deg, var(--color-emerald-bg) 0%, #F0FDF4 100%);
  border-radius: var(--radius-md);
  padding: 24rpx;
  border: 2rpx dashed var(--color-emerald);
  position: relative;
}

.phone-verify-header {
  margin-bottom: 20rpx;
}

.phone-verify-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-emerald);
}

.phone-verify-tip-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  margin-left: 32rpx;
  line-height: 1.5;
}

.phone-btn {
  height: 88rpx;
  background: #fff;
  color: var(--color-emerald);
  border: 2rpx solid var(--color-emerald);
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  padding: 0;
  cursor: pointer;
}

.phone-btn.verified {
  background: var(--color-emerald);
  color: #fff;
  border-color: var(--color-emerald);
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.25);
}

.phone-btn::after {
  border: none;
}

.phone-btn-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.verified-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.reverify {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: underline;
  margin-left: 8rpx;
}

/* 信任条 */
.trust-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 32rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.trust-sep {
  width: 1rpx;
  height: 28rpx;
  background: var(--color-border);
}

/* =========================== 水印横幅（查询后才显示） =========================== */
/* =========================== 整页平铺水印 =========================== */
.page-watermark {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.page-watermark-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 1;
  z-index: 0;
}

/* 让 showResult 内部卡片浮在水印之上 */
.result-card,
.watermark-banner,
.requery-section,
.payment-area {
  position: relative;
  z-index: 2;
}

.watermark-banner {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: var(--elev-3);
  border: 2rpx solid var(--color-emerald);
  min-height: 140rpx;
}

.watermark-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.45;
}

.watermark-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, rgba(236, 253, 245, 0.92) 0%, rgba(240, 249, 255, 0.92) 100%);
  backdrop-filter: blur(2rpx);
}

.watermark-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--color-emerald);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.3);
}

.watermark-info {
  flex: 1;
  min-width: 0;
}

.watermark-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1.2;
}

.watermark-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-family: "SF Mono", "Roboto Mono", monospace;
  letter-spacing: 0.5rpx;
}

.watermark-time {
  color: var(--color-text-muted);
}

.watermark-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: var(--color-emerald);
  color: #fff;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* =========================== 结果卡片（公共） =========================== */
.result-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--elev-2);
  border: 1rpx solid var(--color-border);
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.card-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-navy);
}

.section-title-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  background: var(--color-sky-bg);
  color: var(--color-sky);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: var(--color-emerald-bg);
  color: var(--color-emerald);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.enrollment-badge {
  background: var(--color-amber-bg);
  color: var(--color-amber);
}

.unpaid-badge {
  background: rgba(24, 144, 255, 0.08);
  color: var(--color-sky);
}

/* 已缴费脉冲点 */
.paid-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-emerald);
  box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6);
  animation: paid-pulse 2s infinite;
}

@keyframes paid-pulse {
  0% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6); }
  70% { box-shadow: 0 0 0 12rpx rgba(5, 150, 105, 0); }
  100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
}

/* =========================== 报名信息网格 =========================== */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.info-cell {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border-left: 8rpx solid var(--color-sky);
  min-width: 0;
}

.info-cell .cell-value {
  word-break: break-all;
}

.info-cell.is-remark {
  grid-column: 2;
  grid-row: 2;
}

.cell-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.cell-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-navy);
  line-height: 1.3;
  word-break: break-all;
}

.cell-value.remark {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* =========================== 缴费成功 banner =========================== */
.paid-success-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--color-emerald) 0%, var(--color-emerald-light) 100%);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.25);
}

.paid-success-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.paid-success-text {
  flex: 1;
}

.paid-success-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.paid-success-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* =========================== 费用列表 =========================== */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.fee-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.fee-row:last-child {
  border-bottom: none;
}

.fee-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.fee-name {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.fee-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  font-family: "SF Mono", "Roboto Mono", monospace;
  text-align: right;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.fee-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: var(--color-emerald-bg);
  border-radius: 50%;
  flex-shrink: 0;
}

.fee-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 12rpx 0;
}

.fee-row.total-row {
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  margin-left: -28rpx;
  margin-right: -28rpx;
  background: linear-gradient(135deg, var(--color-sky-bg) 0%, #BAE0FF 100%);
  border-top: none;
  border-radius: 16rpx;
  border: 2rpx solid #91D5FF;
}

.fee-name.total-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-sky);
}

.fee-amount.total-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-sky);
  letter-spacing: 1rpx;
}

/* 缴费按钮区 */
.payment-area {
  margin-top: 24rpx;
}

.pay-btn {
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-sky) 100%);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

/* =========================== 缴费记录 =========================== */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
  gap: 16rpx;
}

.record-row:last-child {
  border-bottom: none;
}

.record-key {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  min-width: 160rpx;
}

.record-val {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  word-break: break-all;
}

.record-money {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-emerald);
  font-family: "SF Mono", "Roboto Mono", monospace;
}

.record-trade {
  font-family: "SF Mono", "Roboto Mono", monospace;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.3rpx;
}

/* 家长通知 */
.parent-notify {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--color-emerald-bg);
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--color-emerald);
}

.parent-notify.warning-state {
  background: var(--color-amber-bg);
  border-left-color: var(--color-amber);
}

.notify-icon {
  width: 56rpx;
  height: 56rpx;
  background: var(--color-emerald);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notify-icon.warning-icon {
  background: var(--color-amber);
}

.notify-body {
  flex: 1;
  min-width: 0;
}

.notify-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1.3;
}

.notify-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.4;
}

/* =========================== 录取通知书卡片 =========================== */
.admission-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--elev-2);
  border: 1rpx solid var(--color-border);
  cursor: pointer;
  transition: all 0.2s ease;
  background: linear-gradient(135deg, #FFFFFF 0%, #F0F9FF 100%);
}

.admission-card:active {
  transform: translateY(2rpx);
  box-shadow: var(--elev-1);
}

.admission-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.admission-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-sky-bg);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.admission-info {
  flex: 1;
  min-width: 0;
}

.admission-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1.2;
}

.admission-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.admission-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.downloading-state,
.download-ready {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-sky);
  font-weight: 600;
}

.downloading-state text {
  color: var(--color-sky);
}

/* =========================== 重新查询 =========================== */
.requery-section {
  display: block;
  width: 100%;
  text-align: center;
  margin: 40rpx 0 0;
}

.requery-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  background: transparent;
  color: var(--color-sky);
  border: 2rpx solid var(--color-sky);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  /* button 元素自带样式重置 */
  margin: 0;
  line-height: 1.4;
}

.requery-btn::after {
  border: none;
}

.requery-btn:active {
  background: var(--color-sky-bg);
}

/* =========================== 防伪页脚 =========================== */
.page-footer {
  margin-top: 40rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* =========================== 缴费弹窗 =========================== */
.pay-popup {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--elev-4);
}

.popup-head {
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-sky) 100%);
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
}

.popup-head-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.popup-head-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.popup-fee-list {
  padding: 24rpx 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.popup-fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.popup-fee-item text:last-child {
  font-family: "SF Mono", "Roboto Mono", monospace;
  font-weight: 600;
  color: var(--color-text);
}

.popup-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border-light);
  border-bottom: 1rpx solid var(--color-border-light);
}

.popup-total text:first-child {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-navy);
}

.popup-total-amount {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-navy);
  font-family: "SF Mono", "Roboto Mono", monospace;
}

.popup-actions {
  display: flex;
  gap: 0;
  padding: 24rpx 32rpx;
  background: var(--color-card);
}

.popup-cancel,
.popup-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0 8rpx;
  transition: all 0.2s ease;
}

.popup-cancel {
  background: var(--color-bg);
  color: var(--color-text-secondary);
}

.popup-confirm {
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-sky) 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.popup-cancel::after,
.popup-confirm::after {
  border: none;
}

/* =========================== 整页文字水印（canvas 2d） =========================== */
.page-watermark-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
}

/* =========================== 已认证信息卡片 =========================== */
.watermark-info-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 100%);
  border: 2rpx solid #a7f3d0;
  border-radius: var(--radius-lg);
  margin: 0 0 24rpx;
  gap: 20rpx;
}

.watermark-info-icon {
  width: 72rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.15);
  flex-shrink: 0;
}

.watermark-info-text {
  flex: 1;
  min-width: 0;
}

.watermark-info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #064e3b;
  line-height: 1.4;
}

.watermark-info-sub {
  font-size: 24rpx;
  color: #047857;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.watermark-info-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: #059669;
  color: #fff;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}