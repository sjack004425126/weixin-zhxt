/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #F5F7FA;
  --card-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.06);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.12);
  --border-radius: 20rpx;
}

.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 0 24rpx 200rpx;
}

/* 页面头部样式 */
.page-header {
  padding: 24rpx 0 20rpx;
  margin: 0 -24rpx 24rpx;
  background: white;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx;
}

.header-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--primary-gradient);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25);
}

.header-text {
  flex: 1;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: var(--text-disabled);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-mode-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}
.header-mode-tag-edit {
  background: #FFF7E6;
  color: #D46B08;
  border: 1rpx solid #FFD591;
}
.header-mode-tag-new {
  background: #E6F7FF;
  color: #1890FF;
  border: 1rpx solid #91D5FF;
}

/* 表单容器 */
.form-container {
  position: relative;
}

.form-section {
  background: white;
  border-radius: var(--border-radius);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
  border: none;
  position: relative;
  overflow: hidden;
  animation: sectionFadeIn 0.5s ease-out both;
}

.form-section:nth-child(1) { animation-delay: 0.05s; }
.form-section:nth-child(2) { animation-delay: 0.1s; }
.form-section:nth-child(3) { animation-delay: 0.15s; }
.form-section:nth-child(4) { animation-delay: 0.2s; }
.form-section:nth-child(5) { animation-delay: 0.25s; }

@keyframes sectionFadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.form-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--primary-gradient);
  border-radius: 0 4rpx 4rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  padding-left: 8rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.section-title::before {
  display: none;
}
  
/* 提交按钮区域 - 固定底部 */
.submit-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.button-group {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.submit-button {
  flex: 1 !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border-radius: 16rpx !important;
  background: var(--primary-gradient) !important;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.3) !important;
  border: none !important;
  color: white !important;
}

.clear-button {
  width: 200rpx !important;
  flex: none !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 28rpx !important;
  font-weight: 500 !important;
  border-radius: 16rpx !important;
  border: 2rpx solid #D9D9D9 !important;
  color: var(--text-secondary) !important;
  background: #FAFAFA !important;
  box-shadow: none !important;
}

.clear-button::after {
  border: none !important;
}
  

  
/* 表单字段样式 */
.van-field__label {
  width: 240rpx !important;
  display: flex;
  font-weight: 500 !important;
  color: var(--text-secondary) !important;
}

.van-field__input {
  color: var(--text-primary) !important;
  font-weight: 500 !important;
}

.van-field__body {
  border-radius: 8rpx;
  background: #FAFBFC;
  transition: all 0.3s ease;
}

.van-field--focused .van-field__body {
  background: white;
  box-shadow: 0 0 0 2rpx rgba(24, 144, 255, 0.1);
}

/* 必填项标记 */
.van-field--required::before {
  content: '*';
  color: var(--error-color) !important;
  margin-right: 8rpx;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}

/* 选择器样式 */
.van-picker__toolbar {
  height: 96rpx !important;
  background: var(--primary-light) !important;
}

.van-picker__cancel,
.van-picker__confirm {
  font-size: 32rpx !important;
  padding: 0 32rpx !important;
  font-weight: 600 !important;
}

.van-picker__confirm {
  color: var(--primary-color) !important;
}

.van-picker-column {
  font-size: 32rpx !important;
}

.van-picker__option {
  color: var(--text-primary) !important;
}

.van-picker__option--selected {
  color: var(--primary-color) !important;
  font-weight: 600 !important;
}

  /* pages/index/index.wxss */
.picker-wrapper {
  padding: 12px 16px;
  background-color: #f8f8f8;
  border-radius: 8px;
  font-size: 16px;
  line-height: 1.5;
  /* 允许长文本换行 */
  white-space: normal;
  word-break: break-all;
}

/* ==================== 推广横幅样式 ==================== */

.promotion-banner {
  background: var(--primary-gradient);
  margin: 0 0 24rpx;
  border-radius: var(--border-radius);
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--card-shadow-hover);
  position: relative;
  overflow: hidden;
  animation: slideInDown 0.6s ease-out;
}

.promotion-banner::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  animation: shimmer 3s infinite;
}

.promotion-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  animation: bounce 2s infinite;
}

.promotion-text {
  flex: 1;
  color: #fff;
}

.promotion-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.promotion-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.promotion-badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}

@keyframes slideInDown {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%) translateY(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) translateY(100%) rotate(45deg);
  }
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-8rpx);
  }
  60% {
    transform: translateY(-4rpx);
  }
}

/* ==================== 介绍人选择器样式 ==================== */

.introducer-selector {
  position: relative;
}

.field-wrapper {
  position: relative;
  cursor: pointer;
}

.introducer-popup {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 弹窗头部 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #86868b;
  transition: all 0.3s ease;
}

.popup-close:active {
  background: rgba(0, 0, 0, 0.1);
  transform: scale(0.9);
}

/* 搜索区域 */
.search-section {
  padding: 0 40rpx 24rpx;
}

.search-box {
  position: relative;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  transition: all 0.3s ease;
}

.search-box:focus-within {
  background: var(--primary-light);
  box-shadow: 0 0 0 2rpx rgba(24, 144, 255, 0.2);
}

.search-icon {
  font-size: 32rpx;
  color: #86868b;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  background: transparent;
}

.search-clear {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #86868b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  opacity: 0;
  transform: scale(0);
  transition: all 0.3s ease;
}

.search-clear.show {
  opacity: 1;
  transform: scale(1);
}

.search-clear:active {
  background: #666;
  transform: scale(0.9);
}

/* 字母导航 */
.alphabet-nav {
  padding: 0 40rpx 24rpx;
}

.alphabet-scroll {
  white-space: nowrap;
}

.alphabet-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.alphabet-item {
  display: inline-block;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 24rpx;
  color: #515154;
  white-space: nowrap;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.alphabet-item.active {
  background: var(--primary-color);
  color: #fff;
  transform: scale(1.1);
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.alphabet-item:active {
  transform: scale(0.95);
}

/* 介绍人列表 */
.introducer-list {
  flex: 1;
  padding: 0 40rpx 40rpx; /* 底部添加内边距 */
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #86868b;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
}

.introducer-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.introducer-item:last-child {
  border-bottom: none;
}

.introducer-item:active {
  background: rgba(24, 144, 255, 0.1);
  border-radius: 12rpx;
  margin: 0 -20rpx;
  padding: 24rpx 20rpx;
  transform: scale(0.98);
}

.introducer-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.introducer-info {
  flex: 1;
}

.introducer-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1d1d1f;
  margin-bottom: 4rpx;
}

.introducer-pinyin {
  font-size: 24rpx;
  color: #86868b;
  text-transform: uppercase;
}

.introducer-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #e5e5e7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.introducer-check.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  opacity: 0;
  transform: scale(0);
  transition: all 0.3s ease;
}

.introducer-check.checked .check-icon {
  opacity: 1;
  transform: scale(1);
}


/* ==================== 步骤徽标 ==================== */

.step-badge {
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
  flex-shrink: 0;
}

/* ==================== 步骤指示条 ==================== */

.step-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 20rpx;
}

.step-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E8E8E8;
  color: #BFBFBF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.step-node.active .step-dot {
  background: var(--primary-color);
  color: white;
  box-shadow: 0 4rpx 14rpx rgba(24, 144, 255, 0.4);
  transform: scale(1.12);
}

.step-node.done .step-dot {
  background: var(--secondary-color);
  color: white;
}

.step-label {
  font-size: 20rpx;
  color: #BFBFBF;
  white-space: nowrap;
}

.step-node.active .step-label {
  color: var(--primary-color);
  font-weight: 600;
}

.step-node.done .step-label {
  color: var(--secondary-color);
}

.step-connector {
  flex: 1;
  height: 3rpx;
  background: #E8E8E8;
  margin: 0 6rpx;
  margin-bottom: 30rpx;
  border-radius: 2rpx;
}

.step-connector.done {
  background: var(--secondary-color);
}

/* ==================== 步骤内容区域 ==================== */

.step-content {
  animation: stepFadeIn 0.3s ease-out both;
}

@keyframes stepFadeIn {
  from { opacity: 0; transform: translateX(24rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

.step-intro {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  border: 1rpx solid rgba(24, 144, 255, 0.15);
}

/* ==================== 专业选择触发卡 ==================== */

.picker-card {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  border: 2rpx dashed rgba(24, 144, 255, 0.3);
  gap: 16rpx;
}

.picker-card-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.picker-card-body {
  flex: 1;
}

.picker-card-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.req-star {
  color: var(--error-color);
  margin-left: 4rpx;
}

.picker-card-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.picker-card-value.placeholder {
  color: var(--text-disabled);
  font-weight: 400;
  font-size: 28rpx;
}

.picker-card-value.has-value {
  color: var(--primary-color);
}

/* ==================== 专业选择结果卡 ==================== */

.selection-result-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--card-shadow);
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.1);
  animation: stepFadeIn 0.3s ease-out;
}

.src-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.src-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.src-tag {
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}

.src-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.src-item {
  width: calc(50% - 8rpx);
  background: #F7F9FC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.src-item.full {
  width: 100%;
}

.src-item.warn {
  background: rgba(255, 77, 79, 0.04);
  border: 1rpx solid rgba(255, 77, 79, 0.15);
}

.src-item-label {
  font-size: 22rpx;
  color: var(--text-disabled);
  margin-bottom: 6rpx;
}

.src-item-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-all;
}

.src-item-value.primary { color: var(--primary-color); }
.src-item-value.ok-text  { color: var(--secondary-color); }
.src-item-value.warn-text { color: var(--error-color); }

/* ==================== 信息汇总确认卡 ==================== */

.summary-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--card-shadow);
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.1);
}

.summary-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.summary-divider {
  height: 1rpx;
  background: var(--border-color);
  margin-bottom: 8rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F7F7;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.summary-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: right;
  flex: 1;
}

.summary-value.primary  { color: var(--primary-color); }
.summary-value.mono     { font-size: 24rpx; letter-spacing: 1rpx; }
.warn-text-sm           { color: var(--error-color); font-weight: 600; }
.ok-text-sm             { color: var(--secondary-color); font-weight: 600; }

/* ==================== 底部步骤导航 ==================== */

.step-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.step-nav-inner {
  display: flex;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.nav-back-btn {
  width: 220rpx !important;
  flex: none !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  border-radius: 16rpx !important;
  color: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
}

.nav-next-btn {
  flex: 1 !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border-radius: 16rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.3) !important;
  border: none !important;
  color: white !important;
}

.clear-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-disabled);
  padding: 2rpx 0;
}

/* ==================== 专业选择自定义弹出层 ==================== */
.mp-header {
  flex-shrink: 0;
  background: #fff;
  padding: 0 28rpx 18rpx;
}
.mp-drag-bar {
  width: 64rpx; height: 8rpx;
  background: #E8E8E8; border-radius: 8rpx;
  margin: 18rpx auto 20rpx;
}
.mp-header-row {
  display: flex; align-items: center; justify-content: space-between;
}
.mp-header-title {
  font-size: 30rpx; font-weight: 700; color: #262626;
}

/* 双栏主体 */
.mp-body {
  display: flex;
  height: 65vh;
}

/* 左栏：专业大类 */
.mp-left {
  width: 200rpx;
  flex-shrink: 0;
  height: 65vh;
  background: #F5F7FA;
  border-right: 1rpx solid #EBEBEB;
}
.mp-cat-item {
  position: relative;
  padding: 30rpx 20rpx 30rpx 24rpx;
  font-size: 26rpx;
  color: #595959;
  border-bottom: 1rpx solid #EBEBEB;
  display: flex;
  align-items: center;
  line-height: 1.4;
}
.mp-cat-active {
  background: #fff;
  color: #1890FF;
  font-weight: 600;
}
.mp-cat-bar {
  position: absolute;
  left: 0; top: 20%; bottom: 20%;
  width: 6rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: #1890FF;
}
.mp-cat-name { flex: 1; }

/* 右栏：学校/专业卡片 */
.mp-right {
  flex: 1;
  height: 65vh;
  padding: 14rpx 18rpx 60rpx;
  box-sizing: border-box;
  background: #F5F7FA;
}
.mp-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  border: 2rpx solid transparent;
}
.mp-item:active { opacity: 0.8; }
.mp-item-disabled {
  opacity: 0.5;
  background: #F5F5F5;
  pointer-events: none;
}
.mp-item-disabled .mp-item-major,
.mp-item-disabled .mp-item-school {
  color: #999999;
  text-decoration: line-through;
}
.mp-item-selected {
  border-color: #1890FF;
  background: #E6F7FF;
  box-shadow: 0 2rpx 10rpx rgba(24,144,255,0.15);
}
.mp-item-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.mp-item-school {
  font-size: 26rpx;
  font-weight: 700;
  color: #262626;
  line-height: 1.4;
  flex: 1;
}
.mp-item-major {
  font-size: 23rpx;
  color: #595959;
  line-height: 1.4;
  margin-bottom: 14rpx;
  display: block;
}
.mp-item-foot {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.mp-remaining {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.mp-ok   { background: #F6FFED; color: #52C41A; }
.mp-warn { background: #FFF7E6; color: #FA8C16; }
.mp-full { background: #FFF1F0; color: #FF4D4F; }
.mp-remark {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #F0F5FF;
  color: #2F54EB;
}
.mp-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #BFBFBF;
}


/* ==================== 查询码入口 ==================== */
.query-entry-card {
  margin: 0 0 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  display: flex;
  justify-content: center;
}

.query-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #1890FF, #40A9FF);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.25);
}

.query-btn::after {
  border: none;
}

/* ==================== 查询码弹窗 ==================== */
.query-popup {
  padding: 32rpx 32rpx 48rpx;
}

.query-popup-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  position: relative;
}

.query-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.query-popup-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.query-popup-body {
  margin-bottom: 32rpx;
}

.query-popup-tip {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 24rpx;
}

.query-popup-input {
  height: 88rpx;
  background: #f5f7fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  text-align: center;
  box-sizing: border-box;
}

.query-popup-input:focus {
  border-color: var(--primary-color);
  background: #fff;
}

.query-popup-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
}

.query-popup-hint-extra {
  color: #1890FF;
  font-weight: 500;
  margin-top: 12rpx;
}

.query-popup-footer {
  padding: 0 16rpx;
}

.query-popup-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890FF, #40A9FF);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.query-popup-btn[disabled] {
  background: #d1d5db;
  box-shadow: none;
}

.query-popup-btn::after {
  border: none;
}

/* ==================== 报名成功弹窗 ==================== */
.success-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.success-modal-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-modal-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.success-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 12rpx;
}

.success-modal-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.success-modal-code-section {
  width: 100%;
  background: #f0f9ff;
  border: 1rpx solid #bae0ff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.success-modal-code-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.success-modal-code-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.success-modal-code-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}

.success-modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.success-modal-copy-btn {
  width: 100%;
  height: 80rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-modal-continue-btn {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==================== 编辑模式提示 ==================== */
.edit-mode-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #e6f7ff;
  border: 1rpx solid #91d5ff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #096dd9;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* ==================== 校服提示 ==================== */
.uniform-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* ==================== 校服完整问题 ==================== */
.uniform-question {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.5;
  padding: 16rpx 4rpx 8rpx 4rpx;
}
.uniform-question .req-star {
  color: var(--error-color);
  margin-left: 6rpx;
}

/* ==================== 缴费状态卡片 ==================== */
.payment-status-card {
  margin: 0 0 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.payment-status-card.paid {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.payment-status-card.unpaid {
  background: #fff2e8;
  border: 1rpx solid #ffbb96;
}

.payment-status-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.payment-status-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.payment-status-card.paid .payment-status-icon {
  background: #52c41a;
  color: #fff;
}

.payment-status-card.unpaid .payment-status-icon {
  background: #fa8c16;
  color: #fff;
}

.payment-status-text {
  flex: 1;
}

.payment-status-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.payment-status-detail {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.payment-go-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #fa8c16, #fa541c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 32rpx;
  border: none;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ==================== 验证码弹窗（已报名用户身份二次验证） ==================== */
.verify-modal-card {
  width: 560rpx;
  max-width: calc(100vw - 64rpx);
  padding: 32rpx 32rpx 28rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.verify-modal-icon {
  text-align: center;
  margin-bottom: 8rpx;
}

.verify-modal-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  text-align: center;
  margin-bottom: 12rpx;
}

.verify-modal-phone {
  font-size: 24rpx;
  color: var(--primary-color);
  text-align: center;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.verify-modal-input-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--border-color);
  border-radius: 10rpx;
  padding: 0 8rpx;
  height: 72rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}

.verify-modal-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--text-primary);
  padding: 0 10rpx;
  min-width: 0;
}

.verify-modal-placeholder {
  color: var(--text-disabled);
  letter-spacing: 0;
}

.verify-modal-send-btn {
  height: 52rpx;
  padding: 0 16rpx;
  background: var(--primary-gradient);
  color: #fff;
  font-size: 22rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

.verify-modal-send-disabled {
  background: #d9d9d9;
  color: #fff;
}

.verify-modal-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.verify-modal-actions button {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
}

.verify-modal-cancel-btn {
  flex: 1 1 0;
  height: 68rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
  border-radius: 10rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
}

.verify-modal-confirm-btn {
  flex: 2 1 0;
  height: 68rpx;
  background: var(--primary-gradient);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 10rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
}

.verify-modal-confirm-disabled {
  background: #c0c4cc;
  color: #fff;
}

.verify-modal-confirm-disabled[disabled],
.verify-modal-confirm-disabled {
  background: #c0c4cc !important;
  color: #fff !important;
}

.verify-role-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 12rpx 0 18rpx;
}

.verify-role-btn {
  height: 80rpx;
  background: #f0fdf4;
  color: #059669;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: 2rpx solid #bbf7d0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.verify-role-btn-parent {
  background: #f0f7ff;
  color: #1890FF;
  border-color: #bae0ff;
}

.verify-modal-phone.verified-phone {
  background: #f0fdf4;
  color: #059669;
  border: 1rpx solid #bbf7d0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
}

/* 报名完成状态开关 */
.complete-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-radius: 12rpx;
}

.complete-switch-label {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.complete-switch-hint {
  font-size: 24rpx;
  color: var(--text-secondary, #999);
}
