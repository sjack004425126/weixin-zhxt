/* 主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --info-color: #722ED1;
  --academic-color: #13C2C2;
  --family-color: #FA8C16;
  --school-color: #EB2F96;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  --card-shadow-hover: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 0 24rpx 220rpx;
}

/* 页面头部样式 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  margin: 0 -24rpx 32rpx;
  padding: 32rpx 24rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.stats-info {
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}

.stats-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 信息卡片样式 */
.info-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
  overflow: hidden;
}

.info-card:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

/* 状态指示器 */
.status-indicator {
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  border-radius: 0 4rpx 4rpx 0;
}

.info-indicator {
  background: linear-gradient(180deg, var(--primary-color) 0%, #40A9FF 100%);
}

.academic-indicator {
  background: linear-gradient(180deg, var(--academic-color) 0%, #36CFC9 100%);
}

.family-indicator {
  background: linear-gradient(180deg, var(--family-color) 0%, #FFA940 100%);
}

.school-indicator {
  background: linear-gradient(180deg, var(--school-color) 0%, #F759AB 100%);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-badge.active {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
  border: 1rpx solid rgba(82, 196, 26, 0.2);
}

/* 信息网格 */
.card-content {
  padding: 0;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx 48rpx;
  align-items: start;
  grid-auto-rows: minmax(80rpx, auto);
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 80rpx;
  justify-content: flex-start;
}

.info-item.full-width {
  grid-column: 1 / -1;
  min-height: auto;
}

.info-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  min-height: 32rpx;
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
  word-break: break-all;
  line-height: 1.5;
  flex: 1;
  display: flex;
  align-items: flex-start;
  min-height: 36rpx;
}

/* 状态文本样式 */
.info-value.status-1 {
  color: var(--success-color);
  font-weight: 500;
}

.info-value.status-0 {
  color: var(--error-color);
  font-weight: 500;
}

/* 加载和错误状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.error-container {
  padding: 80rpx 0;
}

/* 特殊字段样式优化 */
.info-item:nth-child(odd) {
  padding-right: 8rpx;
}

.info-item:nth-child(even) {
  padding-left: 8rpx;
}

.info-item.full-width {
  padding: 0;
}

/* 长文本字段特殊处理 */
.info-value.long-text {
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .info-grid {
    grid-template-columns: 1fr;
    gap: 24rpx;
  }

  .info-item.full-width {
    grid-column: 1;
  }

  .info-item:nth-child(odd),
  .info-item:nth-child(even) {
    padding: 0;
  }
}

/* 动画效果 */
.info-card {
  animation: fadeInUp 0.6s ease-out;
}

.info-card:nth-child(2) {
  animation-delay: 0.1s;
}

.info-card:nth-child(3) {
  animation-delay: 0.2s;
}

.info-card:nth-child(4) {
  animation-delay: 0.3s;
}

.info-card:nth-child(5) {
  animation-delay: 0.4s;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 信息核对入口按钮 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 99;
}

.action-btn-primary {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1e40af, #3b82f6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
}

.action-btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}
