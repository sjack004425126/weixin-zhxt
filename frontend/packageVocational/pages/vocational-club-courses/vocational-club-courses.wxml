<!-- 顶部消息提示组件 -->
<include src="/utils/common-components.wxml" />
<view class="page-container">
  <!-- 社团报名关闭提示 banner（仅开关关闭时展示，不遮挡下方内容） -->
  <view wx:if="{{_clubSignupLocked}}" class="club-signup-banner">
    <van-icon name="info-o" size="32rpx" color="#FA8C16" class="club-signup-banner-icon" />
    <view class="club-signup-banner-text">{{_clubSignupTip}}</view>
  </view>

  <!-- 顶部已选课程 -->
  <view class="selected-courses-header" wx:if="{{selectedCourses.length > 0}}">
    <view class="header-title">
      <text>已选课程</text>
      <view class="course-count">{{selectedCourses.length}}/1</view>
    </view>
    <view class="selected-list">
      <view class="selected-card" wx:for="{{selectedCourses}}" wx:key="course_id">
        <view class="card-content">
          <view class="card-title">{{item.course_name}}</view>
          <view class="card-info">
            <view class="info-item-inline teacher-item-inline">
              <van-icon name="manager" size="24rpx" />
              <view class="teacher-list">
                <view class="teacher-item" wx:for="{{item.teachers}}" wx:key="index">
                  <text>{{item.name}}</text>
                </view>
              </view>
            </view>
            <text class="info-divider">|</text>
            <view class="info-item-inline">
              <van-icon name="location" size="24rpx" />
              <text>{{item.classroom}}</text>
            </view>
          </view>
        </view>
        <view class="card-actions">
          <view class="cancel-btn {{_clubSignupLocked ? 'cancel-btn-disabled' : ''}}" data-course="{{item}}" bindtap="onCourseCancel">退选</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 筛选区域 -->
  <view class="filter-section">
    <view class="filter-header">
      <view class="filter-title">
        <van-icon name="search" size="28rpx" />
        <text>搜索与筛选</text>
      </view>
    </view>
    <view class="search-box">
      <text class="vi search-icon" style="font-family:vant-icon,sans-serif;font-size:28rpx;color:#999;"></text>
      <input
        type="text"
        placeholder="搜索课程名称、教师或描述..."
        bindinput="onSearchInput"
        value="{{searchKeyword}}"
      />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">
        <text class="vi" style="font-family:vant-icon,sans-serif;font-size:24rpx;color:#999;"></text>
      </view>
    </view>
    <view class="filter-tags">
      <van-tag
        wx:for="{{categories}}"
        wx:key="id"
        type="{{selectedCategory === item.id ? 'primary' : 'default'}}"
        plain="{{selectedCategory !== item.id}}"
        bindtap="onCategorySelect"
        data-id="{{item.id}}"
        class="filter-tag"
      >{{item.name}}</van-tag>
    </view>
  </view>

  <!-- 课程列表 -->
  <view class="course-list" wx:if="{{filteredCourses.length > 0}}">
    <view class="course-item {{item.selected ? 'selected' : ''}} {{item.available_slots <= 0 ? 'full' : ''}}" wx:for="{{filteredCourses}}" wx:key="course_id">
      <view class="course-status-indicator" wx:if="{{item.selected}}">
        <van-icon name="success" size="24rpx" />
      </view>
      <view class="course-header">
        <view class="course-name">{{item.course_name}}</view>
        <view class="course-code">{{item.course_code}}</view>
      </view>
      
      <view class="course-info">
        <view class="info-row">
          <view class="info-item teacher-info">
            <van-icon name="manager" />
            <view class="teacher-list">
              <view class="teacher-item" wx:for="{{item.teachers}}" wx:key="index">
                <text>{{item.name}}</text>
              </view>
            </view>
          </view>
          <view class="info-item">
            <van-icon name="clock" />
            <text>{{item.hours}}学时 / {{item.credit}}学分</text>
          </view>
        </view>
        
        <view class="info-row">
          <view class="info-item">
            <van-icon name="location" />
            <text>{{item.classroom}}</text>
          </view>
          <view class="info-item">
            <view class="info-content">
              <van-icon name="friends" />
              <text>已选{{item.current_students}}/{{item.max_students}}</text>
            </view>
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{(item.current_students / item.max_students) * 100}}%"></view>
            </view>
          </view>
        </view>

        <view class="course-desc">
          <text>{{item.description}}</text>
        </view>
      </view>

      <view class="course-footer">
        <view class="tags-container">
          <van-tag type="warning" size="medium" class="tag-item">{{item.category}}</van-tag>
          <view class="capacity-info">
            <van-icon name="friends" size="20rpx" />
            <text>{{item.current_students}}/{{item.max_students}}</text>
          </view>
        </view>
        <view class="action-button">
          <van-button
            type="{{item.selected ? 'default' : 'primary'}}"
            size="small"
            disabled="{{_clubSignupLocked || (item.available_slots <= 0 && !item.selected) || (cooldownMap[item.course_id] > 0)}}"
            bind:click="{{item.selected ? 'onCourseCancel' : 'onCourseSelect'}}"
            data-course="{{item}}"
            round
            class="action-btn"
          >
            <van-icon name="{{item.selected ? 'cross' : 'plus'}}" size="20rpx" />
            {{cooldownMap[item.course_id] > 0 ? (cooldownMap[item.course_id] + 's') : (item.selected ? '退选' : (item.available_slots > 0 ? '选课' : '已满'))}}
          </van-button>
        </view>
      </view>
    </view>
  </view>
  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{!loading && filteredCourses.length === 0}}">
    <view class="empty-icon">
      <van-icon name="search" size="120rpx" />
    </view>
    <view class="empty-title">暂无课程信息</view>
    <view class="empty-desc">
      {{searchKeyword ? '没有找到相关课程，试试其他关键词' : '当前分类下暂无课程'}}
    </view>
    <van-button
      wx:if="{{searchKeyword || selectedCategory !== 'all'}}"
      type="primary"
      size="small"
      bind:click="onClearFilter"
      round
    >
      清除筛选
    </van-button>
  </view>

  <!-- 返回顶部悬浮按钮 -->
  <view class="back-to-top {{showBackToTop ? 'visible' : ''}}" bindtap="onBackToTop" hover-class="back-to-top-hover">
    <text class="vi" style="font-family:vant-icon,sans-serif;font-size:22px;color:#fff;"></text>
  </view>
</view>