/* 引入 vant-icon 字体（subPackage 路径需要 3 个 ../） */
@import "../../../components/vant-icon/index.wxss";

/* vi 类：直接用 text 渲染 vant-icon 字体的 unicode 字符 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

/* 主题颜色变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --warning-color: #FAAD14;
  --success-color: #52C41A;
  --text-main: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #EEEEEE;
  --bg-gray: #F7F8FA;
  --bg-white: #FFFFFF;
  --card-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.12);
  --border-radius-sm: 8rpx;
  --border-radius-md: 12rpx;
  --border-radius-lg: 16rpx;
  --border-radius-xl: 20rpx;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E6F7FF 0%, #F7F8FA 100%);
  padding: 24rpx 24rpx 120rpx;
  position: relative;
}

.page-container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: var(--primary-gradient);
  opacity: 0.05;
  z-index: 0;
}

/* 顶部已选课程样式 */
.selected-courses-header {
  background: var(--bg-white);
  border-radius: var(--border-radius-lg);
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  position: sticky;
  top: 0;
  z-index: 99;
  border: 1rpx solid rgba(232, 100, 51, 0.1);
  transition: box-shadow 0.3s ease;
}

.selected-courses-header:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.header-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: var(--primary-gradient);
  margin-right: 16rpx;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(232, 100, 51, 0.3);
}

.header-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 24rpx;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, transparent 100%);
}

.course-count {
  background: var(--primary-gradient);
  color: white;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--border-radius-xl);
  font-weight: 600;
  margin-left: auto;
  box-shadow: 0 2rpx 8rpx rgba(232, 100, 51, 0.3);
}

.selected-list {
  padding: 0 4rpx;
}

.selected-card {
  background: linear-gradient(135deg, var(--primary-light) 0%, #FFF9F6 100%);
  border-radius: var(--border-radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid rgba(24, 144, 255, 0.15);
  border-left: 6rpx solid var(--primary-color);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  transition: all 0.3s ease;
}

.selected-card:last-child {
  margin-bottom: 0;
}

.card-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.cancel-btn {
  background: var(--primary-color);
  color: white;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
  line-height: 1;
  transition: all 0.2s ease;
}

.cancel-btn:active {
  opacity: 0.75;
  transform: scale(0.95);
}

.cancel-btn-disabled {
  background: #C9CDD4 !important;
  color: #FFFFFF !important;
  pointer-events: none;
}

.info-item-inline {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-title {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.card-info {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-wrap: wrap;
  gap: 8rpx;
}

.card-info van-icon {
  margin-right: 6rpx;
  color: var(--primary-color);
  opacity: 0.8;
}

/* 筛选区域样式 - 吸顶 Sticky */
.filter-section {
  background: var(--bg-white);
  border-radius: var(--border-radius-lg);
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  position: sticky;
  top: 0;
  z-index: 100;
  border: 1rpx solid rgba(232, 100, 51, 0.08);
  transition: box-shadow 0.3s ease;
}

.filter-section:hover {
  box-shadow: var(--card-shadow-hover);
}

.filter-header {
  margin-bottom: 20rpx;
}

.filter-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.filter-title van-icon {
  color: var(--primary-color);
}

/* 搜索框样式 */
.search-box {
  margin-bottom: 24rpx;
  position: relative;
}

.search-box input {
  background: linear-gradient(135deg, #F7F8FA 0%, #FAFBFC 100%);
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 80rpx 0 72rpx;
  font-size: 28rpx;
  color: var(--text-main);
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-box input:focus {
  border-color: var(--primary-color);
  background: var(--bg-white);
  box-shadow: 0 0 0 4rpx rgba(232, 100, 51, 0.1), inset 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  position: absolute;
  left: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.6;
  transition: all 0.3s ease;
  pointer-events: none;
}

.search-box:focus-within .search-icon {
  opacity: 1;
  transform: translateY(-50%) scale(1.1);
}

.search-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E5E5E5;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.search-clear:active {
  background: #D5D5D5;
  transform: translateY(-50%) scale(0.92);
}

/* 已用 .search-icon 元素替换 ::before 伪元素 */



.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0;
}

.filter-tag {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: var(--border-radius-xl) !important;
  font-weight: 500;
  position: relative;
  overflow: hidden;
}

.filter-tag::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s ease;
}

.filter-tag:active::before {
  left: 100%;
}

/* 课程列表样式 */
.course-list {
  padding: 0;
}

.course-item {
  background: var(--bg-white);
  border-radius: var(--border-radius-lg);
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  position: relative;
  z-index: 1;
  border: 1rpx solid rgba(232, 100, 51, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.course-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.course-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--card-shadow-hover);
}

.course-item:hover::before {
  transform: scaleX(1);
}

.course-item.selected {
  border-color: var(--primary-color);
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg-white) 100%);
}

.course-item.selected::before {
  transform: scaleX(1);
}

.course-item.full {
  opacity: 0.7;
  filter: grayscale(0.3);
}

.course-status-indicator {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--success-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(82, 196, 26, 0.3);
  z-index: 2;
}

.course-status-indicator van-icon {
  color: white;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(232, 100, 51, 0.1);
  position: relative;
}

.course-header::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 60rpx;
  height: 2rpx;
  background: var(--primary-color);
}

.course-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  flex: 1;
  margin-right: 16rpx;
}

.course-code {
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #FFF9F6 100%);
  border-radius: var(--border-radius-xl);
  border: 1rpx solid rgba(232, 100, 51, 0.2);
  font-weight: 500;
  white-space: nowrap;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  flex: 1;
  min-width: 0;
  padding: 8rpx 12rpx;
  background: rgba(247, 248, 250, 0.8);
  border-radius: var(--border-radius-sm);
  transition: all 0.3s ease;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.info-content {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 8rpx;
}

.info-item:hover {
  background: rgba(232, 100, 51, 0.05);
  color: var(--text-main);
}

.info-item van-icon {
  margin-right: 8rpx;
  color: var(--primary-color);
  opacity: 0.8;
  flex-shrink: 0;
}

.course-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #FAFBFC 0%, #F7F8FA 100%);
  border-radius: var(--border-radius-md);
  border-left: 4rpx solid var(--primary-color);
  position: relative;
}

.course-desc::before {
  content: '"';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 32rpx;
  color: var(--primary-color);
  opacity: 0.3;
  font-family: serif;
}

.course-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(232, 100, 51, 0.1);
}

.course-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F5F5F5;
}

.capacity {
  font-size: 24rpx;
  color: #666;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

/* 空状态样式 */
.empty-container {
  margin-top: 100rpx;
  padding: 64rpx 48rpx;
  background: var(--bg-white);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  text-align: center;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.6s ease-out;
}

.empty-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.empty-icon {
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-icon van-icon {
  color: var(--primary-color);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 分类标签样式 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
}

.category-tag {
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.tag-active {
  background: #E86433 !important;
  color: #fff !important;
  border-color: #E86433 !important;
}

.tags-container {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.tag-item {
  margin-right: 0 !important;
  border-radius: var(--border-radius-md) !important;
  font-weight: 500 !important;
  box-shadow: 0 2rpx 8rpx rgba(255, 155, 78, 0.2) !important;
  transition: all 0.3s ease !important;
}

.tag-item:hover {
  transform: translateY(-2rpx) !important;
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 78, 0.3) !important;
}

.info-divider {
  margin: 0 12rpx;
  color: var(--text-light);
  font-weight: 300;
}

.info-tag {
  background: linear-gradient(135deg, var(--primary-light) 0%, #FFF9F6 100%);
  color: var(--primary-color);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--border-radius-sm);
  margin-left: 8rpx;
  font-weight: 500;
  border: 1rpx solid rgba(232, 100, 51, 0.2);
  transition: all 0.3s ease;
}

.info-tag:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.05);
}

/* 修改vant组件样式 */
.van-search {
  padding: 0 !important;
}

.van-search__content {
  background: var(--bg-gray) !important;
}

.van-tag--default {
  background: #fff !important;
  border-color: var(--border-color) !important;
  color: var(--text-secondary) !important;
}

.van-tag--primary {
  background: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
  color: #ffffff !important;
}

.van-tag--warning {
  background: var(--warning-color) !important;
  border-color: var(--warning-color) !important;
}

.van-button--primary {
  background: var(--primary-gradient) !important;
  border-color: var(--primary-color) !important;
  box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.3) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  font-weight: 600 !important;
}

.van-button--primary:hover {
  transform: translateY(-2rpx) !important;
  box-shadow: 0 6rpx 16rpx rgba(232, 100, 51, 0.4) !important;
}

.van-button--primary:active {
  transform: translateY(0) !important;
  box-shadow: 0 2rpx 8rpx rgba(232, 100, 51, 0.3) !important;
}

.van-button--default {
  border-color: var(--border-color) !important;
  color: var(--text-secondary) !important;
  background: var(--bg-white) !important;
  transition: all 0.3s ease !important;
}

.van-button--default:hover {
  border-color: var(--primary-color) !important;
  color: var(--primary-color) !important;
  background: var(--primary-light) !important;
}

.capacity-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 4rpx 8rpx;
  background: rgba(247, 248, 250, 0.8);
  border-radius: var(--border-radius-sm);
}

.capacity-info van-icon {
  color: var(--primary-color);
  opacity: 0.8;
}

.action-btn {
  display: flex !important;
  align-items: center !important;
  gap: 6rpx !important;
  font-weight: 600 !important;
}

.action-btn van-icon {
  margin-right: 0 !important;
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.course-item {
  animation: fadeInUp 0.6s ease-out;
}

.selected-card {
  animation: slideInLeft 0.5s ease-out;
}

.filter-tag:active {
  animation: pulse 0.3s ease;
}

/* 教师列表样式 */
.teacher-info {
  flex-direction: row !important;
  align-items: flex-start !important;
}

.teacher-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-left: 8rpx;
}

.teacher-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 0;
}

.teacher-item text {
  color: var(--text-main);
  font-size: 26rpx;
}

.teacher-item van-tag {
  background: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
  color: #ffffff !important;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .info-row {
    flex-direction: column;
    gap: 12rpx;
  }

  .course-footer {
    flex-direction: column;
    gap: 16rpx;
    align-items: stretch;
  }

  .tags-container {
    justify-content: center;
  }
}

/* 加载状态优化 */
.loading-skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 滚动条美化 */
::-webkit-scrollbar {
  width: 8rpx;
}

::-webkit-scrollbar-track {
  background: var(--bg-gray);
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb {
  background: var(--primary-color);
  border-radius: 4rpx;
  opacity: 0.6;
}

::-webkit-scrollbar-thumb:hover {
  opacity: 1;
}

/* 进度条样式 */
.progress-bar {
  width: 100%;
  height: 6rpx;
  background: var(--border-color);
  border-radius: 3rpx;
  overflow: hidden;
  margin-top: 8rpx;
}

.progress-fill {
  height: 100%;
  background: var(--primary-gradient);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* 浮动操作按钮 */
.floating-action {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(232, 100, 51, 0.4);
  z-index: 999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.floating-action:active {
  transform: scale(0.95);
}

.floating-action van-icon {
  color: white;
}

/* 优化触摸反馈 */
.course-item:active {
  transform: translateY(-2rpx) scale(0.98);
}



.filter-tag:active {
  transform: scale(0.95);
}

/* 状态提示 */
.status-tip {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--warning-color);
  border-radius: 50%;
  border: 2rpx solid white;
}

.course-item .button-group {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

.course-item .select-btn,
.course-item .cancel-btn {
  font-size: 22rpx;
  padding: 2px 10px;
  border-radius: 4px;
  min-width: 52px;
  text-align: center;
}

.course-item .select-btn {
  background-color: var(--primary-color);
  color: #fff;
}

.course-item .cancel-btn {
  background-color: #E86433;
  color: #fff;
}

.course-item .select-btn:active,
.course-item .cancel-btn:active {
  opacity: 0.8;
}

.course-item .select-btn.disabled {
  background-color: #ccc;
  color: #fff;
  opacity: 0.6;
}

/* ===== 返回顶部悬浮按钮（FAB）- 纯色 ===== */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary-color);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  transform: translateY(40rpx) scale(0.6);
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.back-to-top.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.back-to-top-hover {
  transform: scale(0.9);
  opacity: 0.85;
}

/* ===== 社团报名关闭 banner（页面内嵌，与页面同风格） ===== */
.club-signup-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE7BA;
  border-left: 6rpx solid #FA8C16;
  border-radius: var(--border-radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(250, 140, 22, 0.06);
  position: relative;
  z-index: 1;
}

.club-signup-banner-icon {
  flex-shrink: 0;
}

.club-signup-banner-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #874D00;
  word-break: break-all;
}