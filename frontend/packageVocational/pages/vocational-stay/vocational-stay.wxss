
@import "../../../components/vant-icon/index.wxss";

/* vi类: 直接用text渲染vant-icon字体unicode字符，绕过view+::before伪元素兼容性问题 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}
page { --primary-color: #1890FF; --primary-light: #E6F7FF; --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%); --text-primary: #262626; --text-secondary: #595959; --border-color: #F0F0F0; --bg-color: #FAFAFA; }
.container { min-height: 100vh; background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx); padding-top: 140rpx; padding-bottom: 40rpx; }
.page-header { padding: 32rpx 0 24rpx; background: rgba(255,255,255,0.95); backdrop-filter: blur(10rpx); position: fixed; top: 0; left: 0; right: 0; z-index: 1000; box-shadow: 0 2rpx 8rpx rgba(24,144,255,0.1); }
.header-content { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; }
.header-icon { width: 80rpx; height: 80rpx; background: var(--primary-gradient); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; }
.header-text { flex: 1; margin-left: 8rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.header-subtitle { font-size: 24rpx; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1rpx; }
.header-nav-action { width: 64rpx; height: 64rpx; background: rgba(24,144,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary-color); border: 2rpx solid rgba(24,144,255,0.2); }

.notice-bar { margin: 16rpx 24rpx; padding: 16rpx 20rpx; background: var(--primary-light); border-radius: 12rpx; }
.notice-bar.notice-warning { background: #FFFBE6; }
.notice-content { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--text-secondary); }
.apply-btn-wrapper { padding: 0 24rpx; margin-bottom: 16rpx; }

.list-section { padding: 0 24rpx; }
.section-title { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.record-count { font-size: 24rpx; color: var(--text-secondary); font-weight: 400; }
.empty-state { padding: 60rpx 0; }

.stay-list { display: flex; flex-direction: column; gap: 16rpx; }
.stay-item { background: white; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.stay-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.stay-status { font-size: 24rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius: 8rpx; }
.stay-status.status-0 { background: #E6F7FF; color: #1890FF; }
.stay-status.status-1 { background: #F6FFED; color: #52c41a; }
.stay-status.status-2 { background: #FFF1F0; color: #ff4d4f; }
.stay-status.status-3 { background: #F5F5F5; color: #999; }
.stay-status.status-4 { background: #F5F5F5; color: #999; }
.stay-content { margin-bottom: 12rpx; }
.stay-reason { font-size: 28rpx; color: var(--text-primary); margin-bottom: 8rpx; }
.stay-time { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--text-secondary); }
.stay-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 12rpx; border-top: 1rpx solid var(--border-color); }
.apply-time { font-size: 22rpx; color: #999; }

.form-popup { padding: 32rpx; overflow-y: auto; }
.form-title { font-size: 34rpx; font-weight: 700; color: #333; text-align: center; margin-bottom: 24rpx; }
.form-btn { padding: 32rpx 0 16rpx; }

.stay-remark { display: flex; align-items: flex-start; gap: 8rpx; font-size: 24rpx; color: #ff4d4f; margin-top: 8rpx; line-height: 1.5; }
.stay-approve-time { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #999; margin-top: 6rpx; }
