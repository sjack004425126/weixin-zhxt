/* 蓝色主题签名组件样式 */
.signature {
  width: 100%;
  height: 100%;
  background: white;
  border: 3rpx solid #1890FF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  position: relative;
  display: flex;
  flex-direction: column;
}

.signature::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  z-index: 1;
}

.canvas {
  width: 100%;
  height: 400rpx;
  background: white;
  border: none;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFF, #F0F8FF);
  border-top: 2rpx solid #F0F0F0;
  gap: 16rpx;
}

.btn {
  width: 30% !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: 40rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  transition: all 0.3s ease !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1) !important;
}

.btn:hover {
  transform: translateY(-2rpx) !important;
}

/* 清除和取消按钮 */
.clear-btn,
.cancel-btn {
  border: 2rpx solid #8C8C8C !important;
  color: #8C8C8C !important;
  background: white !important;
}

.clear-btn:hover,
.cancel-btn:hover {
  border-color: #FF4D4F !important;
  color: #FF4D4F !important;
  box-shadow: 0 6rpx 16rpx rgba(255, 77, 79, 0.2) !important;
}

/* 确认按钮 */
.confirm-btn {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%) !important;
  border: none !important;
  color: white !important;
}

.confirm-btn:hover {
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.3) !important;
}