/* 关键：引入 vant-icon 字体定义（INCIDENTS/001：text 直渲仍需 @font-face；subPackage 需 3 个 ../） */
@import "../../../components/vant-icon/index.wxss";

/* vi 类：直接用 text 渲染 vant-icon 字体的 unicode 字符（绕过 van-icon 组件 view+::before） */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

/* 蓝白主题（对齐 graduate-form） */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --border-radius: 16rpx;
}

.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0;
  background: rgba(255, 255, 255, 0.95);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.header-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 24rpx;
  padding-top: 160rpx;
}

.notice-bar {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
  border: 1rpx solid rgba(24, 144, 255, 0.3);
  box-shadow: var(--card-shadow);
}

.notice-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--primary-color);
}

.notice-content text {
  flex: 1;
  font-weight: 500;
}

.form {
  background: white;
  border-radius: var(--border-radius);
  padding: 32rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.form::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.form-group {
  margin-bottom: 32rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.form-group::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--primary-gradient);
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.tip {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 16rpx;
}

.btn-submit {
  margin-top: 8rpx;
}

.btn-submit .van-button {
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border-radius: 44rpx !important;
  background: var(--primary-gradient) !important;
  border: none !important;
  color: white !important;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3) !important;
}
