page {
  --primary-color: #E86433;
  --primary-light: #FFF6F2;
  --primary-gradient: linear-gradient(135deg, #E86433 0%, #FFB067 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --all-reg-color: #52c41a;
  --partial-color: #faad14;
  --none-reg-color: #ff4d4f;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-top: 140rpx;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(232, 100, 51, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(232, 100, 51, 0.3);
}

.header-text { flex: 1; margin-left: 8rpx; }

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(232, 100, 51, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  border: 2rpx solid rgba(232, 100, 51, 0.2);
}

/* 筛选栏 */
.filter-bar { background: white; padding: 16rpx; }

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #262626;
  height: 48rpx;
  line-height: 48rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: white;
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.stats-row { display: flex; align-items: center; justify-content: space-around; gap: 12rpx; }
.actions-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }

.stats-item { display: flex; align-items: center; gap: 8rpx; }
.stats-label { font-size: 26rpx; color: #666; }
.stats-value { font-size: 32rpx; font-weight: 600; color: #333; }
.stats-item.has-fail .stats-value { color: var(--primary-color); }
.stats-item.all-reg .stats-value { color: var(--all-reg-color); }
.stats-item.none-reg .stats-value { color: var(--none-reg-color); }

/* 学生卡片 - 固定4列 */
.list-content { padding: 0 16rpx; }

.student-wall {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.student-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 12rpx;
  padding: 20rpx 8rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.2s;
  border: 2rpx solid transparent;
  overflow: hidden;
  min-width: 0;
  box-sizing: border-box;
  cursor: pointer;
}

.student-card.status-all_registered { border-color: rgba(82, 196, 26, 0.3); }
.student-card.status-partial { border-color: rgba(250, 173, 20, 0.3); }
.student-card.status-none_registered { border-color: rgba(255, 77, 79, 0.3); }

.student-card:active { transform: scale(0.97); }

/* 状态角标 */
.card-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-all_registered { background: rgba(82, 196, 26, 0.15); color: var(--all-reg-color); }
.badge-partial { background: rgba(250, 173, 20, 0.15); color: var(--partial-color); }
.badge-none_registered { background: rgba(255, 77, 79, 0.15); color: var(--none-reg-color); }

/* 姓名 */
.card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
}

/* 科目数 */
.card-count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 4rpx;
}

/* 报考进度 */
.card-progress {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* 状态标签 */
.card-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.tag-all_registered {
  background: rgba(82, 196, 26, 0.12);
  color: var(--all-reg-color);
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.tag-partial {
  background: rgba(250, 173, 20, 0.12);
  color: var(--partial-color);
  border: 1rpx solid rgba(250, 173, 20, 0.3);
}

.tag-none_registered {
  background: rgba(255, 77, 79, 0.12);
  color: var(--none-reg-color);
  border: 1rpx solid rgba(255, 77, 79, 0.3);
}

/* 加载更多 */
.load-more { padding: 30rpx 0; text-align: center; }
.no-more { padding: 30rpx 0; text-align: center; font-size: 24rpx; color: #ccc; }
.empty-state { padding: 60rpx 0; }

/* 详情弹窗 */
.detail-popup { padding: 32rpx 24rpx; }

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  text-align: center;
}

.detail-list { max-height: 50vh; overflow-y: auto; }

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.detail-item:last-child { border-bottom: none; }

.detail-left { flex: 1; }

.detail-kcmc {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.detail-score {
  font-size: 24rpx;
  color: #999;
}

.detail-right {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.student-card.selected { border-color: #52c41a; background: #f6ffed; box-shadow: 0 0 0 4rpx rgba(82, 196, 26, 0.25), 0 4rpx 16rpx rgba(82, 196, 26, 0.3); }
.stats-item.selected-info .stats-value { color: #1890ff; }
.sms-trigger { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 20rpx; border-radius: 32rpx; background: linear-gradient(135deg, #E86433 0%, #FFB067 100%); color: white; font-size: 24rpx; font-weight: 500; box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.3); }

/* 全选/清空按钮 */
.select-actions { display: flex; gap: 8rpx; }
.select-btn { padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; color: #E86433; background: rgba(232, 100, 51, 0.08); border: 1rpx solid rgba(232, 100, 51, 0.2); }

.card-detail-link { position: absolute; bottom: 8rpx; right: 8rpx; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(24, 144, 255, 0.12); }
/* ========== 短信弹窗 ========== */
.sms-popup {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}

.sms-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.sms-header-icon {
  width: 80rpx; height: 80rpx;
  background: rgba(232, 100, 51, 0.08);
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.sms-header-info { flex: 1; }
.sms-title { font-size: 32rpx; font-weight: 700; color: #262626; margin-bottom: 6rpx; }
.sms-subtitle { font-size: 24rpx; color: #595959; }

.sms-input-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  min-height: 0;
}

.sms-input-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.sms-textarea {
  flex: 1;
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #262626;
  background: #fafafa;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.sms-textarea:focus {
  border-color: #E86433;
  background: white;
}

.sms-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 4rpx;
  flex-shrink: 0;
}

.sms-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.sms-count {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.sms-count.warn { color: #ff4d4f; font-weight: 600; }

.sms-preview-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  min-height: 0;
}

.sms-preview-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: #fff2f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.sms-preview-label { font-size: 24rpx; color: #ff4d4f; font-weight: 500; }

.sms-preview-box {
  flex: 1;
  padding: 24rpx;
  background: #fafafa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  min-height: 200rpx;
  line-height: 1.8;
  font-size: 30rpx;
  overflow-y: auto;
}

.hl-normal { color: #262626; }
.hl-banned {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.12);
  font-weight: 700;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  text-decoration: underline;
  text-decoration-style: wavy;
  text-underline-offset: 4rpx;
}

.banned-list-wrap { margin-top: 20rpx; flex-shrink: 0; }
.banned-list-title { font-size: 26rpx; font-weight: 600; color: #262626; margin-bottom: 16rpx; }

.banned-item {
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.banned-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banned-item-word {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.banned-action-toggle {
  display: flex;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  overflow: hidden;
}

.toggle-opt {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  color: #999;
  background: white;
  font-weight: 500;
  transition: all 0.2s;
}

.toggle-opt.active { background: linear-gradient(135deg, #E86433 0%, #FFB067 100%); color: white; }

.banned-replace-row { margin-top: 16rpx; }

.banned-replace-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.banned-replace-input:focus { border-color: #E86433; }

.sms-footer {
  flex-shrink: 0;
  padding-top: 24rpx;
}

.sms-btn-row { display: flex; gap: 16rpx; }
.sms-btn-half { flex: 1; }
