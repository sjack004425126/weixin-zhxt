page {
  --primary-color: #E86433;
  --primary-light: #FFF6F2;
  --primary-gradient: linear-gradient(135deg, #E86433 0%, #FFB067 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-top: 140rpx;
  padding-bottom: 40rpx;
}

.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(232, 100, 51, 0.1);
}

.header-content { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; }

.header-icon {
  width: 80rpx; height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(232, 100, 51, 0.3);
}

.header-text { flex: 1; margin-left: 8rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.header-subtitle { font-size: 24rpx; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1rpx; }

.header-nav-action {
  width: 64rpx; height: 64rpx;
  background: rgba(232, 100, 51, 0.1);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--primary-color);
  border: 2rpx solid rgba(232, 100, 51, 0.2);
}

.stats-bar {
  display: flex; flex-direction: column; gap: 16rpx;
  background: white; padding: 20rpx 24rpx; margin: 16rpx 24rpx;
  border-radius: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.stats-row { display: flex; align-items: center; justify-content: space-around; gap: 12rpx; }
.actions-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.stats-item { display: flex; align-items: center; gap: 8rpx; }
.stats-label { font-size: 26rpx; color: #666; }
.stats-value { font-size: 32rpx; font-weight: 600; color: #333; }
.stats-item.selected-info .stats-value { color: #1890ff; }

.sms-trigger {
  display: flex; align-items: center; gap: 6rpx;
  padding: 10rpx 20rpx; border-radius: 32rpx;
  background: var(--primary-gradient);
  color: white; font-size: 24rpx; font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(232, 100, 51, 0.3);
}

/* 全选/清空按钮 */
.select-actions { display: flex; gap: 8rpx; }
.select-btn { padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; color: #E86433; background: rgba(232, 100, 51, 0.08); border: 1rpx solid rgba(232, 100, 51, 0.2); }

.list-content { padding: 0 16rpx; }
.empty-state { padding: 60rpx 0; }

/* 班级卡片网格 */
.class-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.class-card {
  display: flex;
  flex-direction: column;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.2s;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
}

.class-card.selected {
  border-color: #52c41a;
  background: #f6ffed;
  box-shadow: 0 0 0 4rpx rgba(82, 196, 26, 0.25), 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
}

.class-card:active { transform: scale(0.97); }

/* 班级名称 */
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  padding-right: 48rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 学期 */
.card-xq {
  font-size: 22rpx;
  color: var(--primary-color);
  background: rgba(232, 100, 51, 0.08);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-bottom: 12rpx;
  align-self: flex-start;
}

/* 统计数据 */
.card-stats {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-label { font-size: 24rpx; color: #999; }
.stat-val { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.stat-val.grad { color: #52c41a; }
.stat-val.rate { color: var(--primary-color); }

/* 专业层次 */
.card-meta {
  font-size: 20rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}

/* ========== 短信弹窗 ========== */
.sms-popup {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}

/* 头部 */
.sms-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.sms-header-icon {
  width: 80rpx; height: 80rpx;
  background: rgba(232, 100, 51, 0.08);
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.sms-header-info { flex: 1; }
.sms-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 6rpx; }
.sms-subtitle { font-size: 24rpx; color: var(--text-secondary); }

/* 输入区域 */
.sms-input-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  min-height: 0;
}

.sms-input-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.sms-textarea {
  flex: 1;
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-primary);
  background: #fafafa;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.sms-textarea:focus {
  border-color: var(--primary-color);
  background: white;
}

.sms-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 4rpx;
  flex-shrink: 0;
}

.sms-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.sms-count {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.sms-count.warn { color: #ff4d4f; font-weight: 600; }

/* 高亮预览 */
.sms-preview-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  min-height: 0;
}

.sms-preview-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: #fff2f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.sms-preview-label { font-size: 24rpx; color: #ff4d4f; font-weight: 500; }

.sms-preview-box {
  flex: 1;
  padding: 24rpx;
  background: #fafafa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  min-height: 200rpx;
  line-height: 1.8;
  font-size: 30rpx;
  overflow-y: auto;
}

.hl-normal { color: var(--text-primary); }
.hl-banned {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.12);
  font-weight: 700;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  text-decoration: underline;
  text-decoration-style: wavy;
  text-underline-offset: 4rpx;
}

/* 违禁词处理列表 */
.banned-list-wrap { margin-top: 20rpx; flex-shrink: 0; }
.banned-list-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 16rpx; }

.banned-item {
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.banned-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banned-item-word {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.banned-action-toggle {
  display: flex;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  overflow: hidden;
}

.toggle-opt {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  color: #999;
  background: white;
  font-weight: 500;
  transition: all 0.2s;
}

.toggle-opt.active { background: var(--primary-gradient); color: white; }

.banned-replace-row { margin-top: 16rpx; }

.banned-replace-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.banned-replace-input:focus { border-color: var(--primary-color); }


/* 查看学生按钮 */
.card-student-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 10rpx 0;
  border-radius: 8rpx;
  background: rgba(232, 100, 51, 0.06);
  border: 1rpx solid rgba(232, 100, 51, 0.15);
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.card-student-btn:active {
  background: rgba(232, 100, 51, 0.12);
}
