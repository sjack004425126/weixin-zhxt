page { --primary-color: #EB2F96; --primary-light: #FFF0F6; --primary-gradient: linear-gradient(135deg, #EB2F96 0%, #F759AB 100%); --text-primary: #262626; --text-secondary: #595959; --border-color: #F0F0F0; --bg-color: #FAFAFA; }
.container { min-height: 100vh; background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx); padding-top: 140rpx; }
.page-header { padding: 32rpx 0 24rpx; background: rgba(255,255,255,0.95); backdrop-filter: blur(10rpx); position: fixed; top: 0; left: 0; right: 0; z-index: 1000; box-shadow: 0 2rpx 8rpx rgba(235,47,150,0.1); }
.header-content { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; }
.header-icon { width: 80rpx; height: 80rpx; background: var(--primary-gradient); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 4rpx 16rpx rgba(235,47,150,0.3); }
.header-text { flex: 1; margin-left: 8rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.header-subtitle { font-size: 24rpx; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1rpx; }
.header-nav-action { width: 64rpx; height: 64rpx; background: rgba(235,47,150,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary-color); border: 2rpx solid rgba(235,47,150,0.2); }
.filter-bar { background: white; padding: 16rpx; }
.list-content { padding: 24rpx; }
.empty-state { padding: 60rpx 0; }

/* 分组列表 */
.group-list { display: flex; flex-direction: column; gap: 0; }

/* 班级标题 */
.class-group { margin-bottom: 8rpx; }
.class-group-title {
  font-size: 28rpx; font-weight: 700; color: var(--text-primary);
  padding: 16rpx 0 12rpx;
  border-left: 6rpx solid var(--primary-color);
  padding-left: 16rpx;
  margin-bottom: 12rpx;
}

/* 照片墙 - 左对齐，每行2个 */
.photo-wall {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: flex-start;
}
.photo-item {
  width: calc(50% - 8rpx); display: flex; flex-direction: column; align-items: center;
  background: white; border-radius: 12rpx; padding: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); position: relative; margin-top: 20rpx;
  border: 2rpx solid var(--border-color);
  box-sizing: border-box;
}
.photo-index {
  position: absolute; top: 8rpx; left: 8rpx; width: 36rpx; height: 36rpx;
  border-radius: 50%; background: linear-gradient(135deg, #1da196 0%, #1da196 100%);
  color: white; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; z-index: 5;
}
.photo-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; overflow: hidden; background: #f5f5f5; }
.photo-avatar image { width: 100%; height: 100%; }
.avatar-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%); }
.photo-info { margin-top: 8rpx; width: 100%; text-align: center; }
.photo-name { font-size: 24rpx; font-weight: 500; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.photo-dorm { font-size: 18rpx; color: #52c41a; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.photo-dorm.none { color: #999; }

/* 留宿日期（已批准时展示，两行） */
.stay-date-wrap {
  width: 100%; margin-top: 4rpx; text-align: center;
}
.stay-date-line {
  display: block; font-size: 18rpx; color: #52c41a; line-height: 1.6;
}

/* 留宿状态按钮 */
.stay-btn {
  margin-top: 8rpx; padding: 4rpx 16rpx; border-radius: 8rpx;
  font-size: 20rpx; font-weight: 500; text-align: center;
}
.stay-btn-0 { background: #E6F7FF; color: #1890FF; border: 1rpx solid rgba(24,144,255,0.3); }
.stay-btn-1 { background: #F6FFED; color: #52c41a; border: 1rpx solid rgba(82,196,26,0.3); }
.stay-btn-2 { background: #FFF1F0; color: #ff4d4f; border: 1rpx solid rgba(255,77,79,0.3); }
.stay-btn-3 { background: #F5F5F5; color: #999; border: 1rpx solid #e8e8e8; }
.stay-btn-4 { background: #F5F5F5; color: #999; border: 1rpx solid #e8e8e8; }
.stay-btn-none { background: #fafafa; color: #ccc; border: 1rpx solid #e8e8e8; }

/* 详情弹窗 */
.detail-popup { padding: 32rpx; }
.detail-title { font-size: 32rpx; font-weight: 700; color: #333; text-align: center; margin-bottom: 24rpx; }
.detail-info { margin-bottom: 24rpx; }
.info-row { display: flex; align-items: flex-start; padding: 12rpx 0; border-bottom: 1rpx solid var(--border-color); }
.info-row:last-child { border-bottom: none; }
.info-label { width: 160rpx; font-size: 26rpx; color: #999; flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; color: #333; }
.stay-status-tag { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.stay-status-tag.status-0 { background: #E6F7FF; color: #1890FF; }
.stay-status-tag.status-1 { background: #F6FFED; color: #52c41a; }
.stay-status-tag.status-2 { background: #FFF1F0; color: #ff4d4f; }
.stay-status-tag.status-3 { background: #F5F5F5; color: #999; }
.stay-status-tag.status-4 { background: #F5F5F5; color: #999; }
.approve-section { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid var(--border-color); }
.approve-btns { display: flex; gap: 24rpx; justify-content: center; margin-top: 24rpx; }

/* 拨号按钮 */
.call-btn {
  margin-top: 8rpx; padding: 6rpx 0; width: 100%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(82, 196, 26, 0.08); border-radius: 8rpx;
  border: 1rpx solid rgba(82, 196, 26, 0.2);
}
.call-btn:active { background: rgba(82, 196, 26, 0.15); }
