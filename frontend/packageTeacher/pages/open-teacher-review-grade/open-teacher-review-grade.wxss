page {
  --primary: #1890FF;
  --primary-light: #E6F7FF;
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  --text-primary: #262626;
  --border: #F0F0F0;
  background: #f5f5f5;
}

/* ===== 固定顶部 ===== */
.grade-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* 题目切换行 */
.nav-row {
  display: flex; align-items: center;
  padding: 20rpx 16rpx; border-bottom: 1rpx solid var(--border);
}
.nav-btn {
  display: flex; align-items: center; gap: 4rpx;
  padding: 10rpx 18rpx; border-radius: 20rpx;
  font-size: 26rpx; color: var(--primary);
  background: var(--primary-light); flex-shrink: 0;
}
.nav-btn.disabled { color: #ccc; background: #f5f5f5; }
.nav-center { flex: 1; text-align: center; }
.nav-title { display: block; font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.nav-sub { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* 学生切换行（已删除，改为 stat-row） */
.stat-row {
  display: flex; align-items: center; gap: 10rpx;
  padding: 10rpx 24rpx; border-top: 1rpx solid var(--border);
}
.stat-progress { font-size: 24rpx; font-weight: 600; color: var(--text-primary); }
.stat-sep { font-size: 22rpx; color: #ccc; }
.stat-done { color: var(--success); font-weight: 600; font-size: 22rpx; }
.stat-pending { color: #999; font-size: 22rpx; }
.stat-pending.has { color: var(--danger); font-weight: 600; }
.pending-toggle {
  margin-left: auto; padding: 4rpx 14rpx; border-radius: 14rpx;
  font-size: 20rpx; color: #666; background: #f5f5f5; border: 1rpx solid #e8e8e8;
}
.pending-toggle.active { background: var(--primary-light); color: var(--primary); border-color: rgba(24,144,255,0.3); }

/* ===== 内容区 ===== */
.grade-body {
  padding-top: 110rpx; /* 顶部只剩一行 */
  padding-bottom: 160rpx;
  min-height: 100vh;
}
.empty-wrap { padding: 80rpx 0; }

/* 学生信息卡：学号 姓名 状态 分数 同一行 */
.student-card {
  display: flex; align-items: center;
  background: white; padding: 20rpx 24rpx;
  border-bottom: 3rpx solid var(--border);
  gap: 10rpx;
}
.sc-xh { font-size: 20rpx; color: #bbb; flex-shrink: 0; }
.sc-name { font-size: 30rpx; font-weight: 700; color: var(--text-primary); flex-shrink: 0; }
.sc-status-tag {
  padding: 3rpx 14rpx; border-radius: 20rpx; font-size: 20rpx; font-weight: 500; flex-shrink: 0;
}
.sc-status-tag.tag-scored { background: rgba(82,196,26,0.1); color: var(--success); }
.sc-status-tag.tag-unscored { background: rgba(250,173,20,0.1); color: var(--warning); }
.sc-score { font-size: 28rpx; font-weight: 700; margin-left: auto; padding: 4rpx 16rpx; border-radius: 12rpx; flex-shrink: 0; }
.sc-score.scored { color: var(--success); background: rgba(82,196,26,0.1); }
.sc-score.unscored { color: #ccc; }
.sc-max { font-size: 20rpx; font-weight: 400; color: #999; }

/* 答案内容 */
.answer-box {
  background: white; padding: 32rpx;
  margin: 16rpx 0; min-height: 200rpx;
}
.answer-text { font-size: 30rpx; color: var(--text-primary); line-height: 1.8; }

/* 评分区 */
.score-area {
  background: white; padding: 24rpx 32rpx;
  margin: 0 0 16rpx;
}
.locked-area {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 26rpx; color: var(--success);
}
/* 快捷分数多行 */
.qs-label { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.qs-grid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-bottom: 20rpx;
}
.qs-btn {
  min-width: 88rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 14rpx; font-size: 28rpx; font-weight: 600;
  background: var(--primary-light); color: var(--primary);
  border: 2rpx solid rgba(24,144,255,0.2); padding: 0 16rpx;
}
.qs-btn:active { opacity: 0.7; }
.qs-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

.custom-input-row {
  display: flex; align-items: center; gap: 12rpx;
  background: #f5f5f5; border-radius: 14rpx; padding: 10rpx 20rpx;
}
.custom-input {
  flex: 1; height: 72rpx; font-size: 36rpx; font-weight: 700;
  color: var(--text-primary); background: transparent;
}
.custom-max { font-size: 26rpx; color: #999; flex-shrink: 0; }
.confirm-btn {
  padding: 12rpx 32rpx; border-radius: 12rpx;
  background: var(--primary); color: white;
  font-size: 28rpx; font-weight: 600; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  min-width: 100rpx;
}
.confirm-btn:active { opacity: 0.8; }
.confirm-btn.loading { background: #91d5ff; }

/* 答题卡 */
.answer-card-wrap {
  background: white; margin: 16rpx 0; padding: 24rpx 32rpx;
}
.ac-title {
  font-size: 28rpx; font-weight: 600; color: var(--text-primary);
  margin-bottom: 20rpx; display: flex; justify-content: space-between;
}
.ac-close { color: #999; font-size: 36rpx; font-weight: 400; }
.ac-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ac-item {
  width: 88rpx; height: 88rpx; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 22rpx; border: 2rpx solid #e8e8e8;
}
.ac-item.done { background: rgba(82,196,26,0.1); border-color: rgba(82,196,26,0.3); }
.ac-item.todo { background: rgba(250,173,20,0.08); border-color: rgba(250,173,20,0.3); }
.ac-item.current { border-color: var(--primary); border-width: 3rpx; }
.ac-num { font-size: 24rpx; font-weight: 600; color: var(--text-primary); }
.ac-score { font-size: 20rpx; color: var(--success); }

/* ===== 底部工具栏 ===== */
.grade-footer {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: white; border-top: 1rpx solid var(--border);
  display: flex; align-items: center; justify-content: space-around;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
}
.footer-btn {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  font-size: 22rpx; color: var(--primary);
}
.footer-center {
  display: flex; align-items: center; justify-content: center;
}
.footer-progress { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }

/* ===== 答题卡遮罩弹出层 ===== */
.popup-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 200;
  display: flex; align-items: flex-end;
}
.popup-box {
  width: 100%; background: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 70vh; overflow-y: auto;
}
.popup-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}
.popup-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.popup-close { padding: 8rpx; color: #999; }

.ac-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ac-item {
  width: 96rpx; height: 96rpx; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 2rpx solid #e8e8e8;
}
.ac-item.done { background: rgba(82,196,26,0.1); border-color: rgba(82,196,26,0.3); }
.ac-item.todo { background: rgba(250,173,20,0.08); border-color: rgba(250,173,20,0.3); }
.ac-item.current { border-color: var(--primary); border-width: 3rpx; }
.ac-num { font-size: 24rpx; font-weight: 600; color: var(--text-primary); }
.ac-score-sm { font-size: 20rpx; color: var(--success); }
.ac-score-sm.todo-text { color: #ccc; }

/* ===== 查看题目弹出层 ===== */
.q-popup-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 12rpx; }
.q-popup-meta { font-size: 24rpx; color: #999; margin-bottom: 24rpx; }
.q-section-label { font-size: 24rpx; color: #999; margin-bottom: 10rpx; }
.q-tg-box {
  background: #fafafa; border-radius: 12rpx; padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--primary);
}
.q-da-box {
  background: rgba(82,196,26,0.06); border-radius: 12rpx; padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--success);
}
.q-empty { font-size: 26rpx; color: #999; }
.q-popup-tip {
  display: flex; align-items: center; gap: 8rpx;
  padding: 16rpx; background: #fffbe6; border-radius: 10rpx;
  font-size: 24rpx; color: var(--warning);
}
