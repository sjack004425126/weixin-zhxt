page {
  --primary-color: #1890FF;
  --text-primary: #262626;
  --text-secondary: #595959;
  --border-color: #F0F0F0;
  --bg-color: #F5F7FA;
  --success-color: #52c41a;
  --danger-color: #ff4d4f;
}

.container {
  min-height: 100vh;
  background: var(--bg-color);
}

/* 总览统计 */
.overview {
  display: flex;
  justify-content: space-around;
  background: white;
  padding: 32rpx 24rpx;
  margin-bottom: 4rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.overview-value.highlight { color: var(--primary-color); }

.overview-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 加载 */
.page-loading { padding: 80rpx 0; }
.empty-state { padding: 60rpx 0; }

/* 统计列表 */
.stat-list { padding: 16rpx 24rpx; }

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-card:active { background: #fafafa; }

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

/* 班级数字统计 */
.card-numbers {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border-color);
  border-bottom: 1rpx solid var(--border-color);
}

.num-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.num-item.selected .num-value { color: var(--success-color); }
.num-item.unselected .num-value { color: var(--danger-color); }

.num-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 进度条 */
.card-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  min-width: 100rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890FF, #69c0ff);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-fill.full {
  background: linear-gradient(90deg, #ff4d4f, #ff7875);
}

/* 详情弹窗 */
.detail-popup { padding: 32rpx 24rpx; }

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  text-align: center;
}

.detail-empty { padding: 40rpx 0; }

.detail-list {
  max-height: 55vh;
  overflow-y: auto;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.detail-item:last-child { border-bottom: none; }

.detail-left { flex: 1; }

.detail-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.detail-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.detail-right {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.detail-count {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0 8rpx;
}
