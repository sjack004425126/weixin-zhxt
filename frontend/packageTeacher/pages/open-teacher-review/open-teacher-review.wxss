page {
  --primary: #1890FF;
  --primary-light: #E6F7FF;
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  --text-primary: #262626;
  --text-secondary: #595959;
  --border: #F0F0F0;
  --bg: #FAFAFA;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg) 200rpx);
  padding-bottom: 40rpx;
}

/* 固定头部占位 */
.header-placeholder { height: 180rpx; }

/* 页面头部 */
.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10rpx);
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24,144,255,0.1);
}
.header-content { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; }
.header-icon { width: 80rpx; height: 80rpx; background: linear-gradient(135deg,#1890FF,#40A9FF); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.3); }
.header-text { flex: 1; margin-left: 8rpx; }
.header-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.header-subtitle { font-size: 24rpx; color: var(--text-secondary); }
.header-nav-action { width: 64rpx; height: 64rpx; background: rgba(24,144,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); border: 2rpx solid rgba(24,144,255,0.2); flex-shrink: 0; }

/* 空状态 */
.empty-state { padding: 80rpx 0; }

/* ===== 课程列表 ===== */
.course-list { padding: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.course-card {
  display: flex; align-items: center; gap: 20rpx;
  background: white; border-radius: 16rpx; padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.course-card:active { opacity: 0.85; }
.course-icon { flex-shrink: 0; }
.course-info { flex: 1; min-width: 0; }
.course-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.course-meta { font-size: 24rpx; color: #999; }
.course-badge { padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.course-badge.pending { background: rgba(255,77,79,0.1); color: var(--danger); }
.course-badge.done { background: rgba(82,196,26,0.1); color: var(--success); }

/* ===== 题目列表 ===== */
.question-list { padding: 24rpx; padding-top: 8rpx; display: flex; flex-direction: column; gap: 16rpx; }
.question-card {
  display: flex; align-items: center; gap: 16rpx;
  background: white; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.question-card:active { opacity: 0.85; }
.q-index { font-size: 28rpx; font-weight: 700; color: var(--primary); width: 110rpx; flex-shrink: 0; white-space: nowrap; }
.q-meta { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.q-fz { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.q-sep { color: #ccc; }
.q-total { font-size: 24rpx; color: #999; }
.q-progress { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.progress-bar { flex: 1; height: 8rpx; background: #f0f0f0; border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #1890FF, #40A9FF); border-radius: 4rpx; transition: width 0.3s; }
.progress-text { font-size: 22rpx; color: #999; flex-shrink: 0; }
.q-status { padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.q-status.pending { background: rgba(255,77,79,0.1); color: var(--danger); }
.q-status.done { background: rgba(82,196,26,0.1); color: var(--success); }

/* 评阅说明 */
.review-tip {
  display: flex; align-items: center; gap: 8rpx;
  padding: 16rpx 24rpx; background: var(--primary-light);
  font-size: 24rpx; color: var(--primary);
  margin: 0 24rpx;
  border-radius: 12rpx;
}
