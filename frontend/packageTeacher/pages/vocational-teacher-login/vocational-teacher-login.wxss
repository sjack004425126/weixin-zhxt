/* INCIDENTS/001: 修复 vant-icon 不显示问题 */
@import "../../../components/vant-icon/index.wxss";

.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

/* type-icon 内的图标样式 */
.type-icon .vi {
  color: #999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-icon.active .vi {
  color: currentColor;
  transform: scale(1.2);
}

/* 登录方式切换（openid / 手机号） */
.login-type {
  display: flex;
  justify-content: space-around;
  margin: 0 20rpx 60rpx;
  padding: 20rpx 0;
}

.type-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 100%);
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid rgba(24, 144, 255, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
}

.type-icon.active {
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.15) 0%, rgba(64, 169, 255, 0.15) 100%);
  border-color: #1890FF;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.2);
  transform: translateY(-4rpx);
}

/* 中等职业技术学校主题 - 蓝色科技风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 50%, #F5F9FF 100%);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 切换身份按钮 */
.switch-role-btn {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx 14rpx 14rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 52rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.12), 0 1rpx 4rpx rgba(24, 144, 255, 0.08);
  z-index: 10;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid rgba(24, 144, 255, 0.1);
  cursor: pointer;
}

.switch-role-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.15);
}

.switch-role-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1) 0%, rgba(64, 169, 255, 0.15) 100%);
  border-radius: 50%;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.switch-role-btn:active .switch-role-icon {
  transform: rotate(180deg);
}

.switch-role-btn text {
  font-size: 26rpx;
  color: #1890FF;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%231890FF' fill-opacity='0.04'%3E%3Cpath d='M20 20.5V18H18v2.5h-2.5V22H18v2.5h2V22h2.5v-1.5H20zM0 38.5V36h2.5v2.5H5V40H2.5v2.5H0V40h-2.5v-1.5H0zm0-40V-1.5h2.5V1H5v1.5H2.5V4H0V2.5h-2.5V1H0z'/%3E%3C/g%3E%3C/svg%3E") repeat;
  opacity: 0.3;
  z-index: 0;
}

.login-box {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 80rpx 40rpx 60rpx;
  box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(24, 144, 255, 0.1);
  position: relative;
  z-index: 1;
}

.login-box::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1890FF 0%, #40A9FF 50%, #1890FF 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  text-align: center;
  margin-bottom: 20rpx;
  position: relative;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.title:last-child {
  margin-bottom: 80rpx;
}

.school-badge {
  position: absolute;
  top: -20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.school-badge.vocational {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  color: white;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.login-form {
  margin-bottom: 40rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.quick-login-tip {
  text-align: center;
  color: #666;
  font-size: 28rpx;
  padding: 60rpx 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 快捷登录下方的补充说明（如"首次使用请先绑定微信"） */
.quick-login-note {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0 0;
  line-height: 1.6;
}

.login-form .van-button {
  margin-top: auto;
}

.agreement {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.agreement-text {
  margin-bottom: 10rpx;
}

.agreement-links {
  margin-top: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.link {
  color: #1890ff;
  display: inline;
}

.home-icon {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  z-index: 100;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.home-icon:active {
  opacity: 0.8;
}

/* van-button 样式覆盖 - 中职蓝色主题 */
.van-button {
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 12rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.3) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  position: relative !important;
  overflow: hidden !important;
}

.van-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.van-button:active::before {
  left: 100%;
}

.van-button:active {
  transform: translateY(2rpx) scale(0.98) !important;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3) !important;
}

/* 页面加载动画 */
.login-box {
  animation: slideInUp 0.6s ease-out;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 标题渐变动画 */
.title {
  animation: fadeInLeft 0.8s ease-out 0.2s both;
}

@keyframes fadeInLeft {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 学校标识动画 */
.school-badge {
  animation: bounceIn 0.8s ease-out 0.4s both;
}

@keyframes bounceIn {
  0% {
    opacity: 0;
    transform: scale(0.3);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
  70% {
    transform: scale(0.9);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 顶部装饰线动画 */
.login-box::before {
  animation: expandWidth 0.8s ease-out 0.2s both;
}

@keyframes expandWidth {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}

/* 切换身份按钮动画 */
.switch-role-btn {
  animation: switchBtnIn 0.6s ease-out 0.3s both;
}

@keyframes switchBtnIn {
  0% {
    opacity: 0;
    transform: translateX(-30rpx) scale(0.8);
  }
  60% {
    transform: translateX(6rpx) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.switch-role-icon {
  animation: iconPulse 3s ease-in-out 1.5s infinite;
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 登录表单动画 */
.login-form {
  animation: slideInRight 0.6s ease-out 0.9s both;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 协议区域动画 */
.agreement {
  animation: fadeInUp 0.6s ease-out 1s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
