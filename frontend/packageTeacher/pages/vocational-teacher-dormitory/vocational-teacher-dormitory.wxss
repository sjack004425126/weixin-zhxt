@import "../../../components/vant-icon/index.wxss";

/* vi 类：用于直接用 text 渲染 vant-icon 字体的 unicode 字符 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --border-radius: 16rpx;
  --green: #52c41a;
  --green-light: #f6ffed;
  --green-border: #b7eb8f;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-top: 140rpx;
}

/* 页面头部 */
.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}
.header-content { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; }
.header-icon {
  width: 80rpx; height: 80rpx; background: var(--primary-gradient);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: white; box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}
.header-text { flex: 1; margin-left: 8rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.header-subtitle { font-size: 24rpx; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1rpx; }
.header-nav-action {
  width: 64rpx; height: 64rpx; background: rgba(24, 144, 255, 0.1);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: var(--primary-color); border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.filter-bar { background: white; padding: 16rpx; }

/* 前端搜索栏 */
.search-bar {
  background: white;
  padding: 12rpx 24rpx;
  border-top: 2rpx solid var(--border-color);
}
.search-input-wrap {
  display: flex; align-items: center; gap: 8rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 20rpx;
  height: 64rpx;
}
.search-icon { flex-shrink: 0; }
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  background: transparent;
  height: 100%;
  min-height: 64rpx;
}
.search-clear {
  flex-shrink: 0;
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
}
.search-clear:active { background: rgba(0, 0, 0, 0.05); }

/* 统计栏 */
.stats-bar {
  display: flex; justify-content: space-around; background: white;
  padding: 20rpx 24rpx; margin: 16rpx 24rpx; border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.stats-item { display: flex; align-items: center; gap: 8rpx; }
.stats-label { font-size: 26rpx; color: #666; }
.stats-value { font-size: 32rpx; font-weight: 600; color: #333; }
.stats-item.has .stats-value { color: var(--green); }
.stats-item.no .stats-value { color: #ff4d4f; }

/* 性别图例 */
.gender-legend {
  display: flex; gap: 12rpx; padding: 0 24rpx 12rpx;
}
.legend-pill {
  display: flex; align-items: center; gap: 8rpx;
  padding: 6rpx 14rpx; border-radius: 20rpx;
  font-size: 22rpx; font-weight: 500;
}
.legend-male { background: rgba(24, 144, 255, 0.1); color: #1890ff; }
.legend-female { background: rgba(255, 105, 180, 0.12); color: #eb2f96; }
.legend-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
}
.legend-dot-male { background: #1890ff; }
.legend-dot-female { background: #eb2f96; }

.list-content { padding: 24rpx; }
.empty-state { padding: 60rpx 0; }

/* ========== 宿舍分组 ========== */
.group-list { display: flex; flex-direction: column; }
.room-group { margin-bottom: 8rpx; }
.room-group-title {
  font-size: 28rpx; font-weight: 700; color: var(--text-primary);
  padding: 16rpx 16rpx 12rpx;
  border-left: 6rpx solid var(--primary-color);
  padding-left: 16rpx;
  margin-bottom: 12rpx;
}

/* ========== 学生卡片墙 ========== */
.dorm-wall { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: flex-start; padding: 0 4rpx; }
.dorm-item {
  flex: 1 1 200rpx; max-width: 220rpx; min-width: 0;
  display: flex; flex-direction: column; align-items: center;
  background: white; border-radius: 12rpx; padding: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative; overflow: visible; margin-top: 20rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.dorm-item.has-dorm { border-color: var(--green); }
.dorm-item.no-dorm { border-color: #d9d9d9; }

/* 性别底色：男生蓝色系，女生粉色系（纯色，无渐变） */
.dorm-item.gender-male {
  background: #E6F4FF;
}
.dorm-item.gender-female {
  background: #FFF0F6;
}
.dorm-item.gender-male.has-dorm {
  background: #BAE0FF;
}
.dorm-item.gender-female.has-dorm {
  background: #FFD6E7;
}

.dorm-index {
  position: absolute; top: 8rpx; left: 8rpx; width: 40rpx; height: 40rpx;
  border-radius: 50%; background: var(--primary-gradient); color: white;
  font-size: 20rpx; font-weight: 700; display: flex; align-items: center;
  justify-content: center; box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.4); z-index: 5;
}
.edit-btn {
  position: absolute; top: 8rpx; right: 8rpx; width: 56rpx; height: 56rpx;
  border-radius: 50%; background: rgba(24, 144, 255, 0.1);
  display: flex; align-items: center; justify-content: center; z-index: 10;
}
.edit-btn:active { background: rgba(24, 144, 255, 0.2); }

/* 拨号按钮 */
.call-btn {
  position: absolute; bottom: 8rpx; right: 8rpx; width: 52rpx; height: 52rpx;
  border-radius: 50%; background: rgba(82, 196, 26, 0.1);
  display: flex; align-items: center; justify-content: center; z-index: 10;
}
.call-btn:active { background: rgba(82, 196, 26, 0.2); }
.dorm-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%; overflow: hidden;
  position: relative; background: #f5f5f5;
}
.avatar-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
}
.dorm-status-badge {
  position: absolute; bottom: 0; right: 0; width: 36rpx; height: 36rpx;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  border: 3rpx solid white;
}
.dorm-status-badge.status-yes { background: var(--green); color: white; }
.dorm-status-badge.status-no { background: #bfbfbf; color: white; }
.dorm-info { margin-top: 12rpx; width: 100%; text-align: center; }
.dorm-name {
  font-size: 24rpx; font-weight: 500; color: #333;
  display: flex; align-items: center; justify-content: center; gap: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dorm-detail { margin-top: 4rpx; display: flex; align-items: center; justify-content: center; gap: 4rpx; }
.dorm-location { font-size: 18rpx; color: var(--green); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.dorm-unassigned { font-size: 18rpx; color: #8c8c8c; }

/* 性别小标签 */
.gender-tag {
  display: inline-block;
  padding: 1rpx 6rpx;
  font-size: 16rpx;
  border-radius: 4rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.gender-tag.gender-tag-male {
  background: rgba(24, 144, 255, 0.15);
  color: #1890ff;
}
.gender-tag.gender-tag-female {
  background: rgba(255, 105, 180, 0.15);
  color: #eb2f96;
}

/* 房间组标题：宿舍号 + 人数 */
.room-group-title {
  display: flex; align-items: center; gap: 8rpx;
}
.room-group-count {
  font-size: 24rpx;
  color: #8c8c8c;
  font-weight: 400;
}

/* ========== 弹窗通用 ========== */
.popup-content { padding: 32rpx; height: 100%; overflow-y: auto; box-sizing: border-box; }
.popup-title { font-size: 34rpx; font-weight: 700; color: #333; text-align: center; margin-bottom: 24rpx; }
.current-dorm {
  display: flex; align-items: center; gap: 12rpx; background: var(--green-light);
  padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap;
}
.current-label { font-size: 26rpx; color: #666; }
.current-value { font-size: 26rpx; color: var(--green); font-weight: 500; flex: 1; }
.select-section { margin-bottom: 24rpx; }
.select-label { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.select-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.select-option {
  padding: 12rpx 28rpx; border-radius: 24rpx; background: #f5f5f5;
  font-size: 26rpx; color: #666; border: 2rpx solid transparent;
}
.select-option.active {
  background: var(--primary-light); color: var(--primary-color);
  border-color: var(--primary-color); font-weight: 500;
}
.popup-footer { padding: 24rpx 0; margin-top: 16rpx; }

/* ========== 宿舍走廊布局（弹窗内） ========== */
.corridor-layout {
  display: flex; gap: 0; align-items: stretch;
}
.corridor-side {
  flex: 1; display: flex; flex-direction: column; gap: 12rpx;
}
.corridor-center {
  width: 60rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 8rpx;
  padding: 0 4rpx;
}
.corridor-line { flex: 1; width: 4rpx; background: #d9d9d9; border-radius: 2rpx; }
.corridor-text {
  font-size: 20rpx; color: #999; writing-mode: vertical-lr;
  letter-spacing: 4rpx;
}

.room-cell {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 12rpx 8rpx; border-radius: 12rpx; background: #f5f7fa;
  border: 2rpx solid #e8e8e8; min-height: 100rpx; position: relative;
}
.room-cell.has-people { background: var(--primary-light); border-color: rgba(24, 144, 255, 0.3); }
.room-cell.empty-room { background: #fafafa; }
.room-cell.room-placeholder { background: #f9f9f9; border: 2rpx dashed #e8e8e8; min-height: 100rpx; }
.room-cell:active { transform: scale(0.95); }
.room-cell-idx {
  position: absolute; top: 4rpx; left: 6rpx; font-size: 18rpx;
  color: #bbb; font-weight: 500;
}
.room-cell-name { font-size: 26rpx; font-weight: 700; color: var(--text-primary); margin-top: 4rpx; }
.room-cell-count { font-size: 20rpx; color: var(--text-secondary); margin-top: 2rpx; }

.building-door {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 24rpx; padding: 0 40rpx;
}

/* ========== 床位纵向视图（弹窗内） ========== */
.bed-room-header {
  display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx;
}
.bed-room-back {
  display: flex; align-items: center; gap: 4rpx;
  font-size: 26rpx; color: var(--primary-color);
}
.bed-room-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); flex: 1; }

.bunk-header { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.bunk-col-title {
  flex: 1; text-align: center; font-size: 26rpx; font-weight: 600;
  color: var(--text-secondary); padding: 8rpx 0;
}

.bunk-rows { display: flex; flex-direction: column; gap: 16rpx; }
.bunk-row { display: flex; gap: 16rpx; }

/* 床位加载中 */
.bed-loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 80rpx 0;
  color: var(--text-secondary); font-size: 26rpx;
  gap: 16rpx;
}
.bed-loading-spinner {
  width: 40rpx; height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: bed-spin 0.8s linear infinite;
}
@keyframes bed-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.bed-card {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: flex-start; padding: 24rpx 16rpx 20rpx; border-radius: 16rpx;
  min-height: 300rpx; position: relative;
  overflow: visible;
}
.bed-card.free { background: var(--green-light); border: 2rpx solid var(--green-border); }
.bed-card.occupied { background: var(--green-light); border: 2rpx solid var(--green); }
.bed-card.placeholder { background: #f5f5f5; border: 2rpx dashed #d9d9d9; }
.bed-card.selected { border-color: var(--primary-color); box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.2); }

.bed-card-name {
  font-size: 28rpx; font-weight: 700;
  padding: 4rpx 14rpx;
  color: #ffffff;
  background: var(--green);
  border-radius: 10rpx;
  margin-top: 4rpx;
}
.bed-card-top {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.bed-card-status {
  font-size: 22rpx; color: var(--primary-color);
  margin-top: 8rpx;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.bed-card-status.has-student { color: var(--green); font-weight: 500; }
.bed-card-class {
  font-size: 20rpx; color: #999;
  margin-top: 4rpx;
  max-width: 100%;
  overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap;
}
.bed-phone-icon {
  display: inline-block;
  line-height: 1;
  padding: 4rpx 6rpx;
}

/* 入户门 */
.door-section {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 32rpx; padding: 0 40rpx;
}
.door-line { flex: 1; height: 4rpx; background: #999; border-radius: 2rpx; }
.door-label {
  font-size: 24rpx; color: #999; padding: 8rpx 24rpx;
  border: 2rpx solid #d9d9d9; border-radius: 8rpx; background: white;
}
