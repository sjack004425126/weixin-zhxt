@import "../../../components/vant-icon/index.wxss";

/* vi 类：用于直接用 text 渲染 vant-icon 字体的 unicode 字符 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}

page {
  --primary-color: #EB2F96;
  --primary-light: #FFF0F6;
  --primary-gradient: linear-gradient(135deg, #EB2F96 0%, #F759AB 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(235, 47, 150, 0.08);
  --border-radius: 16rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-top: 140rpx;
}

/* 页面头部样式 */
.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(235, 47, 150, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(235, 47, 150, 0.3);
}

.header-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(235, 47, 150, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  border: 2rpx solid rgba(235, 47, 150, 0.2);
}

/* 筛选栏 */
.filter-bar {
  background: white;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: white;
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #666;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.stats-item.has .stats-value {
  color: #52c41a;
}

.stats-item.no .stats-value {
  color: #ff4d4f;
}

/* 列表内容 */
.list-content {
  padding: 24rpx;
}

.empty-state {
  padding: 60rpx 0;
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.student-item {
  background: white;
  border-radius: var(--border-radius);
  padding: 20rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.student-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5F5F5;
  flex-shrink: 0;
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

.no-photo {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-disabled);
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.student-id {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.student-class {
  font-size: 22rpx;
  color: var(--text-disabled);
}

/* 照片墙样式 */
.photo-wall {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  padding: 0 16rpx;
}

.photo-item {
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 12rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s, box-shadow 0.2s;
  position: relative;
  overflow: visible;
  margin-top: 20rpx;
}

.photo-item:active {
  transform: scale(0.95);
}

.photo-item.has-photo {
  border: 2rpx solid #52c41a;
}

.photo-item.no-photo {
  border: 2rpx solid #ff4d4f;
}

/* 序号样式 */
.photo-index {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1da196 0%, #1da196 100%);
  color: white;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.4);
  z-index: 5;
}

/* 上传按钮 */
.upload-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
  z-index: 10;
  transition: all 0.3s ease;
}

.upload-btn:active {
  transform: scale(0.9);
}

.upload-btn.uploading {
  background: linear-gradient(135deg, #ffa726 0%, #fb8c00 100%);
  animation: pulse 1.5s ease-in-out infinite;
}

/* 上传中的旋转动画 */
.upload-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.8;
  }
}

.photo-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  background: #f5f5f5;
}

.photo-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
}

.photo-status-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid white;
}

.photo-status-badge.status-yes {
  background: #52c41a;
  color: white;
}

.photo-status-badge.status-no {
  background: #ff4d4f;
  color: white;
}

.photo-info {
  margin-top: 12rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.photo-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
}

.photo-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.photo-xjzt {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 500;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 学籍状态颜色 - 根据ID分配不同颜色 */
.photo-xjzt.xjzt-1 {
  background: rgba(82, 196, 26, 0.15);
  color: #52c41a;
  border: 1rpx solid rgba(82, 196, 26, 0.4);
}

.photo-xjzt.xjzt-2 {
  background: rgba(255, 152, 0, 0.15);
  color: #ff9800;
  border: 1rpx solid rgba(255, 152, 0, 0.4);
}

.photo-xjzt.xjzt-3 {
  background: rgba(255, 77, 79, 0.15);
  color: #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.4);
}

.photo-xjzt.xjzt-4 {
  background: rgba(156, 39, 176, 0.15);
  color: #9c27b0;
  border: 1rpx solid rgba(156, 39, 176, 0.4);
}

.photo-xjzt.xjzt-5 {
  background: rgba(33, 150, 243, 0.15);
  color: #2196f3;
  border: 1rpx solid rgba(33, 150, 243, 0.4);
}

.photo-xjzt.xjzt-6 {
  background: rgba(255, 193, 7, 0.15);
  color: #ffc107;
  border: 1rpx solid rgba(255, 193, 7, 0.4);
}

.photo-xjzt.xjzt-7 {
  background: rgba(96, 125, 139, 0.15);
  color: #607d8b;
  border: 1rpx solid rgba(96, 125, 139, 0.4);
}

.photo-xjzt.xjzt-8 {
  background: rgba(233, 30, 99, 0.15);
  color: #e91e63;
  border: 1rpx solid rgba(233, 30, 99, 0.4);
}

.photo-xjzt.xjzt-9 {
  background: rgba(0, 188, 212, 0.15);
  color: #00bcd4;
  border: 1rpx solid rgba(0, 188, 212, 0.4);
}

.photo-xjzt.xjzt-10 {
  background: rgba(76, 175, 80, 0.15);
  color: #4caf50;
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}

/* 默认颜色（未知状态） */
.photo-xjzt:not([class*="xjzt-"]) {
  background: rgba(189, 189, 189, 0.15);
  color: #bdbdbd;
  border: 1rpx solid rgba(189, 189, 189, 0.4);
}

/* ========== 处理中遮罩层 ========== */
.processing-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.processing-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
}

.processing-content {
  position: relative;
  z-index: 1;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
  animation: processingPop 0.3s ease-out;
}

@keyframes processingPop {
  from { opacity: 0; transform: scale(0.88); }
  to { opacity: 1; transform: scale(1); }
}

.processing-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EB2F96 0%, #F759AB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.processing-ring {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(235, 47, 150, 0.2);
  animation: processingPulse 1.4s ease-in-out infinite;
}

@keyframes processingPulse {
  0% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.18); opacity: 0; }
  100% { transform: scale(1); opacity: 0; }
}

.processing-icon {
  position: relative;
  z-index: 1;
  animation: processingBounce 1.2s ease-in-out infinite;
}

@keyframes processingBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.processing-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  text-align: center;
}

.processing-step {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 24rpx;
  text-align: center;
}

.processing-bar-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.processing-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.processing-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #EB2F96, #F759AB);
  border-radius: 4rpx;
  transition: width 0.6s ease;
}

.processing-percent {
  font-size: 24rpx;
  color: #8c8c8c;
  width: 72rpx;
  text-align: right;
  flex-shrink: 0;
}

.processing-tip {
  font-size: 24rpx;
  color: #8c8c8c;
  text-align: center;
  line-height: 1.5;
  min-height: 36rpx;
}
