page {
  --primary-color: #1E40AF;
  --primary-light: #EFF6FF;
  --primary-gradient: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  --pending-color: #f59e0b;
  --verified-color: #10b981;
  --modified-color: #ef4444;
}

.container {
  min-height: 100vh;
  background: #f4f6fb;
  padding: 140rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 头部 */
.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(30, 64, 175, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.3);
}

.header-text { flex: 1; margin-left: 8rpx; }

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #262626;
  margin-bottom: 4rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: #595959;
  letter-spacing: 1rpx;
}

.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(30, 64, 175, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  border: 2rpx solid rgba(30, 64, 175, 0.2);
}

/* 状态横幅 */
.status-banner {
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.status-banner.status-pending { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.status-banner.status-verified { background: linear-gradient(135deg, #059669, #10b981); }
.status-banner.status-modified { background: linear-gradient(135deg, #ef4444, #f87171); }

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-row .reset-btn {
  margin-left: auto;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
}

.status-row .reset-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.status-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
  margin-left: 44rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.title-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  background: rgba(239, 68, 68, 0.12);
  color: #ef4444;
  border-radius: 8rpx;
}

/* 修改项 diff */
.diff-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.diff-row:last-child { border-bottom: none; }

.diff-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e3a8a;
  margin-bottom: 12rpx;
}

.diff-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.diff-old, .diff-new {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.diff-old {
  background: #fef3c7;
  color: #b45309;
}

.diff-new {
  background: #d1fae5;
  color: #047857;
}

.diff-tag {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.tag-old { background: rgba(180, 83, 9, 0.18); }
.tag-new { background: rgba(4, 120, 87, 0.18); }

.diff-text {
  word-break: break-all;
  flex: 1;
}

.diff-arrow {
  flex-shrink: 0;
}

/* 无修改提示 */
.no-change-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #047857;
}

/* 完整对照 */
.kv-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  gap: 16rpx;
}

.kv-row:last-child { border-bottom: none; }

.kv-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #475569;
  width: 140rpx;
  flex-shrink: 0;
}

.kv-values {
  flex: 1;
  min-width: 0;
}

.kv-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #0f172a;
  padding: 6rpx 0;
  word-break: break-all;
}

.kv-line.changed .kv-prefix {
  background: #fee2e2;
  color: #b91c1c;
}

.kv-line.changed:nth-child(2) .kv-prefix {
  background: #d1fae5;
  color: #047857;
}

.kv-prefix {
  font-size: 18rpx;
  font-weight: 700;
  width: 36rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 4rpx;
  background: #f1f5f9;
  color: #64748b;
  flex-shrink: 0;
}

.kv-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 历史时间轴 */
.history-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  position: relative;
}

.history-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-modified { background: #ef4444; box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.18); }
.dot-verified { background: #10b981; box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.18); }

.history-body { flex: 1; min-width: 0; }

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.history-status {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.history-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.history-changes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.history-change-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: 1rpx solid rgba(239, 68, 68, 0.2);
}

/* 底部提示 */
.footer-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}