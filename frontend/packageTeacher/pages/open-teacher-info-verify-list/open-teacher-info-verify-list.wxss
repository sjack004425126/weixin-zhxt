page {
  --primary-color: #1E40AF;
  --primary-light: #EFF6FF;
  --primary-gradient: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.08);

  --pending-color: #f59e0b;
  --verified-color: #10b981;
  --modified-color: #ef4444;
  --norecord-color: #94a3b8;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-top: 140rpx;
  padding-bottom: 40rpx;
}

/* 页面头部（与 diploma 一致） */
.page-header {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(30, 64, 175, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.3);
}

.header-text { flex: 1; margin-left: 8rpx; }

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(30, 64, 175, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  border: 2rpx solid rgba(30, 64, 175, 0.2);
}

/* 筛选栏 */
.filter-bar { background: white; padding: 16rpx; }

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #262626;
  height: 48rpx;
  line-height: 48rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: white;
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-row { display: flex; align-items: center; justify-content: space-around; gap: 12rpx; }
.actions-row { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }

.stats-item { display: flex; align-items: center; gap: 8rpx; }
.stats-label { font-size: 26rpx; color: #666; }
.stats-value { font-size: 32rpx; font-weight: 600; color: #333; }
.stats-item.status-pending .stats-value { color: var(--pending-color); }
.stats-item.status-verified .stats-value { color: var(--verified-color); }
.stats-item.status-modified .stats-value { color: var(--modified-color); }

.export-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: var(--primary-gradient);
  color: white;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.3);
}

.export-btn:active { transform: scale(0.97); }

/* 学生墙 */
.student-wall {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.student-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 12rpx;
  padding: 20rpx 8rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.2s;
  border: 2rpx solid transparent;
  overflow: hidden;
  min-width: 0;
}

.student-card.status-pending { border-color: rgba(245, 158, 11, 0.3); }
.student-card.status-verified { border-color: rgba(16, 185, 129, 0.3); }
.student-card.status-modified { border-color: rgba(239, 68, 68, 0.4); }

.student-card.has-modification {
  border-color: #ef4444;
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 50%);
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.15);
}

.student-card:active { transform: scale(0.97); }

.card-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-pending { background: rgba(245, 158, 11, 0.15); color: var(--pending-color); }
.badge-verified { background: rgba(16, 185, 129, 0.15); color: var(--verified-color); }
.badge-modified { background: rgba(239, 68, 68, 0.18); color: var(--modified-color); }

.card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
}

.card-xh {
  font-size: 18rpx;
  color: #999;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
}

.card-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.tag-pending { background: rgba(245, 158, 11, 0.12); color: var(--pending-color); border: 1rpx solid rgba(245, 158, 11, 0.3); }
.tag-verified { background: rgba(16, 185, 129, 0.12); color: var(--verified-color); border: 1rpx solid rgba(16, 185, 129, 0.3); }
.tag-modified { background: rgba(239, 68, 68, 0.12); color: var(--modified-color); border: 1rpx solid rgba(239, 68, 68, 0.4); }

.mod-tag {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #ef4444;
  font-weight: 700;
  padding: 2rpx 10rpx;
  background: #fef2f2;
  border-radius: 6rpx;
  border: 1rpx solid #fecaca;
}

.card-time {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.load-more, .no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more text {
  font-size: 24rpx;
  color: #94a3b8;
  letter-spacing: 2rpx;
}

/* 重置按钮 */
.reset-btn {
  margin-top: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: 1rpx solid rgba(239, 68, 68, 0.25);
  border-radius: 8rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.reset-btn:active {
  background: rgba(239, 68, 68, 0.2);
}