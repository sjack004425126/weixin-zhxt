@import "../../../components/vant-icon/index.wxss";
/* vi 类：text 直渲 vant-icon 字体，图标不再依赖 ::before，避免错位重叠 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
  font-size: 32rpx;
  color: inherit;
}
/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

.exam-list-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 24rpx;
  padding-top: 120rpx;
}

/* 页面头部样式（fixed 顶栏：不能用负 margin，会把右按钮挤出屏幕） */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0;
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
}

/* 返回按钮 */
.back-button {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.back-button:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.1);
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  animation: pulse 2s infinite;
  flex-shrink: 0;
  line-height: 1;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.header-text {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  overflow: hidden;
  flex-shrink: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 头部操作按钮组：成绩 + 首页，两个独立圆按钮 */
.header-action-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 头部操作按钮 */
.header-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.header-action:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.1);
}

.exam-header {
  color: var(--text-secondary);
  font-size: 26rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
}
/* 考试列表样式 */
.exam-list {
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  padding: 0;
  border: 1rpx solid var(--border-color);
  overflow: hidden;
  position: relative;
}

.exam-list::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.exam-item {
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all 0.3s ease;
  background: white;
}

.exam-item:hover {
  background: var(--primary-light);
  transform: translateX(4rpx);
}

.exam-item:last-child {
  border-bottom: none;
}

.exam-item van-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--primary-color) !important;
  transition: all 0.3s ease;
}

.exam-item:hover van-icon {
  transform: translateY(-50%) translateX(4rpx);
}

.exam-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-right: 60rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exam-title::before {
  content: '📝';
  font-size: 24rpx;
}

.exam-info {
  color: var(--text-secondary);
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-right: 60rpx;
}

.exam-info text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  background: #FAFBFC;
  border-radius: 6rpx;
  font-weight: 500;
}

.exam-info text::before {
  font-size: 16rpx;
}

.exam-info text:nth-child(1)::before {
  content: '🎓';
}

.exam-info text:nth-child(2)::before {
  content: '💻';
}

.exam-info text:nth-child(3)::before {
  content: '👨‍🏫';
}

.empty-tip {
  text-align: center;
  color: var(--text-disabled);
  padding: 80rpx 0;
  font-size: 28rpx;
}


/* 移除旧的导航样式，已整合到头部 */

/* 考试提示样式 */
.exam-tip {
  display: flex;
  align-items: center;
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  gap: 16rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.exam-tip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--warning-color);
}

.exam-tip:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.exam-tip van-icon {
  color: var(--warning-color) !important;
}

.tip-text {
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
}

.tip-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

/* ============ 新版：exame 考试列表样式 ============ */

.exam-tabs {
  display: flex;
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.exam-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.2s;
}

.exam-tab.active {
  color: var(--primary-color);
  font-weight: 600;
}

.exam-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary-color);
}

.loading-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 80rpx 0;
  color: var(--text-secondary);
  font-size: 26rpx;
  gap: 16rpx;
}

.exam-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.exam-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.status-open {
  color: #52c41a;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.status-not_started {
  color: #faad14;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
}

.status-ended {
  color: #f5222d;
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
}

.exam-card-mid {
  margin-top: 12rpx;
}

.exam-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.exam-card-info {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 26rpx;
}

.info-label {
  color: var(--text-secondary);
}

.info-value {
  color: var(--text-primary);
  margin-left: 4rpx;
}

.exam-card-bottom {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.btn-start, .btn-resume {
  background: var(--primary-gradient);
  color: white;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.btn-disabled {
  background: #f5f5f5;
  color: #bfbfbf;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-disabled);
  font-size: 28rpx;
}