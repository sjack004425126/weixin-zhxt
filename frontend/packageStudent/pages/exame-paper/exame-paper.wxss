/* 在线考试答题页（中职 exame，与 mini-room 配色统一） */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --border-radius: 16rpx;
}
.loading-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 120rpx 0;
  color: var(--text-secondary);
  font-size: 26rpx;
  gap: 16rpx;
}
/* 顶部状态条 */
.exam-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.06);
}
.topbar-left { flex: 1; min-width: 0; padding-right: 16rpx; }
.topbar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.topbar-mid {
  background: var(--primary-light);
  color: var(--primary-color);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-family: monospace;
  font-weight: 700;
  font-size: 26rpx;
}
.topbar-progress { font-size: 26rpx; font-weight: 700; font-family: monospace; color: inherit; }
.topbar-right { flex-shrink: 0; margin-left: 16rpx; }
.topbar-time {
  font-size: 26rpx;
  font-weight: 800;
  font-family: monospace;
  color: var(--primary-color);
  background: var(--bg-color);
  border: 2rpx solid var(--border-color);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  min-width: 130rpx;
  display: inline-block;
  text-align: center;
}
/* 题目卡 */
.question-card {
  background: #fff;
  border-radius: var(--border-radius);
  margin: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  padding-bottom: 200rpx;
}
.q-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.q-type {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #BAE7FF;
}
.q-order { font-size: 26rpx; color: var(--text-secondary); }
.q-score {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--warning-color);
  font-family: monospace;
}
.q-content { font-size: 30rpx; font-weight: 600; color: var(--text-primary); line-height: 1.7; margin-bottom: 24rpx; white-space: pre-wrap; }
/* 选项 */
.q-option {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: var(--bg-color);
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.q-option:active { transform: scale(0.99); }
.option-selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.15);
}
.option-label {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-right: 18rpx;
  flex-shrink: 0;
}
.option-selected .option-label { background: var(--primary-color); border-color: var(--primary-color); color: #fff; }
.option-content { flex: 1; font-size: 28rpx; color: var(--text-primary); line-height: 1.6; padding-top: 4rpx; }
.option-selected .option-content { font-weight: 600; }
.option-mark { margin-left: auto; color: var(--success-color); font-weight: 900; font-size: 32rpx; }
.q-textarea {
  width: 100%;
  min-height: 240rpx;
  background: var(--bg-color);
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
/* 底部操作 */
.exam-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border-color);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 60;
}
.btn-nav {
  flex: 1;
  height: 84rpx;
  border-radius: 20rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.btn-card { background: var(--primary-light); color: var(--primary-color); border: 2rpx solid #BAE7FF; }
.btn-submit { background: var(--primary-gradient); color: #fff; box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25); }
/* 答题卡浮层 */
.answer-card-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.answer-card {
  width: 100%;
  background: #fff;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 24rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
}
.card-title { font-size: 32rpx; font-weight: 800; text-align: center; margin-bottom: 20rpx; }
.card-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16rpx; }
.card-cell {
  height: 76rpx;
  border-radius: 14rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  font-family: monospace;
}
.cell-answered { background: var(--primary-color); color: #fff; }
.cell-current { outline: 3rpx solid var(--warning-color); transform: scale(1.06); }
