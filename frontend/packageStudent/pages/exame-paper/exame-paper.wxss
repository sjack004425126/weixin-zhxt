/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

/* 考试头部样式 */
.exam-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: white;
  border-bottom: 2rpx solid var(--border-color);
  min-height: 88rpx;
  height: 88rpx;
  border-radius: var(--border-radius);
  margin: 0 24rpx 20rpx 24rpx;
  box-sizing: border-box;
  box-shadow: var(--card-shadow);
  position: relative;
  overflow: hidden;
}

.exam-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}
.back-btn {
  width: 48rpx;
  height: 48rpx;
}
.timer {
  font-size: 32rpx;
  color: #1890ff;
  font-weight: bold;
}
.more-btn {
  width: 48rpx;
  height: 48rpx;
}
.header-type,
.header-index {
  display: flex;
  align-items: center;
  height: 60rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.header-type::before {
  content: '📝';
  font-size: 24rpx;
  margin-right: 8rpx;
}

.header-index {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-bottom: 240rpx;
}

/* 题目容器样式 */
.question-container {
  background: white;
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.question-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.question-container:hover {
  box-shadow: var(--card-shadow-hover);
}

.question-title {
  font-size: 32rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 32rpx;
  font-weight: 600;
  padding: 20rpx;
  background: linear-gradient(135deg, #F8FAFF, #F0F8FF);
  border-radius: 12rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.1);
}

/* 选项容器样式 */
.options-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  background: white;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.option-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: transparent;
  transition: all 0.3s ease;
}

.option-item:hover {
  border-color: var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.1);
}

.option-item:hover::before {
  background: var(--primary-gradient);
}

.option-item.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.2);
}

.option-item.selected::before {
  background: var(--primary-gradient);
}

.option-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 20rpx;
  min-width: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: #FAFBFC;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.option-item.selected .option-label {
  background: var(--primary-color);
  color: white;
  border-color: var(--primary-color);
}

.option-content {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.5;
  font-weight: 500;
}

/* 题目导航按钮样式 */
.question-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 45%;
  height: 80rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.nav-btn.prev {
  background: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

.nav-btn.next {
  background: #1890ff;
  color: #fff;
}

.nav-btn[disabled] {
  background: #f5f5f5;
  color: #999;
  border: none;
}

.nav-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0 10rpx;
}

/* 考试底部工具栏样式 */
.exam-footer {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx solid var(--border-color);
  height: 140rpx;
  z-index: 10;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 12rpx rgba(24, 144, 255, 0.08);
}

.footer-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  height: 140rpx;
  border: none;
  background: transparent;
  transition: all 0.3s ease;
  position: relative;
}

.footer-btn:hover {
  background: var(--primary-light);
  color: var(--primary-color);
}

.footer-btn:active {
  transform: scale(0.95);
}

.footer-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.footer-btn:hover .footer-icon {
  transform: scale(1.1);
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  transition: all 0.3s ease;
}

.footer-btn:hover .footer-text {
  color: var(--primary-color);
  font-weight: 600;
}

.footer-timer {
  margin-left: auto;
  font-size: 32rpx;
  color: #1890ff;
  font-weight: bold;
  padding: 20rpx 0;
}

/* 答题卡弹窗样式 */
.answer-card-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.answer-card-popup {
  background: white;
  border-radius: var(--border-radius);
  width: 90vw;
  max-width: 700rpx;
  padding: 40rpx 32rpx 32rpx 32rpx;
  box-shadow: var(--card-shadow-hover);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.answer-card-popup::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.answer-card-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.answer-card-title::before {
  content: '📋';
  font-size: 28rpx;
}

.answer-card-group-title {
  font-size: 28rpx;
  color: var(--primary-color);
  margin: 24rpx 0 16rpx 0;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.answer-card-group-title::before {
  content: '📝';
  font-size: 20rpx;
}

.answer-card-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #FAFBFC;
  border-radius: 8rpx;
}

.answer-card-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: white;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: 2rpx solid var(--border-color);
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.answer-card-item:hover {
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.2);
}

.answer-card-item.answered {
  background: var(--secondary-color);
  color: white;
  border: 2rpx solid var(--secondary-color);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}

.answer-card-num {
  font-weight: 700;
}

/* 设置弹窗样式 */
.setting-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.setting-popup {
  background: white;
  border-radius: var(--border-radius);
  width: 70vw;
  max-width: 500rpx;
  padding: 40rpx 32rpx 32rpx 32rpx;
  box-shadow: var(--card-shadow-hover);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.setting-popup::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.setting-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.setting-title::before {
  content: '⚙️';
  font-size: 28rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
  background: #FAFBFC;
  border-radius: 8rpx;
  color: var(--text-primary);
  font-weight: 500;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.setting-row:hover {
  background: var(--primary-light);
}

/* 题目导航按钮样式 */
.question-nav-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 200rpx;
  background: transparent;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99;
  gap: 80rpx;
}

.circle-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: white;
  box-shadow: var(--card-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--primary-color);
  pointer-events: auto;
  margin: 0 10rpx;
  padding: 0;
  min-width: 0;
  transition: all 0.3s ease;
}

.circle-btn:hover {
  transform: scale(1.1);
  box-shadow: var(--card-shadow-hover);
}

.circle-btn[disabled] {
  background: #F5F5F5;
  border-color: var(--border-color);
  opacity: 0.6;
  transform: none;
}

.circle-icon {
  width: 56rpx;
  height: 56rpx;
}

.circle-icon-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: white;
  box-shadow: var(--card-shadow);
  margin: 0 40rpx;
  border: 3rpx solid var(--primary-color);
  object-fit: cover;
  transition: all 0.3s ease;
}

.circle-icon-img:hover {
  transform: scale(1.1);
  box-shadow: var(--card-shadow-hover);
}

.circle-icon-img.disabled {
  opacity: 0.4;
  filter: grayscale(1);
  transform: none;
  border-color: var(--border-color);
}

/* 主观题答题区域样式 */
.subjective-answer {
  margin-top: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFF, #F0F8FF);
  border-radius: 12rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.1);
}

.subjective-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: white;
  color: var(--text-primary);
  line-height: 1.5;
  transition: all 0.3s ease;
}

.subjective-textarea:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.1);
}

.exit-button {
  position: fixed;
  bottom: 20rpx;
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.exit-button image {
  width: 40rpx;
  height: 40rpx;
}

.paper-top-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx 0 20rpx;
  background: #fff;
  border-bottom: 2rpx solid #eee;
  border-top-left-radius: 12rpx;
  border-top-right-radius: 12rpx;
  margin-bottom: -2rpx;
}

.kc-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  letter-spacing: 1rpx;
}

.sj-type {
  font-size: 26rpx;
  color: #E86433;
  background: rgba(232,100,51,0.08);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  margin-left: 18rpx;
}

/* 试卷信息栏样式 */
.paper-info-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: var(--border-radius);
  padding: 20rpx 24rpx;
  margin: 0 24rpx 20rpx 24rpx;
  box-shadow: var(--card-shadow);
  font-size: 28rpx;
  color: var(--primary-color);
  gap: 12rpx;
  font-weight: 600;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.paper-info-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--primary-gradient);
}

.paper-info-text {
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.current-index {
  color: var(--primary-color);
  font-weight: 700;
  font-size: 32rpx;
  margin-right: 2rpx;
}