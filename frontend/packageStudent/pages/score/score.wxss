/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 24rpx;
}

/* 页面头部样式 */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0 -24rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.header-text {
  flex: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.score-tabs {
  width: 100%;
}

.score-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.course-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

.score-list {
  width: 100%;
}

/* 成绩卡片样式 */
.score-item {
  background: white;
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.score-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.score-item:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.course-id {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 成绩状态标签 */
.score-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  min-width: 80rpx;
  text-align: center;
}

.score-status.pass {
  color: var(--secondary-color);
  background: linear-gradient(135deg, #F6FFED, #F0F9E8);
  border: 1rpx solid rgba(82, 196, 26, 0.2);
}

.score-status.fail {
  color: var(--error-color);
  background: linear-gradient(135deg, #FFF2F0, #FFEBE8);
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

/* 成绩详情区域 */
.score-details {
  font-size: 28rpx;
}

.score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #FAFBFC;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.score-row:hover {
  background: var(--primary-light);
}

.score-row .label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--text-secondary);
  font-weight: 500;
  flex: 1;
}

.score-row .value {
  color: var(--text-primary);
  font-weight: 600;
  font-size: 30rpx;
  padding: 4rpx 12rpx;
  background: white;
  border-radius: 6rpx;
  min-width: 80rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(24, 144, 255, 0.05);
}

.score-row.total {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #F8FAFF, #F0F8FF);
  border: 1rpx solid rgba(24, 144, 255, 0.1);
}

.score-row.total .label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--primary-color);
  font-weight: 700;
}

.score-row.total .value {
  color: var(--primary-color);
  font-size: 36rpx;
  font-weight: 700;
  background: white;
  border: 2rpx solid var(--primary-color);
}

/* 成绩信息标签区域 */
.score-info {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #F8FAFF, #F0F8FF);
  border-radius: 12rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.1);
}

.info-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: white;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  min-height: 44rpx;
  line-height: 1.4;
  box-sizing: border-box;
  font-weight: 500;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.info-item:hover {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

/* 已申请复核状态 */
.info-item.review-status.applied {
  color: var(--secondary-color);
  background: linear-gradient(135deg, #F6FFED, #F0F9E8);
  border-color: rgba(82, 196, 26, 0.2);
}

/* 复核按钮区域 */
.review-btn {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

/* 自定义按钮样式 */
.review-btn .van-button {
  border-radius: 20rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.2) !important;
}

.review-btn .van-button--primary {
  background: var(--primary-gradient) !important;
  border: none !important;
}

.review-btn .van-button--danger {
  background: linear-gradient(135deg, #FF4D4F, #FF7875) !important;
  border: none !important;
}

/* 空状态样式 */
.empty-state {
  margin-top: 120rpx;
  text-align: center;
}

/* 加载状态 */
van-loading {
  display: flex;
  justify-content: center;
  margin-top: 200rpx;
}

.loading {
  margin: 60rpx auto;
  text-align: center;
}

.review-status {
  color: inherit;
  font-weight: normal;
}