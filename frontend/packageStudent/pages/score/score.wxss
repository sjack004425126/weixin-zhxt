@import "../../../components/vant-icon/index.wxss";
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --border-radius: 16rpx;
}
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 220rpx);
  padding: 24rpx;
  padding-bottom: 60rpx;
}
.loading-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16rpx;
  padding: 120rpx 0;
  color: var(--text-secondary);
  font-size: 26rpx;
}
van-loading {
  display: flex;
  justify-content: center;
}
/* 页面头部 */
.page-header {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6rpx;
  background: var(--primary-gradient);
}
.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.back-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(24, 144, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  flex-shrink: 0;
}
.header-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}
.header-text { flex: 1; min-width: 0; }
.header-title { font-size: 34rpx; font-weight: 800; color: var(--text-primary); }
.header-subtitle { font-size: 22rpx; color: var(--text-secondary); letter-spacing: 1rpx; text-transform: uppercase; margin-top: 4rpx; }
/* 列表 */
.score-list { display: flex; flex-direction: column; gap: 0; }
.score-item {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}
.score-item::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6rpx;
  background: var(--primary-gradient);
}
.score-row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.score-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}
.score-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.score-status.pass {
  color: var(--success-color);
  background: #F6FFED;
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}
.score-status.fail {
  color: var(--error-color);
  background: #FFF1F0;
  border: 1rpx solid rgba(255, 77, 79, 0.3);
}
.score-row-mid { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.score-value { font-size: 52rpx; font-weight: 800; font-family: monospace; }
.score-total { font-size: 26rpx; color: var(--text-disabled); margin-left: 6rpx; }
.score-row-bottom { display: flex; align-items: center; }
.score-time { font-size: 24rpx; color: var(--text-disabled); }
.empty-tip {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  box-shadow: var(--card-shadow);
}
/* 详情汇总卡 */
.score-summary {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  text-align: center;
}
.score-summary::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6rpx;
  background: var(--primary-gradient);
}
.summary-title { font-size: 32rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 16rpx; }
.summary-score-row { display: flex; align-items: baseline; justify-content: center; margin-bottom: 16rpx; }
.summary-score { font-size: 72rpx; font-weight: 800; font-family: monospace; }
.summary-total { font-size: 28rpx; color: var(--text-disabled); margin-left: 6rpx; }
.summary-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-wrap: wrap;
}
.summary-time { margin-top: 12rpx; font-size: 24rpx; color: var(--text-disabled); }
/* 详情题目列表 */
.questions-list { display: flex; flex-direction: column; }
.question-row {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
}
.q-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 16rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.q-type {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #BAE7FF;
}
.q-order { font-size: 24rpx; color: var(--text-secondary); }
.q-score { margin-left: auto; font-size: 24rpx; font-weight: 800; font-family: monospace; }
.q-content { font-size: 28rpx; color: var(--text-primary); line-height: 1.7; white-space: pre-wrap; margin-bottom: 12rpx; }
.q-analysis {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #FAFBFC;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  line-height: 1.6;
}
.q-answer { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; }
.q-answer .ans-label { color: var(--text-secondary); }
.q-answer-right { color: var(--success-color); font-weight: 700; }
.q-answer-wrong { color: var(--error-color); font-weight: 700; }
.q-answer-mine { color: var(--primary-color); font-weight: 700; }
.opt-line {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  background: var(--bg-color);
  line-height: 1.6;
}
.opt-line .opt-label { font-weight: 800; margin-right: 12rpx; color: var(--text-secondary); }
.opt-line .opt-content { flex: 1; color: var(--text-primary); }
.opt-line.opt-correct { background: #F6FFED; border: 1rpx solid rgba(82, 196, 26, 0.3); }
.opt-line.opt-correct .opt-label { color: var(--success-color); }
.opt-line.opt-wrong { background: #FFF1F0; border: 1rpx solid rgba(255, 77, 79, 0.3); }
.opt-line.opt-wrong .opt-label { color: var(--error-color); }
