.container {
  padding: 32rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 提示卡片 */
.notice-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.notice-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

.notice-content {
  font-size: 28rpx;
  color: #666;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.notice-item:last-child {
  margin-bottom: 0;
}

.dot {
  margin-right: 12rpx;
  color: #E86433;
}

/* 表单卡片 */
.form-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.verify-code-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.verify-code-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #E86433, #FFB067);
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 0;
  margin: 0;
}

.send-code-btn.disabled {
  background: #ccc;
}

/* 提交按钮 */
.button-wrap {
  padding: 32rpx 0;
}

.submit-button {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 44rpx !important;
  font-size: 32rpx !important;
} 