page {
  background: linear-gradient(180deg, #eef2ff 0%, #f5f7fb 200rpx, #f5f7fb 100%);
}

.container {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.form-container {
  padding: 24rpx;
}

/* 头部 */
.page-header {
  background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
  padding: 48rpx 32rpx 56rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
/* 刷新字典按钮：固定头部右上 */
.header-refresh {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 999rpx;
  z-index: 2;
}
.header-refresh-text {
  font-size: 22rpx;
  color: #1a56db;
  line-height: 1;
}
.page-header::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.page-header::after {
  content: '';
  position: absolute;
  bottom: -80rpx; left: -40rpx;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}
.header-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 40rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}
.header-badge-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  letter-spacing: 2rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.5;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}
.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}
/* 卡片 */
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
  margin-bottom: 16rpx;
}
.section-icon {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  background: #eef2ff;
  display: flex; align-items: center; justify-content: center;
}
.section-title { font-size: 30rpx; font-weight: 600; color: #111827; }
.section-desc { font-size: 22rpx; color: #6b7280; margin-top: 4rpx; }

.form-body { padding-top: 8rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.label-text { font-size: 26rpx; color: #374151; font-weight: 500; }
.required-mark { color: #ef4444; margin-left: 6rpx; font-weight: 600; }

.form-input, .form-textarea {
  width: 100%;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  transition: all 0.2s;
  text-align: left;
}
.form-input-placeholder { color: #9ca3af; text-align: left; }
.form-input { height: 88rpx; }
.form-textarea { min-height: 160rpx; line-height: 40rpx; }
.form-input.focused {
  border-color: #1a56db;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(26,86,219,0.08);
}

/* picker / 选择类 */
.picker-content {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  min-height: 88rpx;
  line-height: 44rpx;
  font-size: 28rpx;
  color: #9ca3af;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.picker-content.selected {
  color: #111827;
  background: #fff;
  border-color: #1a56db;
}

/* 上传（卡片式，参考 three-plus-four-register） */
.upload-box {
  position: relative;
  width: 100%;
  height: 360rpx;
  border: 2rpx dashed #d0d5dd;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fafbfc;
}
.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.upload-placeholder-text { font-size: 26rpx; color: #9ca3af; }
.upload-preview { width: 100%; height: 100%; display: block; }
.upload-redo {
  position: absolute;
  top: 12rpx; right: 12rpx;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
.upload-redo:active { background: rgba(0,0,0,0.7); }
.upload-delete {
  position: absolute;
  top: 12rpx; left: 12rpx;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(220,38,38,0.7);
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
.upload-delete:active { background: rgba(220,38,38,0.9); }

/* 提交区 */
.submit-section { padding: 24rpx 0; }
.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  color: #fff;
}
.submit-btn.active {
  background: linear-gradient(135deg, #1a56db 0%, #4338ca 100%);
  box-shadow: 0 8rpx 24rpx rgba(26,86,219,0.3);
}
.submit-btn.disabled {
  background: #cbd5e1;
  color: #fff;
}
.submit-hint {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 16rpx;
}

/* 弹窗 */
.popup-wrap { display: flex; flex-direction: column; height: 100%; }
.popup-header {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f1f5f9;
}
.popup-title { font-size: 32rpx; font-weight: 600; color: #111827; }

.search-section { padding: 16rpx 24rpx; }
.search-box {
  background: #f3f4f6;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-input { flex: 1; font-size: 28rpx; }

.popup-list {
  flex: 1;
  min-height: 0; /* 重要：flex 子项需 min-height:0 才会产生滚动区，否则 scroll-view 会被内容撜大导致 scrolltolower 不触发 */
  padding: 8rpx 24rpx 32rpx;
  box-sizing: border-box;
}
.list-truncate-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  padding: 16rpx 0 8rpx;
}

.student-item {
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f9fafb;
  margin-bottom: 12rpx;
}
.student-name { font-size: 30rpx; color: #111827; font-weight: 500; }
.student-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #e5e7eb;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  font-weight: normal;
}
.student-meta { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }

.dict-item {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 28rpx;
  color: #111827;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dict-item.active { color: #1a56db; font-weight: 600; }
.dict-item-meta { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }

.province-header {
  padding: 16rpx 20rpx 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
  background: #f9fafb;
  border-radius: 8rpx;
  margin-top: 16rpx;
  position: sticky;
  top: 0;
  z-index: 1;
}

.custom-input-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
  align-items: center;
}
.custom-input-bar .form-input { flex: 1; }
.custom-input-bar .custom-confirm-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  background: #1a56db;
  color: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
  white-space: nowrap;
}
.custom-tip {
  font-size: 22rpx;
  color: #9ca3af;
  padding: 0 24rpx 12rpx;
}

.empty-state { padding: 80rpx 0; }

/* 确认本人 卡片 */
.confirm-card {
  margin: 24rpx;
  padding: 24rpx 28rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
}
.confirm-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef0f3;
  font-size: 28rpx;
}
.confirm-row:last-child { border-bottom: none; }
.confirm-label {
  width: 140rpx;
  color: #6b7280;
  flex-shrink: 0;
}
.confirm-value {
  flex: 1;
  color: #111827;
  font-weight: 500;
  word-break: break-all;
}
.confirm-actions {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 24rpx 32rpx;
}
.confirm-actions .btn-secondary,
.confirm-actions .btn-primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
}
.confirm-actions .btn-secondary {
  background: #f3f4f6;
  color: #374151;
  border: 1rpx solid #e5e7eb;
}
.confirm-actions .btn-primary {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
}

/* ==================== 提交成功弹窗 ==================== */
.success-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.success-modal-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-modal-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.success-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 12rpx;
}

.success-modal-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.success-modal-code-section {
  width: 100%;
  background: #f0f7ff;
  border: 1rpx solid #bae0ff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.success-modal-code-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.success-modal-code-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a56db;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.success-modal-code-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}

.success-modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.success-modal-copy-btn {
  width: 100%;
  height: 80rpx;
  background: #1a56db;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-modal-close-btn {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
