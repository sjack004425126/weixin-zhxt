/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  background: white;
  border-radius: var(--border-radius);
  margin: 24rpx;
  box-shadow: var(--card-shadow);
}

/* 免费价格样式 */
.free-price {
  color: var(--secondary-color) !important;
  font-weight: 600;
}

/* 课程ID样式 */
.course-id {
  font-size: 22rpx;
  color: var(--text-disabled);
  margin-top: 8rpx;
}
/* 头部操作按钮 */
.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.header-nav-action:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.1);
}
/* 页面头部导航样式 */
.page-header-nav {
  padding: 32rpx 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-nav-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  position: relative;
}

.header-nav-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.header-nav-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-nav-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 头部操作按钮 */
.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.header-nav-action:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.1);
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding-bottom: 180rpx;
  padding-top: 160rpx;
}

.header {
  background: white;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.title {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-text::before {
  content: '📋';
  font-size: 28rpx;
}

.title-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.courses-list {
  background: transparent;
  margin: 0 8rpx 24rpx;
  padding: 16rpx 0;
}

.course-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin: 16rpx;
  border-radius: 12rpx;
  background: white;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.05);
}

.course-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--primary-gradient);
  border-radius: 2rpx 0 0 2rpx;
}

.course-item:hover {
  background: var(--primary-light);
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
}

.course-item:last-child {
  margin-bottom: 16rpx;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.course-name-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.course-icon {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.3);
  position: relative;
  overflow: hidden;
}

.course-icon::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.3) 50%, transparent 70%);
  animation: icon-rotate 3s linear infinite;
}

@keyframes icon-rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.course-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  flex: 1;
}

.course-type {
  font-size: 22rpx;
  color: var(--primary-color);
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, var(--primary-light), #F0F8FF);
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.3);
  align-self: flex-start;
  font-weight: 600;
  position: relative;
  overflow: hidden;
}

.course-type::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.3) 50%, transparent 70%);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.course-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.course-price {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 700;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, var(--primary-light), #F0F8FF);
  border-radius: 16rpx;
  border: 2rpx solid rgba(24, 144, 255, 0.3);
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.course-price::before {
  content: '¥';
  position: absolute;
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: var(--primary-color);
  opacity: 0.6;
}

.course-price::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.2) 50%, transparent 70%);
  animation: price-shimmer 3s infinite;
}

@keyframes price-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.delete-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 77, 79, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 77, 79, 0.2);
  position: relative;
  overflow: hidden;
}

.delete-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,77,79,0.1) 0%, transparent 70%);
  transform: scale(0);
  transition: transform 0.3s ease;
}

.delete-btn:hover::before {
  transform: scale(1);
}

.delete-btn:hover {
  background: var(--error-color);
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.delete-btn:hover van-icon {
  color: white !important;
}

.delete-btn:active {
  transform: scale(0.95);
}

.empty {
  margin-top: 100rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(24, 144, 255, 0.1);
  border-top: 1rpx solid var(--border-color);
}

.total-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: var(--primary-light);
  border-radius: 12rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}

.total-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.total-label::before {
  content: '📊';
  font-size: 20rpx;
}

.total-price {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 700;
  padding: 8rpx 16rpx;
  background: white;
  border-radius: 12rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}

.action-buttons {
  display: flex;
  gap: 24rpx;
}

.action-buttons .van-button {
  flex: 1;
  height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  transition: all 0.3s ease !important;
  border-radius: 44rpx !important;
}

.cancel-btn {
  color: var(--text-secondary) !important;
  border-color: var(--border-color) !important;
  background: white !important;
  border-width: 2rpx !important;
}

.cancel-btn:hover {
  border-color: var(--primary-color) !important;
  color: var(--primary-color) !important;
  transform: translateY(-2rpx) !important;
}

.cancel-btn:active {
  transform: scale(0.98) !important;
}

.confirm-btn {
  color: white !important;
  border: none !important;
  background: var(--primary-gradient) !important;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3) !important;
}

.confirm-btn:hover {
  transform: translateY(-2rpx) !important;
  box-shadow: 0 12rpx 32rpx rgba(24, 144, 255, 0.4) !important;
}

.confirm-btn:active {
  transform: scale(0.98) !important;
}