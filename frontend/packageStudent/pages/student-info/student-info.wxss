
@import "../../../components/vant-icon/index.wxss";

/* vi类: 直接用text渲染vant-icon字体unicode字符，绕过view+::before伪元素兼容性问题 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}
/* ========================================================================
 * 中职迎新查询页面 - 样式表
 * 设计语言: 与 vocational-new-payment 一致的 Enterprise Gateway
 * 配色: B2B Service 金融专业 (Navy / Sky / Emerald)
 * ======================================================================== */

page {
  --color-navy: #1890FF;
  --color-slate: #40A9FF;
  --color-sky: #1890FF;
  --color-sky-bg: #E6F7FF;
  --color-emerald: #059669;
  --color-emerald-bg: #ECFDF5;
  --color-amber: #FAAD14;
  --color-amber-bg: #FFFBEB;

  --color-text: #262626;
  --color-text-secondary: #595959;
  --color-text-muted: #8C8C8C;
  --color-border: #F0F0F0;
  --color-border-light: #F5F5F5;
  --color-bg: #FAFAFA;
  --color-card: #FFFFFF;

  --elev-1: 0 2rpx 8rpx rgba(24, 144, 255, 0.06);
  --elev-2: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --elev-3: 0 10rpx 20rpx rgba(24, 144, 255, 0.10), 0 4rpx 8rpx rgba(24, 144, 255, 0.06);

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
}

.page-root {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-sky-bg) 0%, var(--color-bg) 280rpx);
  padding: 0 28rpx 80rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
}

/* =========================== 顶部头部 =========================== */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0 -28rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 32rpx;
}

.header-badge {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  flex-shrink: 0;
}

.header-text {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.header-subtitle {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* =========================== 查询卡片 =========================== */
.query-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  box-shadow: var(--elev-3);
  border: 1rpx solid var(--color-border);
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card-intro {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--color-border);
  margin-bottom: 0;
}

.card-intro-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--color-sky-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-intro-text {
  flex: 1;
  min-width: 0;
}

.card-intro-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1.3;
}

.card-intro-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 手机号验证区 */
.phone-verify-section {
  background: linear-gradient(135deg, var(--color-emerald-bg) 0%, #F0FDF4 100%);
  border-radius: var(--radius-md);
  padding: 24rpx;
  border: 2rpx dashed var(--color-emerald);
  position: relative;
}

.phone-verify-header {
  margin-bottom: 20rpx;
}

.phone-verify-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-emerald);
}

.phone-verify-tip-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  margin-left: 32rpx;
  line-height: 1.5;
}

.phone-btn {
  height: 88rpx;
  background: #fff;
  color: var(--color-emerald);
  border: 2rpx solid var(--color-emerald);
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  padding: 0;
  cursor: pointer;
}

.phone-btn.verified {
  background: var(--color-emerald);
  color: #fff;
  border-color: var(--color-emerald);
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.25);
}

.phone-btn::after {
  border: none;
}

.phone-btn-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.verified-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.reverify {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: underline;
  margin-left: 8rpx;
}

/* 主按钮 */
.primary-btn {
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-sky) 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.18);
  transition: all 0.2s ease;
  border: none;
  cursor: pointer;
}

.primary-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.18);
}

.primary-btn.btn-disabled {
  background: linear-gradient(135deg, #94A3B8 0%, #CBD5E1 100%);
  box-shadow: none;
  color: #fff;
  opacity: 0.85;
}

.primary-btn::after {
  border: none;
}

/* 信任条 */
.trust-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 28rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.trust-sep {
  width: 1rpx;
  height: 28rpx;
  background: var(--color-border);
}

/* =========================== 使用说明 =========================== */
.help-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: var(--elev-2);
  border: 1rpx solid var(--color-border);
}

.help-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-navy);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.help-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.help-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.help-number {
  width: 40rpx;
  height: 40rpx;
  background: var(--color-sky);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.help-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* =========================== 结果卡片 =========================== */
.result-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--elev-2);
  border: 1rpx solid var(--color-border);
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.card-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-navy);
}

.section-title-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  background: var(--color-sky-bg);
  color: var(--color-sky);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: var(--color-emerald-bg);
  color: var(--color-emerald);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.enrollment-badge {
  background: var(--color-amber-bg);
  color: var(--color-amber);
}

/* =========================== 学生卡片 =========================== */
.student-section {
  background: linear-gradient(135deg, #E6F7FF 0%, #F0F8FF 100%);
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.student-card-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  padding: 24rpx;
  border-radius: var(--radius-md);
}

.student-avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: white;
}

.student-details {
  flex: 1;
  min-width: 0;
}

.student-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.student-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.student-no,
.student-id {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  align-self: flex-start;
  word-break: break-all;
}

.student-no {
  color: var(--color-navy);
  background: rgba(24, 144, 255, 0.1);
  font-weight: 600;
}

/* =========================== 班级卡片 =========================== */
.class-section {
  background: linear-gradient(135deg, #F6FFED 0%, #F0F9FF 100%);
  border: 2rpx solid rgba(82, 196, 26, 0.2);
}

.class-info-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  padding: 24rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(82, 196, 26, 0.1);
}

.class-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #F6FFED 0%, #D9F7BE 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(82, 196, 26, 0.3);
  flex-shrink: 0;
}

.class-details {
  flex: 1;
  min-width: 0;
}

.class-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #52C41A;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.class-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* =========================== 教室寝室信息 =========================== */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-sm);
  margin-top: 16rpx;
  border: 1rpx solid var(--color-border-light);
}

.info-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 600;
}

.info-value.no-value {
  color: #FF4D4F;
  font-size: 24rpx;
  font-weight: 400;
}

.info-row.no-dorm {
  background: rgba(255, 77, 79, 0.05);
  border-color: rgba(255, 77, 79, 0.2);
}

/* =========================== 寝室示意图 =========================== */
.dorm-section {
  background: linear-gradient(135deg, #F0F7FF 0%, #E6F4FF 100%);
  border: 2rpx solid rgba(91, 143, 249, 0.25);
}

.dorm-title-icon {
  background: linear-gradient(135deg, #5B8FF9 0%, #4A7FE0 100%);
}

.dorm-badge {
  background: rgba(91, 143, 249, 0.12);
  color: #5B8FF9;
  border: 1rpx solid rgba(91, 143, 249, 0.3);
}

.dorm-floor-plan {
  padding: 24rpx 0 0;
}

.dorm-room-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2C5282;
  margin-bottom: 24rpx;
  padding: 18rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F0F7FF 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(91, 143, 249, 0.2);
  flex-wrap: wrap;
}

/* 寝室内床位号标签 */
.bed-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #FFD666 0%, #FAAD14 100%);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(250, 173, 20, 0.3);
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.bed-tag text {
  color: #fff;
}

/* 寝室类型标签（如 6人间/8人间） */
.dorm-type-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #69B1FF 0%, #1677FF 100%);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(22, 119, 255, 0.3);
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.dorm-type-tag text {
  color: #fff;
}

/* 顶部卡片徽章里的床位后缀 */
.bed-suffix {
  margin-left: 4rpx;
  font-weight: 600;
}

.dorm-room {
  background: linear-gradient(180deg, #FAFCFF 0%, #F5F9FF 100%);
  border-radius: 20rpx;
  padding: 24rpx 20rpx 0;
  border: 3rpx solid #5B8FF9;
  box-shadow: 0 6rpx 20rpx rgba(91, 143, 249, 0.12);
  position: relative;
}

/* 顶部窗户区域 */
.window-area {
  margin-bottom: 20rpx;
}

.window-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 18rpx 16rpx;
  background: linear-gradient(180deg, #E6FFE6 0%, #D4F5D4 100%);
  border: 2rpx solid #52C41A;
  border-radius: 12rpx;
  position: relative;
}

.window-strip::before {
  content: '';
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 50%;
  height: 1rpx;
  background: rgba(82, 196, 26, 0.4);
}

.window-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #389E0D;
  letter-spacing: 8rpx;
}

/* 床位行 - 保留横向布局类以兼容 */
.bed-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.top-bed-row {
  margin-bottom: 16rpx;
}

.bottom-bed-row {
  margin-bottom: 24rpx;
}

/* =========================== 竖向两列布局 =========================== */
.dorm-main {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin: 16rpx 0;
}

.bed-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.left-column {
  /* 靠窗一侧：1、2、3、4 号床 */
}

.right-column {
  /* 靠门一侧：5、6、7、8 号床 */
}

/* 中间竖向过道 */
.walkway-vertical {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  gap: 12rpx;
  position: relative;
}

.walkway-vertical::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: repeating-linear-gradient(
    to bottom,
    #B0C4DE 0,
    #B0C4DE 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.walkway-vertical-line {
  display: none;
}

.walkway-vertical-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  border: 1rpx solid rgba(140, 140, 140, 0.2);
  z-index: 1;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.walkway-vertical-icon .walkway-text {
  font-size: 20rpx;
  color: #718096;
  font-weight: 500;
  writing-mode: vertical-rl;
  letter-spacing: 4rpx;
}

/* 竖向布局下的床位样式 */
.bed-column .bed {
  flex: 1;
  min-height: 130rpx;
  background: linear-gradient(180deg, #F7FAFC 0%, #EDF2F7 100%);
  border: 2rpx solid #CBD5E0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  transition: all 0.3s ease;
  position: relative;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 6 人间床位高度更大（因为只有3行） */
.dorm-main-6 .bed-column .bed {
  min-height: 150rpx;
}

.bed-column .bed.my-bed {
  background: linear-gradient(180deg, #FFD666 0%, #FAAD14 100%);
  border-color: #FA8C16;
  box-shadow: 0 6rpx 16rpx rgba(250, 173, 20, 0.5);
  transform: scale(1.05);
  z-index: 2;
}

/* 床位左侧：序号+您的标识 */
.bed-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 70rpx;
}

.bed-column .bed-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A5568;
  line-height: 1;
}

.bed-column .bed.my-bed .bed-num {
  color: #fff;
  font-size: 44rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.bed-column .bed-label {
  font-size: 20rpx;
  color: #A0AEC0;
  margin-top: 4rpx;
  height: 22rpx;
}

.bed-column .bed.my-bed .bed-label {
  color: #fff;
  font-weight: 600;
}

/* 床位右侧：位置标识（窗侧/门侧） */
.bed-position {
  font-size: 18rpx;
  color: #A0AEC0;
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(160, 174, 192, 0.3);
}

.bed.my-bed .bed-position {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.5);
}

/* 床位右侧容器：用于同时显示下铺标签和位置 */
.bed-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

/* 下铺特殊标签（仅7、8号床） */
.lower-bunk-tag {
  font-size: 16rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF7A45 0%, #D4380D 100%);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 600;
  box-shadow: 0 1rpx 3rpx rgba(212, 56, 13, 0.3);
  letter-spacing: 1rpx;
  line-height: 1.4;
}

/* 下铺床位整体边框用更醒目的橙色 */
.bed.lower-bunk {
  border: 2rpx solid #FF7A45;
  background: linear-gradient(180deg, #FFF7E6 0%, #FFE7BA 100%);
  box-shadow: 0 2rpx 8rpx rgba(255, 122, 69, 0.2);
}

.bed.lower-bunk.my-bed {
  border: 2rpx solid #FAAD14;
  background: linear-gradient(180deg, #FFD666 0%, #FAAD14 100%);
}

/* 中间过道 */
.walkway {
  display: flex;
  align-items: center;
  margin: 16rpx 0;
  gap: 12rpx;
}

.walkway-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #B0C4DE 50%, transparent 100%);
  border-top: 1rpx dashed #B0C4DE;
}

.walkway-icon {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: rgba(140, 140, 140, 0.08);
  border-radius: 20rpx;
}

.walkway-text {
  font-size: 22rpx;
  color: #718096;
  font-weight: 500;
}

/* 底部入户门区域 */
.door-area {
  margin: 0 -20rpx;
  padding: 0 20rpx 24rpx;
}

.door-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.door-line {
  flex: 1;
  height: 6rpx;
  background: linear-gradient(90deg, #FA8C16 0%, #FAAD14 100%);
  border-radius: 3rpx;
}

.door-icon-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFE7BA 100%);
  border: 2rpx solid #FA8C16;
  border-radius: 24rpx;
  box-shadow: 0 3rpx 8rpx rgba(250, 140, 22, 0.2);
}

.door-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #D46B08;
  letter-spacing: 4rpx;
}

/* 我的床位标记 */
.my-bed-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #FFFBE6 0%, #FFF7E6 100%);
  border-radius: 16rpx;
  border: 2rpx dashed #FAAD14;
}

.marker-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #D46B08;
}

/* 图例 */
.dorm-legend {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #4A5568;
}

.legend-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
}

.legend-box.my-legend {
  background: linear-gradient(180deg, #FFD666 0%, #FAAD14 100%);
  border: 2rpx solid #FA8C16;
  box-shadow: 0 2rpx 4rpx rgba(250, 140, 22, 0.3);
}

.legend-box.other-legend {
  background: linear-gradient(180deg, #F7FAFC 0%, #EDF2F7 100%);
  border: 2rpx solid #CBD5E0;
}

/* 图例：下铺床位样式 */
.legend-box.lower-bunk-legend {
  position: relative;
  background: linear-gradient(180deg, #FFF7E6 0%, #FFE7BA 100%);
  border: 2rpx solid #FF7A45;
  display: flex;
  align-items: center;
  justify-content: center;
}

.legend-mini-tag {
  font-size: 14rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF7A45 0%, #D4380D 100%);
  padding: 1rpx 4rpx;
  border-radius: 4rpx;
  font-weight: 600;
  line-height: 1.3;
}

/* =========================== 班主任卡片 =========================== */
.teacher-section {
  background: linear-gradient(135deg, #FFFBE6 0%, #FFF7E6 100%);
  border: 2rpx solid rgba(250, 173, 20, 0.2);
}

.teacher-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 24rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(250, 173, 20, 0.1);
}

.teacher-avatar {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FAAD14 0%, #FFD666 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(250, 173, 20, 0.3);
  flex-shrink: 0;
}

.teacher-avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.teacher-title {
  font-size: 24rpx;
  color: var(--color-amber);
  background: rgba(250, 173, 20, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}

.teacher-contact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.phone-number {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-navy);
  flex: 1;
}

.call-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* =========================== 重新查询 =========================== */
.requery-section {
  display: block;
  width: 100%;
  text-align: center;
  margin: 40rpx 0 0;
}

.requery-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  background: transparent;
  color: var(--color-sky);
  border: 2rpx solid var(--color-sky);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  margin: 0;
  line-height: 1.4;
}

.requery-btn::after {
  border: none;
}

.requery-btn:active {
  background: var(--color-sky-bg);
}

/* =========================== 空状态 =========================== */
.empty-state {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 60rpx 24rpx 40rpx;
  margin-top: 24rpx;
  box-shadow: var(--elev-2);
  border: 1rpx solid var(--color-border);
  text-align: center;
}

.empty-description {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}