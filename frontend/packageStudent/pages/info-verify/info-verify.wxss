/* pages/info-verify/info-verify.wxml */

.page {
  background: #f5f6f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 可滚动内容区 */
.page-scroll {
  flex: 1;
  overflow-y: auto;
  box-sizing: border-box;
  /* 为底部操作栏留出空间 */
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f6f8;
}

.sv {
  font-variant-numeric: tabular-nums;
}

/* ====== 顶部标题 ====== */
.hd {
  margin-bottom: 24rpx;
}

.hd-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.hd-sub {
  font-size: 26rpx;
  color: #8a8f99;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ====== 筛选签 ====== */
.tabs {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.tab {
  border: 2rpx solid #e2e4e9;
  background: transparent;
  color: #5c6370;
  border-radius: 10rpx;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  transition: all 0.15s ease;
}

.tab-count {
  margin-left: 8rpx;
  opacity: 0.7;
}

.tab.is-on {
  background: #1a1a1a;
  color: #fff;
  border-color: #1a1a1a;
  font-weight: 500;
}

/* ====== 图例（已移除） ====== */

/* ====== 状态横幅 ====== */
.status-banner {
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.status-banner-pending { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.status-banner-verified { background: linear-gradient(135deg, #059669, #10b981); }
.status-banner-modified { background: linear-gradient(135deg, #1e40af, #3b82f6); }

.status-banner-row {
  display: flex;
  align-items: center;
}

.status-banner-text {
  font-size: 32rpx;
  font-weight: 600;
}

.status-banner-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* ====== 学习承诺书 ====== */
.commitment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #e2e4e9;
  margin-bottom: 20rpx;
}

.commitment-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.commitment-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 3rpx solid #cbd5e1;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s, border-color 0.2s;
}

.commitment-checkbox.is-checked {
  background: #1a1a1a;
  border-color: #1a1a1a;
}

.commitment-link-text {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.commitment-title {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.commitment-arrow {
  font-size: 36rpx;
  color: #5c6370;
  font-weight: 600;
}

/* ====== 分组标题 ====== */
.group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #5c6370;
  margin: 32rpx 0 16rpx;
  padding-left: 4rpx;
}

/* ====== 信息行 ====== */
.row {
  padding: 20rpx 24rpx;
  background: #fff;
  border: 2rpx solid #e2e4e9;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  transition: border-color 0.15s ease;
}

.row-force {
  border-color: #f0b8b0;
}

/* 第一行：字段名 + 状态标签 + 操作按钮 */
.row-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

/* 字段名 */
.row-lbl {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 第二行：值 */
.row-val {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.row-text {
  font-size: 30rpx;
  color: #5c6370;
  line-height: 1.5;
  word-break: break-all;
}

.row-text.is-md {
  color: #d48806;
  font-weight: 500;
}

.row-orig {
  display: block;
  font-size: 24rpx;
  color: #a6abb5;
  margin-top: 4rpx;
  word-break: break-all;
}

.row-orig.is-err {
  color: #d4380d;
}

/* 格式校验错误提示 */
.row-err {
  display: block;
  font-size: 24rpx;
  color: #d4380d;
  line-height: 1.4;
  margin-top: 8rpx;
  word-break: break-all;
}

/* 行内输入框 */
.row-input {
  width: 100%;
  /* 原生 input 是固定高度元素，padding 不会撑高元素，
     必须显式指定 height + line-height，否则内容会被裁切显示不全 */
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  background: #fff;
  border: 2rpx solid #1a1a1a;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 校验失败的输入框：红框 */
.row-input.is-err {
  border-color: #d4380d;
  background: #fff5f3;
}

/* 下拉选择行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #1a1a1a;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.picker-text {
  font-size: 30rpx;
  color: #1a1a1a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  color: #8a8f99;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

/* 状态标签 */
.row-chip {
  flex-shrink: 0;
  display: flex;
  justify-content: flex-start;
}

.chip {
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.chip-ok  { color: #389e0d; background: #f0f9e8; }
.chip-no  { color: #8a8f99; background: #f0f1f3; }
.chip-md  { color: #d48806; background: #fdf3e0; }
.chip-err { color: #d4380d; background: #fdece8; }

/* 操作按钮 */
.row-acts {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  justify-content: flex-end;
}

.mini-btn {
  border: 2rpx solid #e2e4e9;
  background: #fff;
  color: #5c6370;
  border-radius: 16rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.3;
  transition: all 0.15s ease;
}

.mini-btn:active {
  border-color: #b6bac2;
  color: #1a1a1a;
}

.mini-btn-ok {
  color: #389e0d;
}

.mini-btn-ok.is-done {
  background: #f0f9e8;
  border-color: #d5e8c0;
}

.mini-btn-pri {
  background: #1a1a1a;
  color: #fff;
  border-color: #1a1a1a;
}

/* ====== 空状态 ====== */
.empty-box {
  padding: 64rpx 0;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx dashed #e2e4e9;
  margin-top: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #a6abb5;
}

/* ====== 底部操作栏 ====== */
.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 99;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.foot-btns {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  flex: 1;
}

/* 两个按钮各占一半宽度 */
.foot-bar .foot-btns .secondary-btn,
.foot-bar .foot-btns .primary-btn {
  flex: 1 1 0%;
  width: 0;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 28rpx;
}

.foot-bar .secondary-btn {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #5c6370;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid #e2e4e9;
  transition: opacity 200ms ease, transform 150ms ease;
}

.foot-bar .secondary-btn:active {
  transform: scale(0.97);
  background: #f5f6f8;
}

.foot-bar .secondary-btn.is-disabled {
  opacity: 0.4;
  color: #a6abb5;
}

.primary-btn {
  height: 76rpx;
  border-radius: 16rpx;
  background: #1a1a1a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 32rpx;
  transition: opacity 200ms ease, transform 150ms ease;
}

.primary-btn.is-loading {
  opacity: 0.7;
}

.primary-btn.is-disabled {
  background: #cbd5e1;
  color: #f8fafc;
}

.primary-btn:active {
  transform: scale(0.98);
}

/* ============================================================
   学习承诺书弹窗
   ============================================================ */
.commitment-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f4f6fb;
  box-sizing: border-box;
}

/* 顶部导航栏 */
.commitment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  flex-shrink: 0;
  padding-top: env(safe-area-inset-top);
}

.commitment-header-left,
.commitment-header-right {
  width: 80rpx;
}

.commitment-close-icon {
  font-size: 56rpx;
  color: #64748b;
  line-height: 1;
  font-weight: 300;
}

.commitment-header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
  text-align: center;
  flex: 1;
}

/* 内容区 */
.commitment-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 40rpx;
  box-sizing: border-box;
}

.commitment-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.commitment-doc-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
}

.commitment-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 2;
  text-indent: 2em;
  margin-bottom: 20rpx;
}

.commitment-item {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 2;
  margin-bottom: 16rpx;
}

.commitment-blank {
  display: inline-block;
  min-width: 120rpx;
}

.commitment-level {
  min-width: 100rpx;
  padding: 0 12rpx;
  font-weight: 600;
  color: #1e40af;
  border-bottom: 2rpx solid #1e40af;
  text-align: center;
  margin: 0 6rpx;
}

.commitment-major {
  min-width: 140rpx;
  padding: 0 12rpx;
  font-weight: 600;
  color: #1e40af;
  border-bottom: 2rpx solid #1e40af;
  text-align: center;
  margin: 0 6rpx;
}
