.container,.loading-tip{padding:24rpx;} .loading-tip{display:flex;align-items:center;justify-content:center;padding:80rpx 0;color:#999;gap:12rpx;}
.exam-topbar{display:flex;align-items:center;justify-content:space-between;background:#fff;padding:20rpx 24rpx;border-radius:12rpx;margin:24rpx;}
.topbar-title{font-size:30rpx;font-weight:600;} .topbar-progress{color:#1890FF;font-size:28rpx;}
.question-card{background:#fff;margin:0 24rpx;border-radius:16rpx;padding:28rpx 24rpx;}
.q-header{display:flex;gap:16rpx;align-items:center;margin-bottom:16rpx;} .q-type{color:#1890FF;font-size:26rpx;} .q-order{color:#999;font-size:26rpx;}
.q-content{font-size:30rpx;line-height:1.6;margin-bottom:20rpx;white-space:pre-wrap;}
.q-option{display:flex;gap:12rpx;padding:20rpx;border:1rpx solid #F0F0F0;border-radius:12rpx;margin-bottom:16rpx;font-size:28rpx;}
.option-selected{border-color:#1890FF;background:#e6f7ff;}
.option-label{font-weight:700;color:#1890FF;min-width:40rpx;} .option-mark{margin-left:auto;color:#52c41a;}
.q-textarea{width:100%;min-height:240rpx;border:1rpx solid #F0F0F0;border-radius:12rpx;padding:16rpx;font-size:28rpx;}
.exam-bottom{display:flex;gap:16rpx;margin:24rpx;} .btn-nav{flex:1;text-align:center;background:#fff;border:1rpx solid #F0F0F0;border-radius:32rpx;padding:16rpx 0;font-size:28rpx;}
.btn-submit{background:#1890FF;color:#fff;border:none;}
