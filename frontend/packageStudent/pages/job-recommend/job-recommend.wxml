<include src="/utils/common-components.wxml" />
<view class="container">
  <!-- 顶部区域 -->
  <view class="hero-section">
    <view class="hero-content">
      <view class="hero-top-row">
        <view class="hero-icon-circle">
          <van-icon name="bag-o" size="44rpx" color="#fff" />
        </view>
        <view class="hero-text">
          <view class="hero-title">就业推荐</view>
          <view class="hero-desc">精选优质岗位 · 助力职业发展</view>
        </view>
      </view>
      <!-- 搜索栏 -->
      <view class="search-bar">
        <view class="search-input-wrap">
          <van-icon name="search" size="32rpx" color="#BFBFBF" />
          <input
            class="search-input"
            placeholder="搜索职位、企业或关键词"
            placeholder-class="search-placeholder"
            value="{{keyword}}"
            bindinput="onSearchInput"
            confirm-type="search"
          />
          <van-icon wx:if="{{keyword}}" name="clear" size="32rpx" color="#BFBFBF" bindtap="clearSearch" />
        </view>
      </view>
    </view>
  </view>

  <!-- 统计条 -->
  <view class="stats-bar" wx:if="{{articles.length > 0}}">
    <text class="stats-text">共 {{totalCount}} 条推荐</text>
  </view>

  <!-- 文章列表 -->
  <view class="article-list">
    <view
      class="article-card"
      wx:for="{{articles}}"
      wx:key="id"
      bindtap="onArticleTap"
      data-id="{{item.id}}"
    >
      <image
        wx:if="{{item.cover_image}}"
        class="article-cover"
        src="{{item.cover_image}}"
        mode="aspectFill"
      />
      <view class="article-body">
        <view class="article-title">{{item.title}}</view>
        <view class="article-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
        <view class="article-footer">
          <view class="footer-left">
            <view class="author-tag" wx:if="{{item.author}}">
              <van-icon name="manager-o" size="22rpx" color="#1890FF" />
              <text>{{item.author}}</text>
            </view>
            <text class="date-text">{{item.create_time}}</text>
          </view>
          <view class="views-tag">
            <van-icon name="eye-o" size="22rpx" />
            <text>{{item.view_count}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <van-loading size="44rpx" color="#1890FF">加载中...</van-loading>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!loading && noMore && articles.length > 0}}">
    <view class="no-more-line"></view>
    <text>没有更多了</text>
    <view class="no-more-line"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && articles.length === 0}}">
    <view class="empty-icon">
      <van-icon name="search" size="80rpx" color="#BFBFBF" />
    </view>
    <view class="empty-title">暂无推荐文章</view>
    <view class="empty-desc">稍后再来看看吧</view>
  </view>
</view>

<!-- 文章详情弹出层 -->
<view class="detail-overlay {{showDetail ? 'visible' : ''}}">
  <view class="detail-mask" bindtap="closeDetail"></view>
  <view class="detail-panel">
    <!-- 头部区域 -->
    <view class="detail-header">
      <view class="detail-header-top">
        <view class="detail-title">{{detail.title}}</view>
        <view class="detail-close" bindtap="closeDetail">
          <van-icon name="cross" size="28rpx" color="#fff" />
        </view>
      </view>
      <view class="detail-meta-row">
        <view class="detail-meta-item" wx:if="{{detail.author}}">
          <van-icon name="manager-o" size="22rpx" color="rgba(255,255,255,0.8)" />
          <text>{{detail.author}}</text>
        </view>
        <view class="detail-meta-item">
          <van-icon name="clock-o" size="22rpx" color="rgba(255,255,255,0.8)" />
          <text>{{detail.create_time}}</text>
        </view>
        <view class="detail-meta-item">
          <van-icon name="eye-o" size="22rpx" color="rgba(255,255,255,0.8)" />
          <text>{{detail.view_count}}次浏览</text>
        </view>
      </view>
    </view>
    <!-- 文章正文 -->
    <scroll-view class="detail-scroll" scroll-y>
      <view class="detail-content">
        <rich-text nodes="{{detail.content}}"></rich-text>
      </view>
    </scroll-view>
  </view>
</view>
