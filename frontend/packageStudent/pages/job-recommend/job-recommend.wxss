page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', -apple-system, sans-serif;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 280rpx);
  padding-bottom: 60rpx;
}

/* ==================== 顶部区域 ==================== */
.hero-section {
  position: relative;
  padding: 40rpx 24rpx 32rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-top-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.hero-icon-circle {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.hero-text {
  flex: 1;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.hero-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}

/* 搜索栏 */
.search-bar {
  margin-top: 0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 48rpx;
  padding: 0 28rpx;
  height: 84rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 84rpx;
}

.search-placeholder {
  color: var(--text-disabled);
  font-size: 28rpx;
}

/* 统计条 */
.stats-bar {
  padding: 8rpx 32rpx 0;
}

.stats-text {
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* ==================== 文章卡片 ==================== */
.article-list {
  padding: 16rpx 24rpx 0;
}

.article-card {
  background: #fff;
  border-radius: var(--border-radius);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  cursor: pointer;
  transition: all 0.3s ease;
  animation: fadeInUp 0.5s ease-out both;
}

.article-card:active {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.article-cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

.article-body {
  padding: 28rpx 28rpx 24rpx;
}

.article-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-summary {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-color);
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.15);
}

.date-text {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.views-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-disabled);
}

/* ==================== 加载 & 空状态 ==================== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 0;
  font-size: 24rpx;
  color: var(--text-disabled);
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--border-color);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-disabled);
  margin-top: 8rpx;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 详情弹出层 ==================== */
.detail-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9999;
  pointer-events: none;
}

.detail-overlay.visible {
  pointer-events: auto;
}

.detail-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.detail-overlay.visible .detail-mask {
  opacity: 1;
}

.detail-panel {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--bg-color);
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  display: flex;
  flex-direction: column;
  border-radius: var(--border-radius) var(--border-radius) 0 0;
  overflow: hidden;
  margin-top: 80rpx;
}

.detail-overlay.visible .detail-panel {
  transform: translateY(0);
}

/* 关闭按钮 */
.detail-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,77,79,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255,77,79,0.3);
  transition: all 0.2s ease;
}

.detail-close:active {
  background: #FF4D4F;
  transform: scale(0.9);
}

/* 详情头部 */
.detail-header {
  padding: 28rpx 28rpx 20rpx;
  background: var(--primary-gradient);
  position: relative;
  overflow: hidden;
}

.detail-header::before {
  content: '';
  position: absolute;
  top: -30rpx; right: -30rpx;
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.detail-header-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.detail-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.45;
  word-break: break-word;
}

.detail-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
  margin-top: 14rpx;
}

.detail-meta-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

/* 详情正文 */
.detail-scroll {
  flex: 1;
  overflow-y: scroll;
}

.detail-content {
  padding: 36rpx 32rpx 80rpx;
  background: #fff;
  min-height: 400rpx;
  font-size: 30rpx;
  line-height: 2;
  color: var(--text-secondary);
  word-break: break-word;
}
