.container {
  padding: 0;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 页面头部样式 */
.page-header {
  background: linear-gradient(135deg, #409eff 0%, #3788d8 100%);
  padding: 60rpx 32rpx 32rpx;
  color: white;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-15px) rotate(180deg); }
}

.header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.header-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.header-text {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

.course-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.count-number {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

.count-label {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 提示信息样式 */
.notice-wrapper {
  padding: 0 24rpx;
  margin: 24rpx 0;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.courses-list {
  width: 100%;
  padding: 0 24rpx 24rpx;
}

.course-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 0;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  position: relative;
}

.course-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #409eff, #3788d8);
}

/* 课程头部样式 */
.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f6ff 100%);
}

.course-title-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.course-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.course-title-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
}

.course-id {
  font-size: 22rpx;
  color: #999;
}

.course-type-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background-color: #ecf5ff;
  color: #409eff;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 课程主体样式 */
.course-body {
  padding: 0 32rpx 32rpx;
}

.info-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.info-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #f8faff;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid #409eff;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-item .label {
  font-size: 22rpx;
  color: #666;
}

.info-item .value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 考试安排样式 */
.exam-section, .assessment-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.exam-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exam-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fff5f0 0%, #ffe8d6 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #e86433;
}

.exam-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exam-label {
  font-size: 22rpx;
  color: #666;
}

.exam-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.exam-value.time {
  color: #e86433;
  font-weight: bold;
}

/* 考核方式样式 */
.assessment-grid {
  display: flex;
  gap: 16rpx;
}

.assessment-item {
  flex: 1;
  background: linear-gradient(135deg, #f8faff 0%, #f0f6ff 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #ecf5ff;
  position: relative;
}

.assessment-type {
  font-size: 24rpx;
  font-weight: bold;
  color: #409eff;
  text-align: center;
  margin-bottom: 12rpx;
  padding: 8rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 8rpx;
}

.assessment-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: center;
}

.assessment-method {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.assessment-ratio {
  font-size: 28rpx;
  color: #e86433;
  font-weight: bold;
}

/* 空状态样式 */
.empty-state {
  margin-top: 100rpx;
  padding: 40rpx;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #409eff, #3788d8);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.refresh-btn::after {
  border: none;
}