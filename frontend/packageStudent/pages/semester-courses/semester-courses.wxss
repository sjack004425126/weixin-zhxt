.container {
  padding: 0;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 页面头部样式（配色保持不变） */
.page-header {
  background: linear-gradient(135deg, #409eff 0%, #3788d8 100%);
  padding: 60rpx 32rpx 32rpx;
  color: white;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-15px) rotate(180deg); }
}

.header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.header-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-text {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

.course-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

/* 提示信息样式 */
.notice-wrapper {
  padding: 0 24rpx;
  margin: 24rpx 0;
}

.courses-list {
  width: 100%;
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

/* ===== 精简卡片：单列、留白、微交互（steering: micro-interactions） ===== */
.course-mini-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  position: relative;
  transition: box-shadow 200ms ease, transform 200ms ease, background-color 200ms ease;
}

.course-mini-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #409eff, #3788d8);
}

.course-mini-card:active {
  background-color: #f0f6ff;
  box-shadow: 0 4rpx 16rpx rgba(64, 158, 255, 0.18);
}

.mini-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.course-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.course-icon.large {
  width: 72rpx;
  height: 72rpx;
}

.mini-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.course-id {
  font-size: 22rpx;
  color: #999;
}

.course-type-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background-color: #ecf5ff;
  color: #409eff;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
}

/* 卡片次要信息：一行两 chip，超出省略 */
.mini-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.meta-chip {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #f8faff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  min-width: 0;
  border-left: 4rpx solid #409eff;
}

.meta-chip.warm {
  background: linear-gradient(135deg, #fff5f0 0%, #ffe8d6 100%);
  border-left-color: #e86433;
}

.meta-text {
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mini-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.more-text {
  font-size: 24rpx;
  color: #999;
}

/* ===== 详情弹出层 ===== */
.detail-sheet {
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e5e5e5;
  margin: 8rpx auto 20rpx;
}

.sheet-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.sheet-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
}

.sheet-sub {
  font-size: 24rpx;
  color: #999;
}

.sheet-body {
  max-height: 58vh;
  padding-top: 8rpx;
}

.detail-section {
  margin-top: 24rpx;
}

.detail-section.last {
  margin-bottom: 8rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-rows {
  background-color: #f8faff;
  border-radius: 16rpx;
  border-left: 4rpx solid #409eff;
  overflow: hidden;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #eef3fb;
}

.detail-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.row-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

/* 考试安排样式（配色保持不变） */
.exam-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exam-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fff5f0 0%, #ffe8d6 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #e86433;
}

.exam-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exam-label {
  font-size: 22rpx;
  color: #666;
}

.exam-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.exam-value.time {
  color: #e86433;
  font-weight: bold;
}

/* 考核方式样式（配色保持不变） */
.assessment-grid {
  display: flex;
  gap: 16rpx;
}

.assessment-item {
  flex: 1;
  background: linear-gradient(135deg, #f8faff 0%, #f0f6ff 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #ecf5ff;
}

.assessment-type {
  font-size: 24rpx;
  font-weight: bold;
  color: #409eff;
  text-align: center;
  margin-bottom: 12rpx;
  padding: 8rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 8rpx;
}

.assessment-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: center;
}

.assessment-method {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.assessment-ratio {
  font-size: 28rpx;
  color: #e86433;
  font-weight: bold;
}

/* 空状态样式（配色保持不变） */
.empty-state {
  margin-top: 100rpx;
  padding: 40rpx;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #409eff, #3788d8);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.refresh-btn::after {
  border: none;
}
