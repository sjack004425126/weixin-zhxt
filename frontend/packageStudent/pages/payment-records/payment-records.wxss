/* 主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  --card-shadow-hover: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 0 24rpx 200rpx;
}

/* 页面头部样式 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  margin: 0 -24rpx 32rpx;
  padding: 32rpx 24rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.stats-info {
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}

.stats-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 区域标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-title text {
  flex: 1;
}

.toggle-icon {
  transition: transform 0.3s ease;
}

/* 已支付区域 */
.paid-section {
  margin-top: 32rpx;
}

.paid-section .section-title {
  background: rgba(82, 196, 26, 0.05);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(82, 196, 26, 0.1);
}

/* 记录列表样式 */
.records-list {
  padding: 0;
}

.record-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
  overflow: hidden;
}

.record-card:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

/* 状态指示器 */
.status-indicator {
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  border-radius: 0 4rpx 4rpx 0;
}

.paid-indicator {
  background: linear-gradient(180deg, var(--success-color) 0%, #73D13D 100%);
}

.unpaid-indicator {
  background: linear-gradient(180deg, var(--warning-color) 0%, #FFC53D 100%);
}

.paid-card {
  border-left: 4rpx solid var(--success-color);
}

.unpaid-card {
  border-left: 4rpx solid var(--warning-color);
}

/* 记录头部 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.order-info {
  flex: 1;
}

.order-no {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.order-no.offline {
  color: var(--warning-color);
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.status-badge.paid {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
  border: 1rpx solid rgba(82, 196, 26, 0.2);
}

.status-badge.unpaid {
  background: rgba(250, 173, 20, 0.1);
  color: var(--warning-color);
  border: 1rpx solid rgba(250, 173, 20, 0.2);
}

/* 缴费描述 */
.record-description {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #F8F9FA 0%, #F0F2F5 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid var(--primary-color);
}

.record-description text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
}

/* 费用详情 */
.record-content {
  margin-bottom: 20rpx;
}

.fee-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.fee-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
}

.fee-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.fee-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fee-value.reduction {
  color: var(--success-color);
}

/* 总金额 */
.total-amount {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #F0F8FF 100%);
  border-radius: 12rpx;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.total-amount.paid {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.1) 0%, rgba(82, 196, 26, 0.05) 100%);
  border: 2rpx solid rgba(82, 196, 26, 0.3);
}

.total-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.total-amount.paid .total-label {
  color: var(--success-color);
}

.total-amount.paid .total-value {
  color: var(--success-color);
}

/* 时间信息 */
.record-footer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--border-color);
}

.time-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.time-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* 操作按钮 */
.record-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

/* 空状态 */
.empty-container {
  padding: 120rpx 40rpx;
  text-align: center;
}

/* Vant组件样式覆盖 */
.van-button--primary {
  background: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3) !important;
  transition: all 0.3s ease !important;
}

.van-button--primary:active {
  transform: translateY(1rpx) !important;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.3) !important;
}

.van-empty__description {
  color: var(--text-disabled) !important;
  font-size: 28rpx !important;
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.record-card {
  animation: fadeInUp 0.6s ease-out;
}

.record-card:nth-child(1) { animation-delay: 0.1s; }
.record-card:nth-child(2) { animation-delay: 0.2s; }
.record-card:nth-child(3) { animation-delay: 0.3s; }
.record-card:nth-child(4) { animation-delay: 0.4s; }
.record-card:nth-child(5) { animation-delay: 0.5s; }

/* 响应式设计 */
@media (max-width: 750rpx) {
  .fee-grid {
    grid-template-columns: 1fr;
  }

  .total-amount {
    flex-direction: column;
    gap: 12rpx;
    text-align: center;
  }
}

/* 底部支付按钮 */
.bottom-pay-btn {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

/* 待支付按钮样式 */
.bottom-pay-btn .van-button--primary {
  background: var(--warning-color) !important;
  border-color: var(--warning-color) !important;
  box-shadow: 0 4rpx 12rpx rgba(250, 173, 20, 0.3) !important;
}