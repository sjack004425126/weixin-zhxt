page { --primary-color:#1890FF; }
.container { min-height:100vh; background:#FAFAFA; padding:24rpx; }
.page-header { padding:32rpx 0 24rpx; background:#fff; margin:-24rpx -24rpx 24rpx; }
.header-content { display:flex; align-items:center; gap:16rpx; padding:0 24rpx; }
.back-button { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; color:#1890FF; }
.header-title { font-size:34rpx; font-weight:700; } .header-subtitle { font-size:24rpx; color:#999; }
.loading-tip { display:flex; align-items:center; justify-content:center; padding:80rpx 0; color:#999; gap:12rpx; }
.exam-list { display:flex; flex-direction:column; gap:20rpx; }
.exam-item { background:#fff; border-radius:16rpx; padding:28rpx 24rpx; border:1rpx solid #F0F0F0; }
.exam-card-top { display:flex; justify-content:space-between; align-items:center; }
.exam-title { font-size:32rpx; font-weight:600; flex:1; }
.status-tag { font-size:22rpx; padding:4rpx 12rpx; border-radius:8rpx; background:#e6f7ff; color:#1890ff; border:1rpx solid #91d5ff; }
.exam-card-info { margin-top:16rpx; font-size:26rpx; display:flex; flex-direction:column; gap:8rpx; }
.info-label { color:#999; } .info-value { color:#262626; }
.exam-card-bottom { margin-top:20rpx; border-top:1rpx solid #F0F0F0; padding-top:20rpx; }
.btn-start { background:#1890FF; color:#fff; padding:10rpx 32rpx; border-radius:32rpx; font-size:26rpx; text-align:center; }
.empty-tip { text-align:center; padding:80rpx 0; color:#BFBFBF; font-size:28rpx; }
