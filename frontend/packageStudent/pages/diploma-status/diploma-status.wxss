page {
  --c-primary: #1890FF;
  --c-primary-light: #E6F7FF;
  --c-success: #52C41A;
  --c-success-light: #F6FFED;
  --c-danger: #FF4D4F;
  --c-warning: #FAAD14;
  --c-text: #262626;
  --c-text2: #595959;
  --c-text3: #8C8C8C;
  --c-border: #F0F0F0;
  --c-bg: #F5F7FA;
  --radius: 16rpx;
  --shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  background: var(--c-bg);
}

/* ===== 导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: 0 1rpx 8rpx rgba(24,144,255,0.1);
}
.nav-inner {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}
.nav-icon-wrap {
  width: 72rpx; height: 72rpx;
  background: linear-gradient(135deg, #1890FF, #40A9FF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nav-title-wrap { flex: 1; }
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-text);
  display: block;
}
.nav-sub {
  font-size: 22rpx;
  color: var(--c-text3);
  letter-spacing: 1rpx;
}
.nav-home {
  width: 60rpx; height: 60rpx;
  background: var(--c-primary-light);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--c-primary);
  cursor: pointer;
}



/* ===== 页面主体 ===== */
.page-body { padding: 140rpx 24rpx 48rpx; }
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

/* ===== 证书状态英雄卡 ===== */
.diploma-hero {
  border-radius: var(--radius);
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.hero-graduated {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  box-shadow: 0 6rpx 20rpx rgba(24,144,255,0.25);
}
.hero-studying {
  background: linear-gradient(135deg, #FAAD14 0%, #D48806 100%);
  box-shadow: 0 6rpx 20rpx rgba(250,173,20,0.25);
}
.hero-icon-wrap {
  width: 96rpx; height: 96rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 3rpx solid rgba(255,255,255,0.3);
}
.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}


/* ===== 区域标题 ===== */
.section { margin-bottom: 28rpx; }
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.section-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
}
.primary-dot { background: var(--c-primary); }
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}

/* 状态胶囊 */
.status-pill {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.pill-success {
  color: var(--c-success);
  background: var(--c-success-light);
  border: 1rpx solid rgba(82,196,26,0.3);
}
.pill-pending {
  color: var(--c-warning);
  background: #FFFBE6;
  border: 1rpx solid rgba(250,173,20,0.3);
}


/* ===== 信息卡片 ===== */
.info-card {
  background: #fff;
  border-radius: var(--radius);
  padding: 24rpx;
  box-shadow: var(--shadow);
}
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.info-grid-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx;
  background: var(--c-primary-light);
  border-radius: 12rpx;
}
.info-label {
  font-size: 22rpx;
  color: var(--c-text3);
}
.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}
.info-row-full {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: var(--c-primary-light);
  border-radius: 12rpx;
  border-left: 6rpx solid var(--c-primary);
}
.info-row-full .info-label { margin-right: 8rpx; }
.info-row-full .info-value { flex: 1; }
.pending-text {
  color: var(--c-text3);
  font-weight: 400;
}


/* ===== 等待卡片 ===== */
.waiting-card {
  background: #fff;
  border-radius: var(--radius);
  padding: 60rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.waiting-text {
  font-size: 28rpx;
  color: var(--c-text2);
  text-align: center;
  line-height: 1.6;
}

/* ===== 通知提示栏 ===== */
.notice-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  border-left: 6rpx solid var(--c-primary);
}
.notice-text {
  font-size: 26rpx;
  color: var(--c-text2);
  line-height: 1.6;
  flex: 1;
}

/* ===== 领取流程卡片 ===== */
.flow-card {
  background: #fff;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.flow-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 20rpx;
  display: block;
}
.flow-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.flow-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.step-num {
  width: 44rpx; height: 44rpx;
  background: linear-gradient(135deg, #1890FF, #40A9FF);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.step-text {
  font-size: 26rpx;
  color: var(--c-text2);
  line-height: 1.5;
  flex: 1;
}

/* ===== 注意事项 ===== */
.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.notice-item-text {
  font-size: 26rpx;
  color: var(--c-text2);
  line-height: 1.6;
  flex: 1;
}