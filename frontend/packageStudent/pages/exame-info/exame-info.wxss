/* 考试详情页（中职 exame） */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --border-radius: 16rpx;
}
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 120rpx 0;
  color: var(--text-secondary);
  font-size: 26rpx;
}
/* 页面头部 */
.page-header {
  background: #fff;
  padding: 24rpx 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2rpx solid var(--border-color);
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.05);
}
.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}
.back-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(24, 144, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  flex-shrink: 0;
}
.header-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.header-text { flex: 1; min-width: 0; }
.header-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); }
.header-subtitle { font-size: 22rpx; color: var(--text-secondary); letter-spacing: 1rpx; text-transform: uppercase; margin-top: 4rpx; }
.header-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(24, 144, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  flex-shrink: 0;
}
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 220rpx);
  padding: 24rpx;
  padding-bottom: 60rpx;
}
/* 状态横幅 */
.exam-status-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--border-radius);
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.status-ended { background: linear-gradient(135deg, #FFF1F0, #FFCCC7); color: #CF1322; border: 1rpx solid #FFA39E; }
.status-pending { background: linear-gradient(135deg, #FFFBE6, #FFE58F); color: #AD6800; border: 1rpx solid #FFE58F; }
.status-noauth { background: linear-gradient(135deg, #FFF1F0, #FFCCC7); color: #CF1322; border: 1rpx solid #FFA39E; }
/* 考试信息卡 */
.exam-card {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx 28rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.exam-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6rpx;
  background: var(--primary-gradient);
}
.exam-title { font-size: 34rpx; font-weight: 800; color: var(--text-primary); line-height: 1.5; margin-bottom: 12rpx; }
.exam-desc { font-size: 26rpx; color: var(--text-secondary); line-height: 1.6; margin-bottom: 20rpx; }
.exam-meta { background: #FAFBFC; border-radius: 12rpx; padding: 8rpx 20rpx; border: 1rpx solid var(--border-color); }
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.meta-row:last-child { border-bottom: none; }
.meta-label { font-size: 26rpx; color: var(--text-secondary); }
.meta-value { font-size: 26rpx; font-weight: 700; color: var(--text-primary); max-width: 65%; text-align: right; word-break: break-all; }
.exam-action { margin-top: 24rpx; }
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}
.btn-disabled {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #F5F5F5;
  color: var(--text-disabled);
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}
/* 历史成绩 */
.records-card {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 28rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
}
.card-title { font-size: 30rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 20rpx; }
.card-title::before { content: '📊 '; }
.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.record-row:last-child { border-bottom: none; }
.record-row-left { display: flex; align-items: baseline; min-width: 140rpx; }
.record-score { font-size: 40rpx; font-weight: 800; font-family: monospace; }
.record-score-total { font-size: 24rpx; color: var(--text-disabled); margin-left: 4rpx; }
.record-row-mid { flex: 1; display: flex; flex-direction: column; gap: 6rpx; margin-left: 16rpx; }
.record-status { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.record-time { font-size: 22rpx; color: var(--text-disabled); word-break: break-all; }
