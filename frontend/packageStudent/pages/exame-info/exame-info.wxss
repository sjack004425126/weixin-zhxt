/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 24rpx;
  padding-top: 120rpx;
}

/* 页面头部样式 */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0 -24rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  position: relative;
}

/* 返回按钮 */
.back-button {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.back-button:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.1);
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.header-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 头部操作按钮 */
.header-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

.header-action:hover {
  background: var(--primary-color);
  color: white;
  transform: scale(1.1);
}

/* 考试列表样式 */
.exam-list {
  width: 100%;
}

.exam-item {
  background: white;
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.exam-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.exam-item:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.exam-type {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.exam-status {
  background: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}

.status-text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* 考试卡片样式 */
.sj-card {
  background: white;
  border-radius: var(--border-radius);
  margin: 24rpx 0;
  padding: 32rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.sj-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.sj-card:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.sj-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.sj-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sj-title-wrap::before {
  content: '📝';
  font-size: 32rpx;
}

.sj-title {
  font-weight: 700;
  color: var(--primary-color);
  font-size: 36rpx;
  letter-spacing: 1rpx;
}
/* 考试记录列表样式 */
.sj-dt-list {
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #F8FAFF, #F0F8FF);
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(24, 144, 255, 0.1);
}

.sj-dt-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.05);
  transition: all 0.3s ease;
}

.sj-dt-row:hover {
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.15);
  transform: translateY(-2rpx);
}

.sj-dt-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  color: white;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.sj-dt-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sj-dt-content > view {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  background: #FAFBFC;
  border-radius: 6rpx;
}

.score-label, .status-label, .time-label {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 500;
}

.score-value, .status-value, .time-value {
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  background: white;
  border-radius: 4rpx;
  border: 1rpx solid var(--border-color);
}
/* 考试按钮样式 */
.sj-action {
  text-align: right;
}

.sj-btn {
  display: inline-block;
  background: var(--primary-gradient);
  color: white;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border: none;
  margin-left: 20rpx;
  min-width: auto !important;
  max-width: none !important;
  width: auto !important;
  box-sizing: border-box;
  letter-spacing: 0;
  margin-left: auto;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  transition: all 0.3s ease;
}

.sj-btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.4);
}

.sj-btn[disabled] {
  background: linear-gradient(135deg, #F5F5F5, #E8E8E8);
  color: var(--text-disabled);
  box-shadow: none;
  transform: none;
}

.sj-dt-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sj-dt-title::before {
  content: '📊';
  font-size: 24rpx;
}

.sj-dt-divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 20rpx 0;
  width: 100%;
  border-radius: 1rpx;
}

/* 移除旧的导航样式，已整合到头部 */

/* 考试提示样式 */
.exam-tip {
  display: flex;
  align-items: center;
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  gap: 16rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.exam-tip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--warning-color);
}

.exam-tip:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2rpx);
}

.exam-tip van-icon {
  color: var(--warning-color) !important;
}

.tip-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.tip-text {
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

/* 答题状态提示样式 */
.exam-status-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
  border: 2rpx solid #ff5252;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 82, 82, 0.2);
  padding: 32rpx 40rpx;
  margin: 24rpx 0;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

.exam-status-tip::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

.status-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(255, 82, 82, 0.1);
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}