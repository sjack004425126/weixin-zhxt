page { background: #F5F7FA; }
.page { padding: 0 24rpx 32rpx; }

/* 2026-09-29：自定义顶部导航栏（用 redirectTo 进来时系统小胶囊返回不可用，手动加一个） */
.custom-navbar {
  display: flex; align-items: center; height: 88rpx;
  background: #1890FF; padding: 0 16rpx;
  margin: 0 -24rpx 16rpx;   /* 抵消 .page 的左右 padding，让背景色铺满 */
  position: sticky; top: 0; z-index: 20;
}
.navbar-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 32rpx;
}
.navbar-back-hover { background: rgba(255,255,255,0.15); }
.navbar-title {
  flex: 1; text-align: center;
  font-size: 32rpx; font-weight: 600; color: #fff;
}
.navbar-placeholder { width: 64rpx; }

.tabs {
  position: sticky; top: 88rpx; z-index: 9;
  display: flex; gap: 16rpx;
  padding: 20rpx 0;
  background: #F5F7FA;
}
.tab {
  flex: 1; text-align: center; padding: 16rpx 0;
  background: #fff; border-radius: 32rpx;
  font-size: 26rpx; color: #595959;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.tab-active { background: #1890FF; color: #fff; font-weight: 600; }

.list { display: flex; flex-direction: column; gap: 20rpx; }

.item-card {
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.item-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.cat-tag { padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; }
.cat-repair { background: #FFF1E6; color: #FA541C; }
.cat-suggest { background: #E6FFFB; color: #13C2C2; }
.urgent-tag {
  padding: 4rpx 16rpx; border-radius: 8rpx;
  background: #FFF1F0; color: #FF4D4F; font-size: 22rpx; font-weight: 600;
}
.status-tag { margin-left: auto; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; }
.status-pending { background: #F5F5F5; color: #8C8C8C; }
.status-processing { background: #E6F7FF; color: #1890FF; }
.status-done { background: #F6FFED; color: #52C41A; }
.status-rejected { background: #FFF1F0; color: #FF4D4F; }
.status-cancelled { background: #F5F5F5; color: #BFBFBF; }

.item-title { font-size: 30rpx; font-weight: 600; color: #262626; margin-bottom: 8rpx; }
.item-desc {
  font-size: 26rpx; color: #595959; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; margin-bottom: 14rpx;
}

.item-thumbs { display: flex; gap: 12rpx; margin-bottom: 14rpx; align-items: center; }
.thumb-wrap { width: 140rpx; height: 140rpx; border-radius: 12rpx; overflow: hidden; }
.thumb { width: 140rpx; height: 140rpx; border-radius: 12rpx; display: block; }
.thumb-video {
  background: linear-gradient(135deg, #1f2937, #374151);
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
}
.thumb-poster {
  position: absolute; left: 0; top: 0;
  width: 100%; height: 100%;
}
.thumb-more {
  width: 60rpx; height: 60rpx; border-radius: 30rpx;
  background: rgba(0,0,0,0.5); color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

.item-foot {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 24rpx; color: #8C8C8C;
}
.foot-left { display: flex; align-items: center; gap: 6rpx; }
.loc { max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.time { font-size: 22rpx; }

.reply-box {
  margin-top: 16rpx; padding: 16rpx 20rpx;
  background: #F6FFED; border-left: 4rpx solid #52C41A; border-radius: 8rpx;
}
.reply-label { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: #52C41A; font-weight: 600; }
.reply-content { font-size: 26rpx; color: #262626; margin-top: 6rpx; line-height: 1.5; }

.no-more { text-align: center; color: #BFBFBF; font-size: 24rpx; padding: 40rpx 0; }
