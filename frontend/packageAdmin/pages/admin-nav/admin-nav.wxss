.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 100%);
}

/* 认证页面样式 */
.auth-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.auth-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.auth-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  bottom: 200rpx;
  left: -100rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #ff6b6b, #feca57);
  bottom: -50rpx;
  right: 100rpx;
}

.auth-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.15);
  width: 100%;
  max-width: 600rpx;
  position: relative;
  z-index: 1;
}

.auth-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.auth-icon {
  font-size: 60rpx;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.auth-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 60rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.auth-btn::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
}

/* 主容器 */
.main-container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部背景 */
.header-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.logout-btn {
  font-size: 24rpx;
  color: #fff;
  padding: 12rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 功能区域 */
.nav-section {
  padding: 0 24rpx;
  margin-top: -50rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* 导航网格 */
.nav-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.nav-card {
  width: calc(50% - 12rpx);
  aspect-ratio: 1;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}

.nav-card:active {
  transform: scale(0.96);
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.card-blue {
  background: linear-gradient(135deg, #667eea 0%, #5a67d8 100%);
}

.card-blue .card-bg {
  background: radial-gradient(circle at top right, rgba(255,255,255,0.2), transparent 60%);
}

.card-purple {
  background: linear-gradient(135deg, #9f7aea 0%, #805ad5 100%);
}

.card-purple .card-bg {
  background: radial-gradient(circle at top right, rgba(255,255,255,0.2), transparent 60%);
}

.card-green {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
}

.card-green .card-bg {
  background: radial-gradient(circle at top right, rgba(255,255,255,0.2), transparent 60%);
}

.nav-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.nav-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  position: relative;
  z-index: 1;
}

/* 底部提示 */
.footer-section {
  padding: 60rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-line {
  width: 60rpx;
  height: 4rpx;
  background: #e0e0e0;
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.footer-tip {
  color: #bbb;
  font-size: 24rpx;
}
