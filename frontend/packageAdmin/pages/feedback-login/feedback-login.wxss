/* 校园反馈登录页：Minimal Single Column 模式，大留白 + 单 CTA 聚焦 */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部品牌区：蓝色背景带底部圆弧，过渡自然 */
.hero {
  margin: 0 -48rpx 56rpx;
  padding: 96rpx 48rpx 80rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(180deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
}
.logo {
  width: 144rpx; height: 144rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 2rpx;
}
.subtitle {
  font-size: 28rpx;
  opacity: 0.88;
  margin-top: 12rpx;
}

/* 3 条特性：无卡片容器，扁平列表直接坐在灰底上 */
.features {
  padding: 0 16rpx;
  margin-bottom: 48rpx;
}
.feat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.feat-item + .feat-item {
  margin-top: 8rpx;
}
.feat-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.feat-icon.blue { background: #E6F7FF; }
.feat-icon.blue van-icon { color: #1890FF !important; }
.feat-icon.green { background: #F6FFED; }
.feat-icon.green van-icon { color: #52C41A !important; }
.feat-icon.orange { background: #FFF7E6; }
.feat-icon.orange van-icon { color: #FA8C16 !important; }
.feat-text { flex: 1; min-width: 0; }
.feat-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
  line-height: 1.4;
}
.feat-desc {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
}

/* 登录 CTA 区：贴底（flex: auto 撑开上方空间），视觉重心明确 */
.login-area { margin-top: auto; }
.phone-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  padding: 0 40rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1890FF, #40A9FF);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.32);
  white-space: nowrap;
  box-sizing: border-box;
}
.phone-btn::after { border: none; }
.phone-btn[loading] { opacity: 0.85; }
.phone-btn-disabled {
  background: #BFBFBF !important;
  box-shadow: none !important;
}

.tip {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8C8C8C;
  font-size: 24rpx;
  margin-top: 24rpx;
}
.tip text { margin-left: 8rpx; }

/* 协议区：单行 flex + wrap，prefix/链接/and/链接全部居中不错位 */
.agreement {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #8C8C8C;
  line-height: 1.6;
}
.agree-group { display: inline-flex; }
.agree-label { display: inline-flex; align-items: center; }
.agree-label checkbox { transform: scale(0.8); }
.agree-txt { color: #8C8C8C; }
.agreement .link { color: #1890FF; }
.agree-and { color: #8C8C8C; margin: 0 4rpx; }

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #BFBFBF;
  margin-top: 32rpx;
}
