
@import "../../../components/vant-icon/index.wxss";

/* vi类: 直接用text渲染vant-icon字体unicode字符，绕过view+::before伪元素兼容性问题 */
.vi {
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  font-family: vant-icon, sans-serif;
}
/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 24rpx;
  padding-top: 160rpx;
}

/* 页面头部样式 */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  position: relative;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.header-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

/* 提示栏样式 */
.notice-bar {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  background: var(--primary-light);
  position: relative;
  overflow: hidden;
  box-shadow: var(--card-shadow);
}

.notice-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--primary-gradient);
}

.notice-bar.notice-warning {
  background: linear-gradient(135deg, #FFF7E6, #FFF2CC);
  border-color: rgba(250, 173, 20, 0.3);
}

.notice-bar.notice-warning::before {
  background: var(--warning-color);
}

.notice-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--primary-color);
}

.notice-bar.notice-warning .notice-content {
  color: var(--warning-color);
}

/* 申请按钮 */
.apply-btn-wrapper {
  margin-bottom: 24rpx;
}

.apply-btn-wrapper .van-button {
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border-radius: 44rpx !important;
  background: var(--primary-gradient) !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3) !important;
}

/* 列表区域 */
.list-section {
  background: white;
  border-radius: var(--border-radius);
  padding: 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.list-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.record-count {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  padding: 60rpx 0;
}

/* 请假列表 */
.leave-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.leave-item {
  background: #FAFBFC;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.leave-item:active {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.leave-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.leave-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-pending {
  background: #FFF7E6;
  color: var(--warning-color);
}

.status-approved {
  background: #F6FFED;
  color: var(--secondary-color);
}

.status-rejected {
  background: #FFF1F0;
  color: var(--error-color);
}

.status-completed {
  background: var(--primary-light);
  color: var(--primary-color);
}

.leave-content {
  margin-bottom: 16rpx;
}

.leave-reason {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.leave-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.leave-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.apply-time {
  font-size: 22rpx;
  color: var(--text-disabled);
}
