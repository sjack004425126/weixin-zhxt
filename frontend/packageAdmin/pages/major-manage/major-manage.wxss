.page-container {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 认证页面样式 */
.auth-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx;
}

.auth-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  width: 100%;
  max-width: 600rpx;
}

.auth-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.auth-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.auth-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.auth-btn::after {
  border: none;
}

/* 主容器 */
.main-container {
  padding: 20rpx;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.logout-btn {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 32rpx;
}

/* 选择器面板 */
.picker-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-wrapper {
  height: 300rpx;
}

.picker-view {
  width: 100%;
  height: 100%;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #333;
  padding: 0 8rpx;
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
}

/* 信息面板 */
.info-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.major-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.major-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.major-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.type-tag {
  background: #e8f4fd;
  color: #1890ff;
}

.level-tag {
  background: #f0f9eb;
  color: #67c23a;
}

/* 表单 */
.fee-form {
  margin-top: 16rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-item {
  flex: 1;
  min-width: 0;
}

.form-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 80rpx;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 10rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: #ccc;
  color: #fff;
}

/* 空状态 */
.empty-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}
