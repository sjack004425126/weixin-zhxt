page { background: #F5F7FA; }
.page { padding: 24rpx 24rpx 60rpx; }

.status-card {
  display: flex; align-items: center;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}
.status-bg-pending { background: linear-gradient(135deg, #8C8C8C, #BFBFBF); }
.status-bg-processing { background: linear-gradient(135deg, #1890FF, #40A9FF); }
.status-bg-done { background: linear-gradient(135deg, #52C41A, #95DE64); }
.status-bg-rejected { background: linear-gradient(135deg, #FF4D4F, #FF7875); }
.status-bg-cancelled { background: linear-gradient(135deg, #BFBFBF, #D9D9D9); }
.status-icon {
  width: 96rpx; height: 96rpx; border-radius: 48rpx;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
}
.status-text { font-size: 36rpx; font-weight: 700; }
.status-sub { font-size: 24rpx; opacity: 0.9; margin-top: 6rpx; }

.card {
  background: #fff; border-radius: 20rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-title {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 28rpx; font-weight: 600; color: #262626;
  margin-bottom: 16rpx;
}

.head-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.cat-tag { padding: 6rpx 18rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: 600; }
.cat-repair { background: #FFF1E6; color: #FA541C; }
.cat-suggest { background: #E6FFFB; color: #13C2C2; }
.urgent-tag { padding: 6rpx 18rpx; border-radius: 8rpx; background: #FFF1F0; color: #FF4D4F; font-size: 24rpx; font-weight: 600; }

.title { font-size: 34rpx; font-weight: 700; color: #262626; line-height: 1.4; margin-bottom: 14rpx; }
.content { font-size: 28rpx; color: #595959; line-height: 1.7; white-space: pre-wrap; }
.content.muted { color: #BFBFBF; }

.meta-row {
  display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx;
  margin-top: 16rpx; font-size: 24rpx; color: #8C8C8C;
}
.meta-tag { background: #F5F7FA; padding: 6rpx 16rpx; border-radius: 8rpx; }
.loc { color: #595959; }

.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.img-wrap { width: 200rpx; height: 200rpx; }
.img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.video-thumb {
  background: linear-gradient(135deg, #1f2937, #374151);
  display: flex; align-items: center; justify-content: center;
  position: relative;
  overflow: hidden;
}
.video-poster {
  position: absolute; left: 0; top: 0;
  width: 100%; height: 100%;
  border-radius: 12rpx;
}
.video-tag {
  position: absolute; left: 8rpx; bottom: 8rpx;
  padding: 2rpx 12rpx; border-radius: 8rpx;
  background: rgba(0,0,0,0.55); color: #fff; font-size: 20rpx;
}

.reporter {
  display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx;
  margin-top: 20rpx; padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 24rpx; color: #8C8C8C;
}
.dot-sep { color: #D9D9D9; }

.handler-meta { font-size: 24rpx; color: #8C8C8C; margin-top: 16rpx; }

.reject-card { background: #FFF7F6; }

.timeline { padding: 12rpx 0 0; }
.tl-item { position: relative; padding-left: 32rpx; padding-bottom: 28rpx; border-left: 2rpx solid #F0F0F0; margin-left: 8rpx; }
.tl-item:last-child { border-left-color: transparent; padding-bottom: 0; }
.tl-dot {
  position: absolute; left: -10rpx; top: 6rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: #BFBFBF; box-shadow: 0 0 0 4rpx #fff;
}
.tl-dot-submit { background: #1890FF; }
.tl-dot-process { background: #1890FF; }
.tl-dot-done { background: #52C41A; }
.tl-dot-reject { background: #FF4D4F; }
.tl-dot-cancel { background: #BFBFBF; }
.tl-action { font-size: 28rpx; color: #262626; font-weight: 600; }
.tl-meta { font-size: 22rpx; color: #8C8C8C; margin-top: 4rpx; }
.tl-remark { font-size: 26rpx; color: #595959; margin-top: 8rpx; line-height: 1.5; }

.actions { padding: 20rpx 0; }
