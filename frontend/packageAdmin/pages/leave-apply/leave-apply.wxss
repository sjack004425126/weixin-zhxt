/* 蓝色主题色彩变量 */
page {
  --primary-color: #1890FF;
  --primary-light: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --secondary-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg-color) 200rpx);
  padding: 24rpx;
  padding-top: 160rpx;
}

/* 页面头部样式 */
.page-header {
  padding: 32rpx 0 24rpx;
  margin: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  position: relative;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.header-text {
  flex: 1;
  margin-left: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.header-nav-action {
  width: 64rpx;
  height: 64rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  transition: all 0.3s ease;
  border: 2rpx solid rgba(24, 144, 255, 0.2);
}

/* 提示栏样式 */
.notice-bar {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  background: var(--primary-light);
  position: relative;
  overflow: hidden;
  box-shadow: var(--card-shadow);
}

.notice-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--primary-gradient);
}

.notice-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--primary-color);
}

/* 表单样式 */
.form {
  background: white;
  border-radius: var(--border-radius);
  padding: 32rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.form::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
}

.form-group {
  margin-bottom: 32rpx;
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.form-group::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--primary-gradient);
}

.form-group:hover {
  box-shadow: var(--card-shadow);
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

/* 提交按钮 */
.btn-submit {
  margin-top: 40rpx;
  padding: 0 24rpx;
}

.btn-submit .van-button {
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border-radius: 44rpx !important;
  background: var(--primary-gradient) !important;
  border: none !important;
  color: white !important;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3) !important;
  transition: all 0.3s ease !important;
}

.btn-submit .van-button:hover {
  transform: translateY(-2rpx) !important;
  box-shadow: 0 12rpx 32rpx rgba(24, 144, 255, 0.4) !important;
}


/* 日历组件样式优化 */
.van-calendar__footer {
  display: flex !important;
  justify-content: center !important;
  padding: 16rpx 32rpx !important;
}

.van-calendar__confirm {
  width: 80% !important;
  margin: 0 auto !important;
}

/* 请假时长展示 */
.duration-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
  background: #E6F7FF;
  border-radius: 12rpx;
  border: 1rpx solid #91D5FF;
}

.duration-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890FF;
}

/* 本人承诺 */
.promise-section {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FFFBE6;
  border-radius: 12rpx;
  border: 1rpx solid #FFE58F;
}

.promise-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.checkbox-icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #D9D9D9;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.checkbox-icon.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.promise-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.promise-label {
  font-weight: 700;
  color: var(--text-primary);
}
