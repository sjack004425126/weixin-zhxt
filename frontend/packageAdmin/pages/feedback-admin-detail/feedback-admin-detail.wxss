page { background: #F5F7FA; }
.page { padding: 24rpx 24rpx 60rpx; }

.card {
  background: #fff; border-radius: 20rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-title { display: flex; align-items: center; gap: 8rpx; font-size: 28rpx; font-weight: 600; color: #262626; margin-bottom: 16rpx; }

.head-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 14rpx; }
.cat-tag { padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; }
.cat-repair { background: #FFF1E6; color: #FA541C; }
.cat-suggest { background: #E6FFFB; color: #13C2C2; }
.urgent-tag { padding: 4rpx 16rpx; border-radius: 8rpx; background: #FFF1F0; color: #FF4D4F; font-size: 22rpx; font-weight: 600; }
.status-tag { margin-left: auto; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; }
.status-pending { background: #F5F5F5; color: #8C8C8C; }
.status-processing { background: #E6F7FF; color: #1890FF; }
.status-done { background: #F6FFED; color: #52C41A; }
.status-rejected { background: #FFF1F0; color: #FF4D4F; }

.title { font-size: 34rpx; font-weight: 700; color: #262626; line-height: 1.4; }
.ticket-no { font-size: 22rpx; color: #BFBFBF; margin: 6rpx 0 14rpx; }
.content { font-size: 28rpx; color: #595959; line-height: 1.7; white-space: pre-wrap; }

.meta-row { display: flex; align-items: center; gap: 6rpx; margin-top: 14rpx; font-size: 26rpx; color: #595959; }

.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.img-item, .img-add { width: 200rpx; height: 200rpx; border-radius: 12rpx; overflow: hidden; position: relative; }
.img-item image { width: 100%; height: 100%; }
.img-wrap { width: 200rpx; height: 200rpx; }
.video-thumb {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #1f2937, #374151);
  display: flex; align-items: center; justify-content: center;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}
.video-poster {
  position: absolute; left: 0; top: 0;
  width: 100%; height: 100%;
}
.video-tag {
  position: absolute; left: 8rpx; bottom: 8rpx;
  padding: 2rpx 12rpx; border-radius: 8rpx;
  background: rgba(0,0,0,0.55); color: #fff; font-size: 20rpx;
}
.img-del { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; }
.img-add { background: #F5F7FA; border: 2rpx dashed #D9D9D9; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #BFBFBF; font-size: 24rpx; gap: 8rpx; }

.reporter {
  margin-top: 20rpx; padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}
.reporter-row {
  display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap;
  font-size: 24rpx; color: #595959; margin-bottom: 4rpx;
}
.phone { color: #1890FF; font-weight: 600; }

.action-call {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  margin-top: 16rpx; padding: 18rpx 0;
  background: #E6F7FF; border-radius: 12rpx;
  font-size: 26rpx; color: #1890FF; font-weight: 600;
}

.field-label { font-size: 28rpx; color: #262626; font-weight: 600; margin-bottom: 12rpx; }
.field-label.mt { margin-top: 24rpx; }
.textarea {
  background: #F5F7FA; border-radius: 12rpx;
  padding: 22rpx 24rpx; font-size: 28rpx;
  width: 100%; min-height: 200rpx; box-sizing: border-box;
}

.row-line {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0 12rpx;
  border-top: 1rpx dashed #F0F0F0; margin-top: 24rpx;
}
.row-label { display: flex; align-items: center; gap: 10rpx; font-size: 26rpx; color: #262626; }

.btn-group {
  display: flex; gap: 16rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.btn-cell {
  flex: 1 1 0;
  min-width: 0;
}
.btn-cell .van-button { width: 100% !important; }
.reject-link { text-align: center; color: #FF4D4F; font-size: 26rpx; padding: 24rpx 0 0; }

.handler-meta { font-size: 24rpx; color: #8C8C8C; margin-top: 16rpx; }
.status-card-done { background: #F6FFED; }
.status-card-reject { background: #FFF7F6; }

.danger-card { border: 1rpx solid #FFCCC7; background: #FFF7F6; }
.danger-tip { font-size: 24rpx; color: #8C8C8C; margin: 8rpx 0 20rpx; }
.danger-btn {
  text-align: center; padding: 20rpx 0;
  color: #FF4D4F; font-size: 28rpx; font-weight: 500;
  border: 1rpx solid #FF4D4F; border-radius: 12rpx;
  background: #fff;
}
.danger-btn:active { background: #FFF1F0; }

.timeline { padding: 12rpx 0 0; }
.tl-item { position: relative; padding-left: 32rpx; padding-bottom: 28rpx; border-left: 2rpx solid #F0F0F0; margin-left: 8rpx; }
.tl-item:last-child { border-left-color: transparent; padding-bottom: 0; }
.tl-dot { position: absolute; left: -10rpx; top: 6rpx; width: 18rpx; height: 18rpx; border-radius: 50%; background: #BFBFBF; box-shadow: 0 0 0 4rpx #fff; }
.tl-dot-submit { background: #1890FF; }
.tl-dot-process { background: #1890FF; }
.tl-dot-done { background: #52C41A; }
.tl-dot-reject { background: #FF4D4F; }
.tl-dot-delete { background: #FF4D4F; }
.tl-dot-cancel { background: #BFBFBF; }
.tl-action { font-size: 28rpx; color: #262626; font-weight: 600; }
.tl-meta { font-size: 22rpx; color: #8C8C8C; margin-top: 4rpx; }
.tl-remark { font-size: 26rpx; color: #595959; margin-top: 8rpx; line-height: 1.5; }
