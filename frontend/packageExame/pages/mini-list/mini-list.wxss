/* =========================================================
 * mini-list 列表页（与 home 配色统一：Ant Design 蓝）
 * ========================================================= */

page {
  --primary: #1890FF;
  --primary-light: #40A9FF;
  --primary-bg: #E6F7FF;
  --primary-gradient: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  --success: #52C41A;
  --success-bg: #F6FFED;
  --warning: #FAAD14;
  --warning-bg: #FFFBE6;
  --danger: #FF4D4F;
  --danger-bg: #FFF1F0;
  --text-primary: #262626;
  --text-secondary: #595959;
  --text-disabled: #BFBFBF;
  --border-color: #F0F0F0;
  --bg-color: #FAFAFA;
  --card-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.08);
  --card-shadow-hover: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
  --border-radius: 16rpx;
}

.list-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 40rpx;
}

/* ---------- 用户头部 ---------- */
.user-header {
  background: var(--primary-gradient);
  padding: 24rpx 30rpx 30rpx;
  color: #ffffff;
}
.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary);
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}
.user-info { flex: 1; min-width: 0; }
.user-line1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 8rpx var(--success);
  flex-shrink: 0;
}
.user-class {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.user-line2 {}
.user-meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-family: monospace;
}

.refresh-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, background 0.2s ease;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.refresh-btn--hover {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.35);
}
.refresh-btn.is-spinning {
  animation: refresh-spin 0.9s linear infinite;
}
@keyframes refresh-spin {
  to { transform: rotate(360deg); }
}

/* 循环箭头：纯 CSS 画的 SVG 风格 */
.refresh-arrow {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #ffffff;
  border-top-color: transparent;
  border-radius: 50%;
  position: relative;
}
.refresh-arrow::after {
  content: "";
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid #ffffff;
  border-top: 5rpx solid transparent;
  border-bottom: 5rpx solid transparent;
}

/* ---------- 快捷按钮：3 个功能入口 ---------- */
.quick-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
}
.quick-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}
.quick-btn:active { transform: scale(0.97); }
.quick-btn-icon { color: var(--primary, #1890ff); }
.quick-btn-icon--danger { color: #ee0a24; }
.quick-btn-text {
  font-size: 24rpx;
  color: var(--text-primary, #333);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.quick-btn-text--danger { color: #ee0a24; }

.quick-icon { font-size: 28rpx; }
.quick-text { font-size: 26rpx; }

/* ========== 功能入口 hover 状态 ========== */
.cell-hover { background: #f5f7fa; }

/* ---------- Tab ---------- */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  position: relative;
  transition: color 0.2s;
}
.tab-active {
  color: var(--primary);
  font-weight: 700;
}
.tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 3rpx;
}

/* ---------- 列表 ---------- */
.list-body {
  padding: 24rpx 24rpx 0;
}
.loading-tip {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-disabled);
  font-size: 26rpx;
}
.loading-tip.small {
  padding: 30rpx 0;
  font-size: 24rpx;
}

/* ---------- 考试卡片 ---------- */
.exam-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
  transition: all 0.2s;
}
.exam-card:active {
  box-shadow: var(--card-shadow-hover);
  border-color: var(--primary-light);
  transform: translateY(-2rpx);
}

.card-band {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}
.band-blue { background: var(--primary-gradient); }
.band-orange { background: linear-gradient(135deg, #FA8C16 0%, #FFC53D 100%); }

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin: 6rpx 0 16rpx;
}
.card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}
.card-type {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.tag-blue {
  background: var(--primary-bg);
  color: var(--primary);
  border: 1rpx solid #BAE7FF;
}
.tag-orange {
  background: var(--warning-bg);
  color: #D48806;
  border: 1rpx solid #FFE58F;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  display: flex;
  gap: 12rpx;
  background: var(--bg-color);
  border-radius: 14rpx;
  padding: 20rpx 8rpx;
  margin-bottom: 20rpx;
}
.meta-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.meta-label {
  font-size: 20rpx;
  color: var(--text-disabled);
  margin-bottom: 6rpx;
}
.meta-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-family: monospace;
}
.meta-pass { color: var(--success); }

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}
.foot-left {
  font-size: 24rpx;
  color: var(--text-disabled);
}
.foot-num {
  color: var(--text-secondary);
  font-weight: 700;
  font-family: monospace;
  margin: 0 4rpx;
}
.foot-go {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  transition: transform 0.2s;
}
.exam-card:active .foot-go { transform: translateX(4rpx); }
.foot-arrow {
  font-size: 32rpx;
  line-height: 1;
}

/* ---------- 空 ---------- */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-disabled);
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* ---------- 考试须知 Modal ---------- */
.notice-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.notice-panel {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.notice-header {
  padding: 32rpx 30rpx 24rpx;
  text-align: center;
  border-bottom: 1rpx solid var(--border-color);
}
.notice-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(24, 144, 255, 0.1);
}
.notice-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}
.notice-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.notice-body {
  padding: 24rpx 30rpx;
  flex: 1;
  max-height: 800rpx;
}
.notice-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 22rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.line-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.line-text { flex: 1; }
.line-strong { color: var(--primary); font-weight: 600; }
.line-danger { color: var(--danger); font-weight: 600; }
.line-pass { color: var(--success); font-weight: 600; }

.notice-footer {
  padding: 20rpx 30rpx 28rpx;
  border-top: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-color);
}
.notice-checkbox {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid #d9d9d9;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  transition: all 0.2s;
}
.checkbox-checked {
  background: var(--primary);
  border-color: var(--primary);
}
.btn-notice-ok {
  height: 76rpx;
  padding: 0 32rpx;
  background: var(--primary-gradient);
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25);
}